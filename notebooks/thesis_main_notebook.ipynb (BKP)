    "\n",
    "    run_grouped_experiment = True\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Load cached results\n",
    "# ------------------------------------------------------------\n",
    "if use_cached_grouped_results:\n",
    "    grouped_results = pd.read_parquet(\n",
