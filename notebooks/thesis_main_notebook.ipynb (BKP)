   "source": [
    "# ============================================================\n",
    "# 2.7. Feature Importance Analysis\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from IPython.display import display\n",
    "from sklearn.model_selection import GroupKFold, StratifiedKFold\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Validate required notebook variables and functions\n",
    "# ------------------------------------------------------------\n",
    "required_variables = [\n",
    "    \"best_xgb_params_hc\",\n",
    "    \"X_audio\",\n",
    "    \"y_audio\",\n",
    "    \"XGB_OPTUNA_CV_SCHEME\",\n",
    "    \"XGB_OPTUNA_N_SPLITS\",\n",
    "    \"XGB_MODEL_RANDOM_SEED\",\n",
    "    \"IMPORTANCE_DIR\",\n",
    "]\n",
    "\n",
    "missing_variables = [\n",
    "    name\n",
    "    for name in required_variables\n",
    "    if name not in globals()\n",
    "]\n",
    "\n",
    "if missing_variables:\n",
    "    raise RuntimeError(\n",
    "        \"The following required variables are missing: \"\n",
    "        f\"{missing_variables}. Run Section 2.5 first.\"\n",
    "    )\n",
    "\n",
    "if \"make_xgb_classifier\" not in globals():\n",
    "    raise RuntimeError(\n",
    "        \"make_xgb_classifier was not found. \"\n",
    "        \"Run Section 2.5 first.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Prepare and validate data\n",
    "# ------------------------------------------------------------\n",
    "X_audio_np = np.asarray(\n",
    "    X_audio,\n",
    "    dtype=np.float32,\n",
    ")\n",
    "\n",
    "y_audio_np = np.asarray(\n",
    "    y_audio,\n",
    "    dtype=np.int64,\n",
    ")\n",
    "\n",
    "if X_audio_np.ndim != 2:\n",
    "    raise ValueError(\n",
    "        \"X_audio must be two-dimensional; \"\n",
    "        f\"received shape {X_audio_np.shape}.\"\n",
    "    )\n",
    "\n",
    "if y_audio_np.ndim != 1:\n",
    "    raise ValueError(\n",
    "        \"y_audio must be one-dimensional; \"\n",
    "        f\"received shape {y_audio_np.shape}.\"\n",
    "    )\n",
    "\n",
    "if X_audio_np.shape[0] != y_audio_np.shape[0]:\n",
    "    raise ValueError(\n",
    "        \"X_audio and y_audio must contain the same \"\n",
    "        \"number of samples.\"\n",
    "    )\n",
    "\n",
    "if X_audio_np.shape[1] != 140:\n",
    "    raise ValueError(\n",
    "        \"The handcrafted representation is expected to contain \"\n",
    "        f\"140 features; received {X_audio_np.shape[1]}.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Feature-name mapping\n",
    "# ------------------------------------------------------------\n",
    "feature_names_hc = []\n",
    "\n",
    "# Static MFCCs\n",
    "feature_names_hc += [\n",
    "    f\"MFCC {i} — mean\"\n",
    "    for i in range(13)\n",
    "]\n",
    "\n",
    "feature_names_hc += [\n",
    "    f\"MFCC {i} — SD\"\n",
    "    for i in range(13)\n",
    "]\n",
    "\n",
    "# First-order MFCC derivatives\n",
    "feature_names_hc += [\n",
    "    f\"MFCC Δ {i} — mean\"\n",
    "    for i in range(13)\n",
    "]\n",
    "\n",
    "feature_names_hc += [\n",
    "    f\"MFCC Δ {i} — SD\"\n",
    "    for i in range(13)\n",
    "]\n",
    "\n",
    "# Second-order MFCC derivatives\n",
    "feature_names_hc += [\n",
    "    f\"MFCC Δ² {i} — mean\"\n",
    "    for i in range(13)\n",
    "]\n",
    "\n",
    "feature_names_hc += [\n",
    "    f\"MFCC Δ² {i} — SD\"\n",
    "    for i in range(13)\n",
    "]\n",
    "\n",
    "# Spectral descriptors\n",
    "feature_names_hc += [\n",
    "    \"Spectral centroid — mean\",\n",
    "    \"Spectral centroid — SD\",\n",
    "]\n",
    "\n",
    "feature_names_hc += [\n",
    "    \"Spectral bandwidth — mean\",\n",
    "    \"Spectral bandwidth — SD\",\n",
    "]\n",
    "\n",
    "feature_names_hc += [\n",
    "    \"Spectral flatness — mean\",\n",
    "    \"Spectral flatness — SD\",\n",
    "]\n",
    "\n",
    "feature_names_hc += [\n",
    "    f\"Spectral contrast band {i} — mean\"\n",
    "    for i in range(7)\n",
    "]\n",
    "\n",
    "feature_names_hc += [\n",
    "    f\"Spectral contrast band {i} — SD\"\n",
    "    for i in range(7)\n",
    "]\n",
    "\n",
    "feature_names_hc += [\n",
    "    \"Spectral roll-off — mean\",\n",
    "    \"Spectral roll-off — SD\",\n",
    "]\n",
    "\n",
    "# Tonnetz\n",
    "feature_names_hc += [\n",
    "    f\"Tonnetz dimension {i} — mean\"\n",
    "    for i in range(6)\n",
    "]\n",
    "\n",
    "feature_names_hc += [\n",
    "    f\"Tonnetz dimension {i} — SD\"\n",
    "    for i in range(6)\n",
    "]\n",
    "\n",
    "# Zero-crossing rate\n",
    "feature_names_hc += [\n",
    "    \"Zero-crossing rate — mean\",\n",
    "    \"Zero-crossing rate — SD\",\n",
    "]\n",
    "\n",
    "# Tempogram ratio\n",
    "feature_names_hc += [\n",
    "    f\"Tempogram ratio bin {i} — mean\"\n",
    "    for i in range(13)\n",
    "]\n",
    "\n",
    "feature_names_hc += [\n",
    "    f\"Tempogram ratio bin {i} — SD\"\n",
    "    for i in range(13)\n",
    "]\n",
    "\n",
    "if len(feature_names_hc) != 140:\n",
    "    raise RuntimeError(\n",
    "        \"Feature-name mapping does not contain exactly 140 entries.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Feature-family mapping\n",
    "# ------------------------------------------------------------\n",
    "feature_groups_hc = (\n",
    "    [\"MFCC\"] * 26\n",
    "    + [\"MFCC Δ\"] * 26\n",
    "    + [\"MFCC Δ²\"] * 26\n",
    "    + [\"Spectral centroid\"] * 2\n",
    "    + [\"Spectral bandwidth\"] * 2\n",
    "    + [\"Spectral flatness\"] * 2\n",
    "    + [\"Spectral contrast\"] * 14\n",
    "    + [\"Spectral roll-off\"] * 2\n",
    "    + [\"Tonnetz\"] * 12\n",
    "    + [\"Zero-crossing rate\"] * 2\n",
    "    + [\"Tempogram ratio\"] * 26\n",
    ")\n",
    "\n",
    "if len(feature_groups_hc) != 140:\n",
    "    raise RuntimeError(\n",
    "        \"Feature-family mapping does not contain exactly 140 entries.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Cross-validation scheme\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Use the same CV scheme selected for XGBoost optimization.\n",
    "IMPORTANCE_CV_SCHEME = XGB_OPTUNA_CV_SCHEME\n",
    "IMPORTANCE_N_SPLITS = XGB_OPTUNA_N_SPLITS\n",
    "\n",
    "groups_audio_np = None\n",
    "\n",
    "if IMPORTANCE_CV_SCHEME == \"groupkfold\":\n",
    "    if \"groups_audio\" not in globals():\n",
    "        raise RuntimeError(\n",
    "            \"groups_audio was not found, but the feature-importance \"\n",
    "            \"analysis requires GroupKFold.\"\n",
    "        )\n",
    "\n",
    "    groups_audio_np = np.asarray(\n",
    "        groups_audio,\n",
    "        dtype=object,\n",
    "    )\n",
    "\n",
    "    if groups_audio_np.shape[0] != X_audio_np.shape[0]:\n",
    "        raise ValueError(\n",
    "            \"groups_audio and X_audio must contain the same \"\n",
    "            \"number of samples.\"\n",
    "        )\n",
    "\n",
    "    if IMPORTANCE_N_SPLITS > len(\n",
    "        np.unique(groups_audio_np)\n",
    "    ):\n",
    "        raise ValueError(\n",
    "            \"The requested number of GroupKFold splits exceeds \"\n",
    "            \"the number of available subjects.\"\n",
    "        )\n",
    "\n",
    "    cv = GroupKFold(\n",
    "        n_splits=IMPORTANCE_N_SPLITS\n",
    "    )\n",
    "\n",
    "    split_iterator = cv.split(\n",
    "        X_audio_np,\n",
    "        y_audio_np,\n",
    "        groups=groups_audio_np,\n",
    "    )\n",
    "\n",
    "    cv_suffix = \"groupkfold\"\n",
    "\n",
    "elif IMPORTANCE_CV_SCHEME == \"stratifiedkfold\":\n",
    "    cv = StratifiedKFold(\n",
    "        n_splits=IMPORTANCE_N_SPLITS,\n",
    "        shuffle=True,\n",
    "        random_state=XGB_MODEL_RANDOM_SEED,\n",
    "    )\n",
    "\n",
    "    split_iterator = cv.split(\n",
    "        X_audio_np,\n",
    "        y_audio_np,\n",
    "    )\n",
    "\n",
    "    cv_suffix = \"stratifiedkfold\"\n",
    "\n",
    "else:\n",
    "    raise ValueError(\n",
    "        \"Unsupported feature-importance CV scheme: \"\n",
    "        f\"{IMPORTANCE_CV_SCHEME}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Extract XGBoost gain importance\n",
    "# ------------------------------------------------------------\n",
    "def extract_gain_importance(model, n_features):\n",
    "    \"\"\"\n",
    "    Extract normalized gain importance for every input feature.\n",
    "\n",
    "    XGBoost omits unused features from Booster.get_score(), so\n",
    "    absent dimensions are explicitly assigned zero importance.\n",
    "    \"\"\"\n",
    "    raw_importance = model.get_booster().get_score(\n",
    "        importance_type=\"gain\"\n",
    "    )\n",
    "\n",
    "    importance = np.zeros(\n",
    "        n_features,\n",
    "        dtype=np.float64,\n",
    "    )\n",
    "\n",
    "    for feature_key, gain in raw_importance.items():\n",
    "        if feature_key.startswith(\"f\"):\n",
    "            feature_index = int(\n",
    "                feature_key[1:]\n",
    "            )\n",
    "\n",
    "            if 0 <= feature_index < n_features:\n",
    "                importance[\n",
    "                    feature_index\n",
    "                ] = float(gain)\n",
    "\n",
    "    total_gain = importance.sum()\n",
    "\n",
    "    if total_gain > 0:\n",
    "        importance = (\n",
    "            importance\n",
    "            / total_gain\n",
    "        )\n",
    "\n",
    "    return importance\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Fold-wise importance estimation\n",
    "# ------------------------------------------------------------\n",
    "fold_rows = []\n",
    "\n",
    "print(\"====================================================\")\n",
    "print(\" XGBOOST FEATURE IMPORTANCE ANALYSIS\")\n",
    "print(\"====================================================\")\n",
    "print(\n",
    "    f\"CV scheme: {IMPORTANCE_CV_SCHEME}\"\n",
    ")\n",
    "print(\n",
    "    f\"Cross-validation folds: {IMPORTANCE_N_SPLITS}\"\n",
    ")\n",
    "print(\n",
    "    \"Importance type: normalized gain\"\n",
    ")\n",
    "print(\"====================================================\")\n",
    "\n",
    "\n",
    "for fold_index, (\n",
    "    train_indices,\n",
    "    validation_indices,\n",
    ") in enumerate(\n",
    "    split_iterator,\n",
    "    start=1,\n",
    "):\n",
    "    X_train = X_audio_np[\n",
    "        train_indices\n",
    "    ]\n",
    "\n",
    "    y_train = y_audio_np[\n",
    "        train_indices\n",
    "    ]\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Explicit subject-leakage validation\n",
    "    # --------------------------------------------------------\n",
    "    if IMPORTANCE_CV_SCHEME == \"groupkfold\":\n",
    "        train_groups = groups_audio_np[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        validation_groups = groups_audio_np[\n",
    "            validation_indices\n",
    "        ]\n",
    "\n",
    "        shared_subjects = np.intersect1d(\n",
    "            np.unique(train_groups),\n",
    "            np.unique(validation_groups),\n",
    "        )\n",
    "\n",
    "        if shared_subjects.size != 0:\n",
    "            raise RuntimeError(\n",
    "                \"Subject leakage detected in feature-importance \"\n",
    "                f\"fold {fold_index}: \"\n",
    "                f\"{shared_subjects.tolist()}\"\n",
    "            )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Fold-specific class weighting\n",
    "    # --------------------------------------------------------\n",
    "    positive_samples = int(\n",
    "        np.sum(y_train == 1)\n",
    "    )\n",
    "\n",
    "    negative_samples = int(\n",
    "        np.sum(y_train == 0)\n",
    "    )\n",
    "\n",
    "    if positive_samples == 0:\n",
    "        raise ValueError(\n",
    "            f\"Training fold {fold_index} contains no \"\n",
    "            \"positive samples.\"\n",
    "        )\n",
    "\n",
    "    scale_pos_weight = (\n",
    "        negative_samples\n",
    "        / positive_samples\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Fit tuned XGBoost model\n",
    "    # --------------------------------------------------------\n",
    "    model = make_xgb_classifier(\n",
    "        params=best_xgb_params_hc,\n",
    "        scale_pos_weight=scale_pos_weight,\n",
    "        seed=XGB_MODEL_RANDOM_SEED,\n",
    "    )\n",
    "\n",
    "    model.fit(\n",
    "        X_train,\n",
    "        y_train,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Explicit normalized gain importance\n",
    "    # --------------------------------------------------------\n",
    "    fold_importance = extract_gain_importance(\n",
    "        model=model,\n",
    "        n_features=X_audio_np.shape[1],\n",
    "    )\n",
    "\n",
    "    df_fold = pd.DataFrame(\n",
    "        {\n",
    "            \"fold\": fold_index,\n",
    "            \"feature_index\": np.arange(\n",
    "                X_audio_np.shape[1]\n",
    "            ),\n",
    "            \"feature_name\": feature_names_hc,\n",
    "            \"feature_family\": feature_groups_hc,\n",
    "            \"normalized_gain\": fold_importance,\n",
    "        }\n",
    "    )\n",
    "\n",
    "    fold_rows.append(\n",
    "        df_fold\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"Fold {fold_index:2d}/{IMPORTANCE_N_SPLITS:2d} | \"\n",
    "        f\"train samples={len(train_indices):3d} | \"\n",
    "        f\"held-out samples={len(validation_indices):3d}\"\n",
    "    )\n",
    "\n",
    "\n",
    "df_importance_folds = pd.concat(\n",
    "    fold_rows,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Individual-feature summary\n",
    "# ------------------------------------------------------------\n",
    "df_importance = (\n",
    "    df_importance_folds\n",
    "    .groupby(\n",
    "        [\n",
    "            \"feature_index\",\n",
    "            \"feature_name\",\n",
    "            \"feature_family\",\n",
    "        ],\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        importance_mean=(\n",
    "            \"normalized_gain\",\n",
    "            \"mean\",\n",
    "        ),\n",
    "        importance_std=(\n",
    "            \"normalized_gain\",\n",
    "            \"std\",\n",
    "        ),\n",
    "    )\n",
    "    .sort_values(\n",
    "        \"importance_mean\",\n",
    "        ascending=False,\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Family-level importance\n",
    "# ------------------------------------------------------------\n",
    "df_group_importance = (\n",
    "    df_importance\n",
    "    .groupby(\n",
    "        \"feature_family\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        total_mean_gain=(\n",
    "            \"importance_mean\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "        number_of_features=(\n",
    "            \"feature_name\",\n",
    "            \"count\",\n",
    "        ),\n",
    "    )\n",
    ")\n",
    "\n",
    "# Normalize again to avoid numerical accumulation error.\n",
    "family_gain_total = (\n",
    "    df_group_importance[\n",
    "        \"total_mean_gain\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "if family_gain_total > 0:\n",
    "    df_group_importance[\n",
    "        \"relative_importance\"\n",
    "    ] = (\n",
    "        df_group_importance[\n",
    "            \"total_mean_gain\"\n",
    "        ]\n",
    "        / family_gain_total\n",
    "    )\n",
    "else:\n",
    "    df_group_importance[\n",
    "        \"relative_importance\"\n",
    "    ] = 0.0\n",
    "\n",
    "# Also retain average gain per descriptor so that large families\n",
    "# can be distinguished from families containing individually\n",
    "# strong features.\n",
    "df_group_importance[\n",
    "    \"mean_gain_per_feature\"\n",
    "] = (\n",
    "    df_group_importance[\n",
    "        \"total_mean_gain\"\n",
    "    ]\n",
    "    / df_group_importance[\n",
    "        \"number_of_features\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "df_group_importance = (\n",
    "    df_group_importance\n",
    "    .sort_values(\n",
    "        \"relative_importance\",\n",
    "        ascending=False,\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reader-facing tables\n",
    "# ------------------------------------------------------------\n",
    "TOP_N = 20\n",
    "\n",
    "top_features_table = (\n",
    "    df_importance\n",
    "    .head(TOP_N)\n",
    "    [\n",
    "        [\n",
    "            \"feature_name\",\n",
    "            \"feature_family\",\n",
    "            \"importance_mean\",\n",
    "            \"importance_std\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "top_features_table.columns = [\n",
    "    \"Feature\",\n",
    "    \"Feature family\",\n",
    "    \"Mean normalized gain\",\n",
    "    \"SD\",\n",
    "]\n",
    "\n",
    "family_importance_table = (\n",
    "    df_group_importance\n",
    "    [\n",
    "        [\n",
    "            \"feature_family\",\n",
    "            \"number_of_features\",\n",
    "            \"relative_importance\",\n",
    "            \"mean_gain_per_feature\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "family_importance_table.columns = [\n",
    "    \"Feature family\",\n",
    "    \"Dimensions\",\n",
    "    \"Relative importance\",\n",
    "    \"Mean gain per feature\",\n",
    "]\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Format reader-facing numerical values\n",
    "# ------------------------------------------------------------\n",
    "top_features_display = (\n",
    "    top_features_table.style\n",
    "    .format(\n",
    "        {\n",
    "            \"Mean normalized gain\": \"{:.4f}\",\n",
    "            \"SD\": \"{:.4f}\",\n",
    "        }\n",
    "    )\n",
    "    .hide(axis=\"index\")\n",
    "    .set_properties(\n",
    "        **{\n",
    "            \"text-align\": \"center\",\n",
    "            \"white-space\": \"nowrap\",\n",
    "            \"padding\": \"6px 12px\",\n",
    "        }\n",
    "    )\n",
    "    .set_table_styles(\n",
    "        [\n",
    "            {\n",
    "                \"selector\": \"th\",\n",
    "                \"props\": [\n",
    "                    (\"text-align\", \"center\"),\n",
    "                    (\"border-bottom\", \"1px solid\"),\n",
