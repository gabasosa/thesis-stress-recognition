    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Cache metadata and validation helpers\n",
    "# ------------------------------------------------------------\n",
    "def array_fingerprint(X, y):\n",
    "    \"\"\"\n",
    "    Create a fingerprint of the feature matrix and target vector.\n",
    "\n",
    "    This prevents results generated from an older dataset from being\n",
    "    silently loaded after the features or labels have changed.\n",
    "    \"\"\"\n",
    "    hasher = hashlib.sha256()\n",
    "\n",
    "    X_contiguous = np.ascontiguousarray(X)\n",
    "    y_contiguous = np.ascontiguousarray(y)\n",
    "\n",
    "    hasher.update(str(X_contiguous.shape).encode(\"utf-8\"))\n",
    "    hasher.update(str(X_contiguous.dtype).encode(\"utf-8\"))\n",
    "    hasher.update(X_contiguous.tobytes())\n",
    "\n",
    "    hasher.update(str(y_contiguous.shape).encode(\"utf-8\"))\n",
    "    hasher.update(str(y_contiguous.dtype).encode(\"utf-8\"))\n",
    "    hasher.update(y_contiguous.tobytes())\n",
    "\n",
    "    return hasher.hexdigest()\n",
    "\n",
    "\n",
    "def classifier_configuration(classifiers):\n",
    "    \"\"\"Return a JSON-serializable description of the classifiers.\"\"\"\n",
    "    return {\n",
    "        model_name: estimator.get_params(deep=False)\n",
    "        for model_name, estimator in classifiers.items()\n",
    "    }\n",
    "\n",
    "\n",
    "def normalize_for_json(value):\n",
    "    \"\"\"Convert NumPy and tuple values into JSON-compatible objects.\"\"\"\n",
    "    if isinstance(value, dict):\n",
    "        return {\n",
    "            str(key): normalize_for_json(item)\n",
    "            for key, item in value.items()\n",
    "        }\n",
    "\n",
    "    if isinstance(value, (list, tuple)):\n",
    "        return [normalize_for_json(item) for item in value]\n",
    "\n",
    "    if isinstance(value, np.generic):\n",
    "        return value.item()\n",
    "\n",
    "    return value\n",
    "\n",
    "\n",
    "def build_official_protocol_metadata(X, y):\n",
    "    \"\"\"Describe the data and experimental configuration used by the cache.\"\"\"\n",
    "    metadata = {\n",
    "        \"protocol\": \"official_stressid_handcrafted_audio_reproduction\",\n",
    "        \"n_repetitions\": int(STRESSID_N_REPETITIONS),\n",
    "        \"test_size\": float(STRESSID_TEST_SIZE),\n",
    "        \"random_seed\": STRESSID_RANDOM_SEED,\n",
    "        \"n_samples\": int(X.shape[0]),\n",
    "        \"feature_dimension\": int(X.shape[1]),\n",
    "        \"positive_class_ratio\": float(np.mean(y)),\n",
    "        \"data_fingerprint\": array_fingerprint(X, y),\n",
    "        \"classifiers\": classifier_configuration(STRESSID_CLASSIFIERS)\n",
    "    }\n",
    "\n",
    "    return normalize_for_json(metadata)\n",
    "\n",
    "\n",
    "def load_json(json_path):\n",
    "    with open(json_path, \"r\", encoding=\"utf-8\") as file:\n",
    "        return json.load(file)\n",
    "\n",
    "\n",
    "def cache_matches_current_protocol(meta_path, expected_metadata):\n",
    "    \"\"\"\n",
    "    Check whether cached results were generated using the current data\n",
    "    and protocol configuration.\n",
    "    \"\"\"\n",
    "    if not os.path.exists(meta_path):\n",
    "        return False, \"Metadata file is missing.\"\n",
    "\n",
    "    try:\n",
    "        cached_metadata = load_json(meta_path)\n",
    "    except Exception as exc:\n",
    "        return False, f\"Metadata could not be read: {exc}\"\n",
    "\n",
    "    fields_to_compare = [\n",
    "        \"protocol\",\n",
    "        \"n_repetitions\",\n",
    "        \"test_size\",\n",
    "        \"random_seed\",\n",
    "        \"n_samples\",\n",
    "        \"feature_dimension\",\n",
    "        \"data_fingerprint\",\n",
    "        \"classifiers\"\n",
    "    ]\n",
    "\n",
    "    mismatched_fields = [\n",
    "        field\n",
    "        for field in fields_to_compare\n",
    "        if cached_metadata.get(field) != expected_metadata.get(field)\n",
    "    ]\n",
    "\n",
    "    if mismatched_fields:\n",
    "        return (\n",
    "            False,\n",
    "            \"Cached configuration differs in: \"\n",
    "            + \", \".join(mismatched_fields)\n",
    "        )\n",
    "\n",
    "    return True, \"Cache matches the current data and protocol.\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Official protocol implementation\n",
    "# ------------------------------------------------------------\n",
    "def build_stressid_pipeline(classifier):\n",
    "    \"\"\"\n",
    "    Build the preprocessing and classification pipeline used in the\n",
    "    released StressID classification implementation.\n",
    "    \"\"\"\n",
    "    return Pipeline([\n",
    "        (\"imputer\", IterativeImputer()),\n",
    "        (\"scaler\", StandardScaler()),\n",
    "        (\"classifier\", clone(classifier))\n",
    "    ])\n",
    "\n",
    "\n",
    "def run_official_stressid_baseline(\n",
    "    X,\n",
    "    y,\n",
    "    n_repetitions=STRESSID_N_REPETITIONS,\n",
    "    test_size=STRESSID_TEST_SIZE,\n",
    "    classifiers=None,\n",
    "    random_seed=STRESSID_RANDOM_SEED,\n",
    "    verbose=True\n",
    "):\n",
    "    \"\"\"\n",
    "    Run the refactored official StressID handcrafted-audio protocol.\n",
    "\n",
    "    For every repetition:\n",
    "      1. Generate a random 80/20 recording-level split.\n",
    "      2. Apply SMOTE only to the training partition.\n",
    "      3. Fit iterative imputation and standardization on training data.\n",
    "      4. Fit each official classifier.\n",
    "      5. Evaluate on the untouched test partition.\n",
    "    \"\"\"\n",
    "    X = np.asarray(X, dtype=np.float32)\n",
    "    y = np.asarray(y, dtype=np.int64)\n",
    "\n",
    "    if classifiers is None:\n",
    "        classifiers = STRESSID_CLASSIFIERS\n",
    "\n",
    "    rng = (\n",
    "        None\n",
    "        if random_seed is None\n",
    "        else np.random.default_rng(random_seed)\n",
    "    )\n",
    "\n",
    "    result_rows = []\n",
    "    confusion_rows = []\n",
    "    prediction_rows = []\n",
    "\n",
    "    sample_indices = np.arange(X.shape[0])\n",
    "\n",
    "    for repetition in range(n_repetitions):\n",
    "        if rng is None:\n",
    "            split_seed = None\n",
    "            smote_seed = None\n",
    "        else:\n",
    "            split_seed = int(\n",
    "                rng.integers(0, np.iinfo(np.int32).max)\n",
    "            )\n",
    "            smote_seed = int(\n",
    "                rng.integers(0, np.iinfo(np.int32).max)\n",
    "            )\n",
    "\n",
    "        train_indices, test_indices = train_test_split(\n",
    "            sample_indices,\n",
    "            test_size=test_size,\n",
    "            random_state=split_seed\n",
    "        )\n",
    "\n",
    "        X_train = X[train_indices]\n",
    "        X_test = X[test_indices]\n",
    "        y_train = y[train_indices]\n",
    "        y_test = y[test_indices]\n",
    "\n",
    "        # As in the released helper, SMOTE is applied only to training data.\n",
    "        smote = SMOTE(random_state=smote_seed)\n",
    "\n",
    "        X_train_resampled, y_train_resampled = smote.fit_resample(\n",
    "            X_train,\n",
    "            y_train\n",
    "        )\n",
    "\n",
    "        if verbose:\n",
    "            print(\n",
    "                f\"Split {repetition + 1:2d}/{n_repetitions:2d} | \"\n",
    "                f\"train={len(y_train):3d} | \"\n",
    "                f\"after SMOTE={len(y_train_resampled):3d} | \"\n",
    "                f\"test={len(y_test):3d}\"\n",
    "            )\n",
    "\n",
    "        for classifier_name, classifier in classifiers.items():\n",
    "            pipeline = build_stressid_pipeline(classifier)\n",
    "\n",
    "            start_time = time.perf_counter()\n",
    "\n",
    "            pipeline.fit(\n",
    "                X_train_resampled,\n",
    "                y_train_resampled\n",
    "            )\n",
    "\n",
    "            fit_time = time.perf_counter() - start_time\n",
    "            y_pred = pipeline.predict(X_test)\n",
    "\n",
    "            weighted_f1 = f1_score(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                average=\"weighted\"\n",
    "            )\n",
    "\n",
    "            balanced_accuracy = balanced_accuracy_score(\n",
    "                y_test,\n",
    "                y_pred\n",
    "            )\n",
    "\n",
    "            matrix = confusion_matrix(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                labels=[0, 1]\n",
    "            )\n",
    "\n",
    "            tn, fp, fn, tp = matrix.ravel()\n",
    "\n",
    "            result_rows.append({\n",
    "                \"repetition\": int(repetition),\n",
    "                \"classifier\": classifier_name,\n",
    "                \"weighted_f1\": float(weighted_f1),\n",
    "                \"balanced_accuracy\": float(balanced_accuracy),\n",
    "                \"fit_time_seconds\": float(fit_time),\n",
    "                \"train_samples\": int(len(y_train)),\n",
    "                \"train_samples_after_smote\": int(\n",
    "                    len(y_train_resampled)\n",
    "                ),\n",
    "                \"test_samples\": int(len(y_test)),\n",
    "                \"split_seed\": split_seed,\n",
    "                \"smote_seed\": smote_seed\n",
    "            })\n",
    "\n",
    "            confusion_rows.append({\n",
    "                \"repetition\": int(repetition),\n",
    "                \"classifier\": classifier_name,\n",
    "                \"true_negative\": int(tn),\n",
    "                \"false_positive\": int(fp),\n",
    "                \"false_negative\": int(fn),\n",
    "                \"true_positive\": int(tp)\n",
    "            })\n",
    "\n",
    "            for sample_index, true_label, predicted_label in zip(\n",
    "                test_indices,\n",
    "                y_test,\n",
    "                y_pred\n",
    "            ):\n",
    "                prediction_rows.append({\n",
    "                    \"repetition\": int(repetition),\n",
    "                    \"classifier\": classifier_name,\n",
    "                    \"sample_index\": int(sample_index),\n",
    "                    \"y_true\": int(true_label),\n",
    "                    \"y_pred\": int(predicted_label)\n",
    "                })\n",
    "\n",
    "    results_df = pd.DataFrame(result_rows)\n",
    "    confusions_df = pd.DataFrame(confusion_rows)\n",
    "    predictions_df = pd.DataFrame(prediction_rows)\n",
    "\n",
    "    return results_df, confusions_df, predictions_df\n",
    "\n",
    "\n",
    "def summarize_official_stressid_results(results_df):\n",
    "    \"\"\"Calculate means and sample standard deviations across repetitions.\"\"\"\n",
    "    required_columns = {\n",
    "        \"classifier\",\n",
    "        \"weighted_f1\",\n",
    "        \"balanced_accuracy\",\n",
    "        \"fit_time_seconds\"\n",
    "    }\n",
    "\n",
    "    missing_columns = required_columns.difference(results_df.columns)\n",
    "\n",
    "    if missing_columns:\n",
    "        raise ValueError(\n",
    "            f\"Missing result columns: {sorted(missing_columns)}\"\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        results_df\n",
    "        .groupby(\"classifier\", sort=True)\n",
    "        .agg(\n",
    "            weighted_f1_mean=(\"weighted_f1\", \"mean\"),\n",
    "            weighted_f1_std=(\"weighted_f1\", \"std\"),\n",
    "            balanced_accuracy_mean=(\n",
    "                \"balanced_accuracy\",\n",
    "                \"mean\"\n",
    "            ),\n",
    "            balanced_accuracy_std=(\n",
    "                \"balanced_accuracy\",\n",
    "                \"std\"\n",
    "            ),\n",
    "            fit_time_mean_seconds=(\n",
    "                \"fit_time_seconds\",\n",
    "                \"mean\"\n",
    "            ),\n",
    "            fit_time_std_seconds=(\n",
    "                \"fit_time_seconds\",\n",
    "                \"std\"\n",
    "            )\n",
    "        )\n",
    "        .sort_values(\n",
    "            \"weighted_f1_mean\",\n",
    "            ascending=False\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Decide whether to use the cache or rerun the experiment\n",
    "# ------------------------------------------------------------\n",
    "expected_metadata = build_official_protocol_metadata(\n",
    "    X_audio,\n",
    "    y_audio\n",
    ")\n",
    "\n",
    "required_cache_files = [\n",
    "    OFFICIAL_RESULTS_CACHE,\n",
    "    OFFICIAL_PREDICTIONS_CACHE,\n",
    "    OFFICIAL_CONFUSIONS_CACHE,\n",
    "    OFFICIAL_META_FILE\n",
    "]\n",
    "\n",
    "all_cache_files_exist = all(\n",
    "    os.path.exists(path)\n",
    "    for path in required_cache_files\n",
    ")\n",
    "\n",
    "cache_is_valid = False\n",
    "cache_validation_message = \"Required cache files are missing.\"\n",
    "\n",
    "if all_cache_files_exist:\n",
    "    cache_is_valid, cache_validation_message = (\n",
    "        cache_matches_current_protocol(\n",
    "            OFFICIAL_META_FILE,\n",
    "            expected_metadata\n",
    "        )\n",
    "    )\n",
    "\n",
    "use_cached_results = False\n",
    "run_experiment = False\n",
    "\n",
    "if all_cache_files_exist and cache_is_valid:\n",
    "    print(\"====================================================\")\n",
    "    print(\" OFFICIAL STRESSID RESULT CACHE DETECTED\")\n",
    "    print(\"====================================================\")\n",
    "    print(cache_validation_message)\n",
    "\n",
    "    cached_metadata = load_json(OFFICIAL_META_FILE)\n",
    "\n",
    "    if \"execution_timestamp\" in cached_metadata:\n",
    "        print(\n",
    "            \"Execution timestamp:\",\n",
    "            cached_metadata[\"execution_timestamp\"]\n",
    "        )\n",
    "\n",
    "    if IN_COLAB:\n",
    "        print(\n",
    "            \"Colab environment detected. \"\n",
    "            \"Using cached official baseline results automatically.\"\n",
    "        )\n",
    "        use_cached_results = True\n",
    "\n",
    "    else:\n",
    "        user_input = input(\n",
    "            \"Reuse cached official baseline results \"\n",
    "            \"instead of rerunning the experiment? (y/n): \"\n",
    "        ).strip().lower()\n",
    "\n",
    "        if user_input == \"y\":\n",
    "            use_cached_results = True\n",
    "            print(\"Using cached official baseline results.\")\n",
    "        else:\n",
    "            run_experiment = True\n",
    "            print(\n",
    "                \"The official baseline will be rerun and \"\n",
    "                \"the existing cache will be overwritten.\"\n",
    "            )\n",
    "\n",
    "else:\n",
    "    if all_cache_files_exist:\n",
    "        print(\"====================================================\")\n",
    "        print(\" INCOMPATIBLE OFFICIAL BASELINE CACHE\")\n",
    "        print(\"====================================================\")\n",
    "        print(cache_validation_message)\n",
    "\n",
    "    if IN_COLAB:\n",
    "        raise FileNotFoundError(\n",
    "            \"A complete cache matching the current official StressID \"\n",
    "            \"protocol was not found in Colab.\\n\"\n",
    "            \"Run this experiment locally first and make the generated \"\n",
    "            \"cache files available to the Colab environment.\"\n",
    "        )\n",
    "\n",
    "    print(\n",
    "        \"No compatible official baseline cache was found. \"\n",
    "        \"The experiment will be executed.\"\n",
    "    )\n",
    "    run_experiment = True\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Load cached results\n",
    "# ------------------------------------------------------------\n",
    "if use_cached_results:\n",
    "    official_results = pd.read_parquet(\n",
    "        OFFICIAL_RESULTS_CACHE\n",
    "    )\n",
    "\n",
    "    official_predictions = pd.read_parquet(\n",
    "        OFFICIAL_PREDICTIONS_CACHE\n",
    "    )\n",
    "\n",
    "    official_confusions = pd.read_parquet(\n",
    "        OFFICIAL_CONFUSIONS_CACHE\n",
    "    )\n",
    "\n",
    "    official_summary = summarize_official_stressid_results(\n",
    "        official_results\n",
    "    )\n",
    "\n",
    "    official_results_source = \"cache\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Run and cache the experiment\n",
    "# ------------------------------------------------------------\n",
    "elif run_experiment:\n",
    "    (\n",
    "        official_results,\n",
    "        official_confusions,\n",
    "        official_predictions\n",
    "    ) = run_official_stressid_baseline(\n",
    "        X=X_audio,\n",
    "        y=y_audio,\n",
    "        n_repetitions=STRESSID_N_REPETITIONS,\n",
    "        test_size=STRESSID_TEST_SIZE,\n",
    "        classifiers=STRESSID_CLASSIFIERS,\n",
    "        random_seed=STRESSID_RANDOM_SEED,\n",
    "        verbose=True\n",
    "    )\n",
    "\n",
    "    official_summary = summarize_official_stressid_results(\n",
    "        official_results\n",
    "    )\n",
    "\n",
    "    official_results.to_parquet(\n",
    "        OFFICIAL_RESULTS_CACHE,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    official_predictions.to_parquet(\n",
    "        OFFICIAL_PREDICTIONS_CACHE,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    official_confusions.to_parquet(\n",
    "        OFFICIAL_CONFUSIONS_CACHE,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    metadata_to_save = dict(expected_metadata)\n",
    "    metadata_to_save[\"execution_timestamp\"] = (\n",
    "        datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\"result_rows\"] = int(\n",
    "        len(official_results)\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\"prediction_rows\"] = int(\n",
    "        len(official_predictions)\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\"confusion_rows\"] = int(\n",
    "        len(official_confusions)\n",
    "    )\n",
    "\n",
    "    with open(\n",
    "        OFFICIAL_META_FILE,\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\"\n",
    "    ) as file:\n",
    "        json.dump(\n",
    "            metadata_to_save,\n",
    "            file,\n",
    "            indent=2,\n",
    "            ensure_ascii=False\n",
    "        )\n",
    "\n",
    "    official_results_source = \"fresh execution\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reader-facing comparison with the reported StressID results\n",
    "# ------------------------------------------------------------\n",
    "from IPython.display import display\n",
    "\n",
    "\n",
    "# Results displayed by the authors' classification notebook.\n",
    "# The released notebook provides the means in its stored output,\n",
    "# but not the corresponding standard deviations.\n",
    "reported_stressid_results = pd.DataFrame(\n",
    "    {\n",
    "        \"reported_weighted_f1\": {\n",
    "            \"RandomForestClassifier\": 0.655604,\n",
    "            \"KNeighborsClassifier (k=3)\": 0.597635,\n",
    "            \"SVC\": 0.679749,\n",
    "            \"MLPClassifier\": 0.644288,\n",
    "        },\n",
    "        \"reported_balanced_accuracy\": {\n",
    "            \"RandomForestClassifier\": 0.589220,\n",
    "            \"KNeighborsClassifier (k=3)\": 0.624336,\n",
    "            \"SVC\": 0.619802,\n",
    "            \"MLPClassifier\": 0.610884,\n",
    "        },\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Build the complete numerical comparison\n",
    "# ------------------------------------------------------------\n",
    "official_comparison = (\n",
    "    official_summary[\n",
    "        [\n",
    "            \"weighted_f1_mean\",\n",
    "            \"weighted_f1_std\",\n",
    "            \"balanced_accuracy_mean\",\n",
    "            \"balanced_accuracy_std\",\n",
    "        ]\n",
    "    ]\n",
    "    .join(\n",
    "        reported_stressid_results,\n",
    "        how=\"outer\",\n",
    "    )\n",
    ")\n",
    "\n",
    "official_comparison[\"weighted_f1_difference\"] = (\n",
    "    official_comparison[\"weighted_f1_mean\"]\n",
    "    - official_comparison[\"reported_weighted_f1\"]\n",
    ")\n",
    "\n",
    "official_comparison[\"balanced_accuracy_difference\"] = (\n",
    "    official_comparison[\"balanced_accuracy_mean\"]\n",
    "    - official_comparison[\"reported_balanced_accuracy\"]\n",
    ")\n",
    "\n",
    "official_comparison.index.name = \"classifier\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reader-facing model names and order\n",
    "# ------------------------------------------------------------\n",
    "classifier_display_names = {\n",
    "    \"RandomForestClassifier\": \"Audio HC features + RF\",\n",
    "    \"KNeighborsClassifier (k=3)\": \"Audio HC features + kNN (k=3)\",\n",
    "    \"SVC\": \"Audio HC features + SVM\",\n",
    "    \"MLPClassifier\": \"Audio HC features + MLP\",\n",
    "}\n",
    "\n",
    "preferred_classifier_order = [\n",
    "    \"RandomForestClassifier\",\n",
    "    \"KNeighborsClassifier (k=3)\",\n",
    "    \"SVC\",\n",
    "    \"MLPClassifier\",\n",
    "]\n",
    "\n",
    "available_classifier_order = [\n",
    "    classifier\n",
    "    for classifier in preferred_classifier_order\n",
    "    if classifier in official_comparison.index\n",
    "]\n",
    "\n",
    "remaining_classifiers = [\n",
    "    classifier\n",
    "    for classifier in official_comparison.index\n",
    "    if classifier not in available_classifier_order\n",
    "]\n",
    "\n",
    "classifier_order = (\n",
    "    available_classifier_order\n",
    "    + remaining_classifiers\n",
    ")\n",
    "\n",
    "comparison_for_display = official_comparison.loc[\n",
    "    classifier_order\n",
    "].copy()\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Formatting helpers\n",
    "# ------------------------------------------------------------\n",
    "def format_mean_std(mean_value, std_value):\n",
    "    \"\"\"Format a reproduced metric as mean ± sample standard deviation.\"\"\"\n",
    "    if pd.isna(mean_value) or pd.isna(std_value):\n",
    "        return \"N/A\"\n",
    "\n",
    "    return f\"{mean_value:.3f} ± {std_value:.3f}\"\n",
    "\n",
    "\n",
    "def format_reported_value(value):\n",
    "    \"\"\"\n",
    "    Format a result reported by the authors.\n",
    "\n",
    "    No standard deviation is added because it is not available in the\n",
    "    stored output of the released classification notebook.\n",
    "    \"\"\"\n",
    "    if pd.isna(value):\n",
    "        return \"N/A\"\n",
    "\n",
    "    return f\"{value:.3f}\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Construct the authors-style table\n",
    "# ------------------------------------------------------------\n",
    "display_columns = pd.MultiIndex.from_tuples(\n",
    "    [\n",
    "        (\"Reported\", \"Weighted F1\"),\n",
    "        (\"Reported\", \"Balanced accuracy\"),\n",
    "        (\"Procedural reproduction\", \"Weighted F1\"),\n",
    "        (\"Procedural reproduction\", \"Balanced accuracy\"),\n",
    "    ]\n",
    ")\n",
    "\n",
    "display_index = [\n",
    "    classifier_display_names.get(\n",
    "        classifier,\n",
    "        classifier,\n",
    "    )\n",
    "    for classifier in comparison_for_display.index\n",
    "]\n",
    "\n",
    "official_comparison_table = pd.DataFrame(\n",
    "    index=display_index,\n",
    "    columns=display_columns,\n",
    "    dtype=object,\n",
    ")\n",
    "\n",
    "official_comparison_table.index.name = \"Baseline\"\n",
    "\n",
    "for classifier, row in comparison_for_display.iterrows():\n",
    "    display_name = classifier_display_names.get(\n",
    "        classifier,\n",
    "        classifier,\n",
    "    )\n",
    "\n",
    "    official_comparison_table.loc[\n",
    "        display_name,\n",
    "        (\"Reported\", \"Weighted F1\"),\n",
    "    ] = format_reported_value(\n",
    "        row[\"reported_weighted_f1\"]\n",
    "    )\n",
    "\n",
    "    official_comparison_table.loc[\n",
    "        display_name,\n",
    "        (\"Reported\", \"Balanced accuracy\"),\n",
    "    ] = format_reported_value(\n",
    "        row[\"reported_balanced_accuracy\"]\n",
    "    )\n",
    "\n",
    "    official_comparison_table.loc[\n",
    "        display_name,\n",
    "        (\"Procedural reproduction\", \"Weighted F1\"),\n",
    "    ] = format_mean_std(\n",
    "        row[\"weighted_f1_mean\"],\n",
    "        row[\"weighted_f1_std\"],\n",
    "    )\n",
    "\n",
    "    official_comparison_table.loc[\n",
    "        display_name,\n",
    "        (\"Procedural reproduction\", \"Balanced accuracy\"),\n",
    "    ] = format_mean_std(\n",
    "        row[\"balanced_accuracy_mean\"],\n",
    "        row[\"balanced_accuracy_std\"],\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Identify the best result in each displayed column\n",
    "# ------------------------------------------------------------\n",
    "best_internal_rows = {\n",
    "    (\"Reported\", \"Weighted F1\"): (\n",
    "        comparison_for_display[\n",
    "            \"reported_weighted_f1\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "    (\"Reported\", \"Balanced accuracy\"): (\n",
    "        comparison_for_display[\n",
    "            \"reported_balanced_accuracy\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "    (\"Procedural reproduction\", \"Weighted F1\"): (\n",
    "        comparison_for_display[\n",
    "            \"weighted_f1_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "    (\"Procedural reproduction\", \"Balanced accuracy\"): (\n",
    "        comparison_for_display[\n",
    "            \"balanced_accuracy_mean\"\n",
    "        ].idxmax()\n",
