    "\n",
    "    print(\"\\n====================================================\")\n",
    "    print(\" WAV2VEC - SUBJECT-INDEPENDENT EVALUATION\")\n",
    "    print(\"====================================================\")\n",
    "\n",
    "    (\n",
    "        w2v_grouped_results,\n",
    "        w2v_grouped_confusions,\n",
    "        w2v_grouped_predictions,\n",
    "    ) = run_w2v_subject_independent_baseline(\n",
    "        X=X_w2v,\n",
    "        y=y_w2v,\n",
    "        groups=groups_w2v,\n",
    "        classifiers=STRESSID_CLASSIFIERS,\n",
    "        n_splits=GROUPED_N_SPLITS,\n",
    "        random_seed=GROUPED_RANDOM_SEED,\n",
    "        verbose=True,\n",
    "    )\n",
    "\n",
    "    w2v_baseline_results = pd.concat(\n",
    "        [\n",
    "            w2v_recording_results,\n",
    "            w2v_grouped_results,\n",
    "        ],\n",
    "        ignore_index=True,\n",
    "    )\n",
    "\n",
    "    w2v_baseline_confusions = pd.concat(\n",
    "        [\n",
    "            w2v_recording_confusions,\n",
    "            w2v_grouped_confusions,\n",
    "        ],\n",
    "        ignore_index=True,\n",
    "    )\n",
    "\n",
    "    w2v_baseline_predictions = pd.concat(\n",
    "        [\n",
    "            w2v_recording_predictions,\n",
    "            w2v_grouped_predictions,\n",
    "        ],\n",
    "        ignore_index=True,\n",
    "    )\n",
    "\n",
    "    w2v_baseline_results.to_parquet(\n",
    "        W2V_BASELINE_RESULTS_CACHE,\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    w2v_baseline_predictions.to_parquet(\n",
    "        W2V_BASELINE_PREDICTIONS_CACHE,\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    w2v_baseline_confusions.to_parquet(\n",
    "        W2V_BASELINE_CONFUSIONS_CACHE,\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    metadata_to_save = dict(\n",
    "        expected_w2v_baseline_metadata\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\n",
    "        \"execution_timestamp\"\n",
    "    ] = datetime.now().strftime(\n",
    "        \"%Y-%m-%d %H:%M:%S\"\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\n",
    "        \"result_rows\"\n",
    "    ] = int(\n",
    "        len(\n",
    "            w2v_baseline_results\n",
    "        )\n",
    "    )\n",
    "\n",
    "    with open(\n",
    "        W2V_BASELINE_META_FILE,\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\",\n",
    "    ) as file:\n",
    "        json.dump(\n",
    "            normalize_w2v_baseline_json(\n",
    "                metadata_to_save\n",
    "            ),\n",
    "            file,\n",
    "            indent=2,\n",
    "            ensure_ascii=False,\n",
    "        )\n",
    "\n",
    "    w2v_baseline_source = (\n",
    "        \"fresh execution\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Build summaries\n",
    "# ------------------------------------------------------------\n",
    "w2v_recording_summary = (\n",
    "    summarize_w2v_baseline(\n",
    "        w2v_baseline_results,\n",
    "        protocol=\"recording-level\",\n",
    "    )\n",
    ")\n",
    "\n",
    "w2v_grouped_summary = (\n",
    "    summarize_w2v_baseline(\n",
    "        w2v_baseline_results,\n",
    "        protocol=\"subject-independent\",\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Build numerical comparison\n",
    "# ------------------------------------------------------------\n",
    "w2v_baseline_comparison = (\n",
    "    w2v_recording_summary[\n",
    "        [\n",
    "            \"weighted_f1_mean\",\n",
    "            \"weighted_f1_std\",\n",
    "            \"balanced_accuracy_mean\",\n",
    "            \"balanced_accuracy_std\",\n",
    "        ]\n",
    "    ]\n",
    "    .rename(\n",
    "        columns={\n",
    "            \"weighted_f1_mean\": (\n",
    "                \"recording_weighted_f1_mean\"\n",
    "            ),\n",
    "            \"weighted_f1_std\": (\n",
    "                \"recording_weighted_f1_std\"\n",
    "            ),\n",
    "            \"balanced_accuracy_mean\": (\n",
    "                \"recording_balanced_accuracy_mean\"\n",
    "            ),\n",
    "            \"balanced_accuracy_std\": (\n",
    "                \"recording_balanced_accuracy_std\"\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "    .join(\n",
    "        w2v_grouped_summary[\n",
    "            [\n",
    "                \"weighted_f1_mean\",\n",
    "                \"weighted_f1_std\",\n",
    "                \"balanced_accuracy_mean\",\n",
    "                \"balanced_accuracy_std\",\n",
    "            ]\n",
    "        ].rename(\n",
    "            columns={\n",
    "                \"weighted_f1_mean\": (\n",
    "                    \"grouped_weighted_f1_mean\"\n",
    "                ),\n",
    "                \"weighted_f1_std\": (\n",
    "                    \"grouped_weighted_f1_std\"\n",
    "                ),\n",
    "                \"balanced_accuracy_mean\": (\n",
    "                    \"grouped_balanced_accuracy_mean\"\n",
    "                ),\n",
    "                \"balanced_accuracy_std\": (\n",
    "                    \"grouped_balanced_accuracy_std\"\n",
    "                ),\n",
    "            }\n",
    "        ),\n",
    "        how=\"outer\",\n",
    "    )\n",
    ")\n",
    "\n",
    "w2v_baseline_comparison.index.name = (\n",
    "    \"classifier\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reader-facing names\n",
    "# ------------------------------------------------------------\n",
    "classifier_display_names = {\n",
    "    \"RandomForestClassifier\": (\n",
    "        \"Wav2Vec mean/std + RF\"\n",
    "    ),\n",
    "    \"KNeighborsClassifier (k=3)\": (\n",
    "        \"Wav2Vec mean/std + kNN (k=3)\"\n",
    "    ),\n",
    "    \"SVC\": (\n",
    "        \"Wav2Vec mean/std + SVM\"\n",
    "    ),\n",
    "    \"MLPClassifier\": (\n",
    "        \"Wav2Vec mean/std + MLP\"\n",
    "    ),\n",
    "}\n",
    "\n",
    "preferred_classifier_order = [\n",
    "    \"RandomForestClassifier\",\n",
    "    \"KNeighborsClassifier (k=3)\",\n",
    "    \"SVC\",\n",
    "    \"MLPClassifier\",\n",
    "]\n",
    "\n",
    "classifier_order = [\n",
    "    classifier\n",
