    "\n",
    "    return styles\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Style the table\n",
    "# ------------------------------------------------------------\n",
    "styled_grouped_results = (\n",
    "    grouped_results_table.style\n",
    "    .apply(\n",
    "        highlight_best_results,\n",
    "        axis=None,\n",
    "    )\n",
    "    .set_properties(\n",
    "        **{\n",
    "            \"text-align\": \"center\",\n",
