    "        row[\"balanced_accuracy_mean\"],\n",
    "        row[\"balanced_accuracy_std\"],\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Identify the best result in each metric column\n",
    "# ------------------------------------------------------------\n",
    "best_internal_rows = {\n",
    "    (\"Subject-independent\", \"Weighted F1\"): (\n",
    "        grouped_summary_for_display[\n",
    "            \"weighted_f1_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "    (\"Subject-independent\", \"Balanced accuracy\"): (\n",
    "        grouped_summary_for_display[\n",
    "            \"balanced_accuracy_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "}\n",
    "\n",
    "best_display_rows = {\n",
    "    column: classifier_display_names.get(\n",
    "        classifier,\n",
    "        classifier,\n",
    "    )\n",
    "    for column, classifier in best_internal_rows.items()\n",
    "}\n",
    "\n",
    "\n",
    "def highlight_best_results(data):\n",
    "    \"\"\"Bold the best result in each metric column.\"\"\"\n",
