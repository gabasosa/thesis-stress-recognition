    "            \"subject\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=object\n",
    "        )\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        dataframe,\n",
    "        X,\n",
    "        y,\n",
    "        groups,\n",
    "    )\n",
    "\n",
