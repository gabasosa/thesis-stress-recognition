    "# ============================================================\n",
    "# 4.1. Recording-Level Results\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from IPython.display import display\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Validate required results\n",
    "# ------------------------------------------------------------\n",
    "required_variables = [\n",
    "    \"reported_stressid_results\",\n",
    "    \"official_summary\",\n",
    "    \"w2v_recording_summary\",\n",
    "    \"xgb_eval_summary\",\n",
    "    \"EVAL_DIR\",\n",
    "]\n",
    "\n",
    "missing_variables = [\n",
    "    name\n",
    "    for name in required_variables\n",
    "    if name not in globals()\n",
    "]\n",
    "\n",
    "if missing_variables:\n",
    "    raise RuntimeError(\n",
    "        \"The following result objects are missing: \"\n",
    "        f\"{missing_variables}. Run Sections 2.3.1, 2.6, \"\n",
    "        \"and 3.3 first.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reader-facing model names\n",
    "# ------------------------------------------------------------\n",
    "classifier_display_names = {\n",
    "    \"RandomForestClassifier\": \"RF\",\n",
    "    \"KNeighborsClassifier (k=3)\": \"kNN (k=3)\",\n",
    "    \"SVC\": \"SVM\",\n",
    "    \"MLPClassifier\": \"MLP\",\n",
    "}\n",
    "\n",
    "classifier_order = [\n",
    "    \"RandomForestClassifier\",\n",
    "    \"KNeighborsClassifier (k=3)\",\n",
    "    \"SVC\",\n",
    "    \"MLPClassifier\",\n",
    "]\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Numerical result table\n",
    "# ------------------------------------------------------------\n",
    "result_rows = []\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# StressID authors' reported handcrafted results\n",
    "# ------------------------------------------------------------\n",
    "for classifier in classifier_order:\n",
    "    if classifier not in reported_stressid_results.index:\n",
    "        continue\n",
    "\n",
    "    result_rows.append(\n",
    "        {\n",
    "            \"result_source\": \"StressID reported\",\n",
    "            \"feature_representation\": \"Handcrafted\",\n",
    "            \"model\": classifier_display_names[\n",
    "                classifier\n",
    "            ],\n",
    "            \"weighted_f1_mean\": float(\n",
    "                reported_stressid_results.loc[\n",
    "                    classifier,\n",
    "                    \"reported_weighted_f1\",\n",
    "                ]\n",
    "            ),\n",
    "            \"weighted_f1_std\": np.nan,\n",
    "            \"balanced_accuracy_mean\": float(\n",
    "                reported_stressid_results.loc[\n",
    "                    classifier,\n",
    "                    \"reported_balanced_accuracy\",\n",
    "                ]\n",
    "            ),\n",
    "            \"balanced_accuracy_std\": np.nan,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Local handcrafted reproduction\n",
    "# ------------------------------------------------------------\n",
    "for classifier in classifier_order:\n",
    "    if classifier not in official_summary.index:\n",
    "        continue\n",
    "\n",
    "    row = official_summary.loc[\n",
    "        classifier\n",
    "    ]\n",
    "\n",
    "    result_rows.append(\n",
    "        {\n",
    "            \"result_source\": \"Local reproduction\",\n",
    "            \"feature_representation\": \"Handcrafted\",\n",
    "            \"model\": classifier_display_names[\n",
    "                classifier\n",
    "            ],\n",
    "            \"weighted_f1_mean\": float(\n",
    "                row[\"weighted_f1_mean\"]\n",
    "            ),\n",
    "            \"weighted_f1_std\": float(\n",
    "                row[\"weighted_f1_std\"]\n",
    "            ),\n",
    "            \"balanced_accuracy_mean\": float(\n",
    "                row[\"balanced_accuracy_mean\"]\n",
    "            ),\n",
    "            \"balanced_accuracy_std\": float(\n",
    "                row[\"balanced_accuracy_std\"]\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Tuned XGBoost on handcrafted features\n",
    "# ------------------------------------------------------------\n",
    "if (\n",
    "    \"recording-level\"\n",
    "    not in xgb_eval_summary.index\n",
    "):\n",
    "    raise RuntimeError(\n",
    "        \"The recording-level tuned-XGBoost result \"\n",
    "        \"was not found in xgb_eval_summary.\"\n",
    "    )\n",
    "\n",
    "xgb_recording_row = xgb_eval_summary.loc[\n",
    "    \"recording-level\"\n",
    "]\n",
    "\n",
    "result_rows.append(\n",
    "    {\n",
    "        \"result_source\": \"Local\",\n",
    "        \"feature_representation\": \"Handcrafted\",\n",
    "        \"model\": \"XGBoost (Optuna-tuned)\",\n",
    "        \"weighted_f1_mean\": float(\n",
    "            xgb_recording_row[\n",
    "                \"weighted_f1_mean\"\n",
    "            ]\n",
    "        ),\n",
    "        \"weighted_f1_std\": float(\n",
    "            xgb_recording_row[\n",
    "                \"weighted_f1_std\"\n",
    "            ]\n",
    "        ),\n",
    "        \"balanced_accuracy_mean\": float(\n",
    "            xgb_recording_row[\n",
    "                \"balanced_accuracy_mean\"\n",
    "            ]\n",
    "        ),\n",
    "        \"balanced_accuracy_std\": float(\n",
    "            xgb_recording_row[\n",
    "                \"balanced_accuracy_std\"\n",
    "            ]\n",
    "        ),\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Local wav2vec baselines\n",
    "# ------------------------------------------------------------\n",
    "for classifier in classifier_order:\n",
    "    if classifier not in w2v_recording_summary.index:\n",
    "        continue\n",
    "\n",
    "    row = w2v_recording_summary.loc[\n",
    "        classifier\n",
    "    ]\n",
    "\n",
    "    result_rows.append(\n",
    "        {\n",
    "            \"result_source\": \"Local\",\n",
    "            \"feature_representation\": \"Wav2Vec mean/std\",\n",
    "            \"model\": classifier_display_names[\n",
    "                classifier\n",
    "            ],\n",
    "            \"weighted_f1_mean\": float(\n",
    "                row[\"weighted_f1_mean\"]\n",
    "            ),\n",
    "            \"weighted_f1_std\": float(\n",
    "                row[\"weighted_f1_std\"]\n",
    "            ),\n",
    "            \"balanced_accuracy_mean\": float(\n",
    "                row[\"balanced_accuracy_mean\"]\n",
    "            ),\n",
    "            \"balanced_accuracy_std\": float(\n",
    "                row[\"balanced_accuracy_std\"]\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "df_results_recording = pd.DataFrame(\n",
    "    result_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Formatting helpers\n",
    "# ------------------------------------------------------------\n",
    "def format_mean_std(\n",
    "    mean_value,\n",
    "    std_value,\n",
    "):\n",
    "    \"\"\"\n",
    "    Format local results as mean ± SD and reported results\n",
    "    as a mean when no standard deviation is available.\n",
    "    \"\"\"\n",
    "    if pd.isna(mean_value):\n",
    "        return \"N/A\"\n",
    "\n",
    "    if pd.isna(std_value):\n",
    "        return f\"{mean_value:.3f}\"\n",
    "\n",
    "    return (\n",
    "        f\"{mean_value:.3f} \"\n",
    "        f\"± {std_value:.3f}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Construct reader-facing table\n",
    "# ------------------------------------------------------------\n",
    "recording_results_table = pd.DataFrame(\n",
    "    {\n",
    "        \"Result source\": (\n",
    "            df_results_recording[\n",
    "                \"result_source\"\n",
    "            ]\n",
    "        ),\n",
    "        \"Feature representation\": (\n",
    "            df_results_recording[\n",
    "                \"feature_representation\"\n",
    "            ]\n",
    "        ),\n",
    "        \"Model\": (\n",
    "            df_results_recording[\n",
    "                \"model\"\n",
    "            ]\n",
    "        ),\n",
    "        \"Weighted F1\": [\n",
    "            format_mean_std(\n",
    "                mean_value,\n",
    "                std_value,\n",
    "            )\n",
    "            for mean_value, std_value\n",
    "            in zip(\n",
    "                df_results_recording[\n",
    "                    \"weighted_f1_mean\"\n",
    "                ],\n",
    "                df_results_recording[\n",
    "                    \"weighted_f1_std\"\n",
    "                ],\n",
    "            )\n",
    "        ],\n",
    "        \"Balanced accuracy\": [\n",
    "            format_mean_std(\n",
    "                mean_value,\n",
    "                std_value,\n",
    "            )\n",
    "            for mean_value, std_value\n",
    "            in zip(\n",
    "                df_results_recording[\n",
    "                    \"balanced_accuracy_mean\"\n",
    "                ],\n",
    "                df_results_recording[\n",
    "                    \"balanced_accuracy_std\"\n",
    "                ],\n",
    "            )\n",
    "        ],\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Highlight best LOCAL result for each metric\n",
    "# ------------------------------------------------------------\n",
    "local_mask = (\n",
    "    df_results_recording[\n",
    "        \"result_source\"\n",
    "    ]\n",
    "    != \"StressID reported\"\n",
    ")\n",
    "\n",
    "best_local_f1_index = (\n",
    "    df_results_recording.loc[\n",
    "        local_mask,\n",
    "        \"weighted_f1_mean\",\n",
    "    ]\n",
    "    .idxmax()\n",
    ")\n",
    "\n",
    "best_local_bacc_index = (\n",
    "    df_results_recording.loc[\n",
    "        local_mask,\n",
    "        \"balanced_accuracy_mean\",\n",
    "    ]\n",
    "    .idxmax()\n",
    ")\n",
    "\n",
    "\n",
    "def highlight_best_local_results(\n",
    "    data,\n",
    "):\n",
    "    \"\"\"\n",
    "    Bold the best locally obtained weighted F1 and balanced accuracy.\n",
    "    \"\"\"\n",
    "    styles = pd.DataFrame(\n",
    "        \"\",\n",
    "        index=data.index,\n",
    "        columns=data.columns,\n",
    "    )\n",
    "\n",
    "    styles.loc[\n",
    "        best_local_f1_index,\n",
    "        \"Weighted F1\",\n",
    "    ] = \"font-weight: bold;\"\n",
    "\n",
    "    styles.loc[\n",
    "        best_local_bacc_index,\n",
    "        \"Balanced accuracy\",\n",
    "    ] = \"font-weight: bold;\"\n",
    "\n",
    "    return styles\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Style table\n",
    "# ------------------------------------------------------------\n",
    "styled_recording_results = (\n",
    "    recording_results_table.style\n",
    "    .apply(\n",
    "        highlight_best_local_results,\n",
    "        axis=None,\n",
    "    )\n",
    "    .set_properties(\n",
    "        **{\n",
    "            \"text-align\": \"center\",\n",
    "            \"white-space\": \"nowrap\",\n",
    "            \"padding\": \"6px 12px\",\n",
    "        }\n",
    "    )\n",
    "    .set_table_styles(\n",
    "        [\n",
    "            {\n",
    "                \"selector\": \"table\",\n",
    "                \"props\": [\n",
    "                    (\n",
    "                        \"border-collapse\",\n",
    "                        \"collapse\",\n",
    "                    ),\n",
    "                    (\n",
    "                        \"width\",\n",
    "                        \"auto\",\n",
    "                    ),\n",
    "                    (\n",
    "                        \"margin\",\n",
    "                        \"0\",\n",
    "                    ),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"th\",\n",
    "                \"props\": [\n",
    "                    (\n",
    "                        \"text-align\",\n",
    "                        \"center\",\n",
    "                    ),\n",
    "                    (\n",
    "                        \"vertical-align\",\n",
    "                        \"middle\",\n",
