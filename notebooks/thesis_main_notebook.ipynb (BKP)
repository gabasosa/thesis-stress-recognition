    "        \"the same number of samples.\"\n",
    "    )\n",
    "\n",
    "if len(np.unique(y_audio_np)) != 2:\n",
    "    raise ValueError(\n",
    "        \"The tuned XGBoost evaluation expects exactly two classes.\"\n",
    "    )\n",
    "\n",
    "n_subjects = len(\n",
    "    np.unique(groups_audio_np)\n",
    ")\n",
    "\n",
    "if XGB_GROUPED_N_SPLITS > n_subjects:\n",
    "    raise ValueError(\n",
    "        f\"XGB_GROUPED_N_SPLITS={XGB_GROUPED_N_SPLITS} \"\n",
    "        f\"exceeds the number of subjects ({n_subjects}).\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Cache paths\n",
    "# ------------------------------------------------------------\n",
    "os.makedirs(\n",
    "    EVAL_DIR,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "XGB_EVAL_RESULTS_CACHE = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_xgb_handcrafted_tuned_results.parquet\",\n",
    ")\n",
    "\n",
    "XGB_EVAL_PREDICTIONS_CACHE = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_xgb_handcrafted_tuned_predictions.parquet\",\n",
    ")\n",
    "\n",
    "XGB_EVAL_CONFUSIONS_CACHE = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_xgb_handcrafted_tuned_confusions.parquet\",\n",
    ")\n",
    "\n",
    "XGB_EVAL_SUMMARY_PATH = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_xgb_handcrafted_tuned_evaluation_summary.csv\",\n",
    ")\n",
    "\n",
    "XGB_EVAL_META_FILE = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_xgb_handcrafted_tuned_meta.json\",\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# JSON helper\n",
    "# ------------------------------------------------------------\n",
    "def normalize_xgb_eval_json(value):\n",
    "    \"\"\"Convert values into JSON-compatible Python objects.\"\"\"\n",
    "    if isinstance(value, dict):\n",
    "        return {\n",
    "            str(key): normalize_xgb_eval_json(item)\n",
    "            for key, item in value.items()\n",
    "        }\n",
    "\n",
    "    if isinstance(value, (list, tuple)):\n",
    "        return [\n",
    "            normalize_xgb_eval_json(item)\n",
    "            for item in value\n",
    "        ]\n",
    "\n",
    "    if isinstance(value, np.generic):\n",
    "        return value.item()\n",
    "\n",
    "    return value\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Evaluation fingerprint\n",
    "# ------------------------------------------------------------\n",
    "def xgb_eval_fingerprint(\n",
    "    X,\n",
    "    y,\n",
    "    groups,\n",
    "):\n",
    "    \"\"\"\n",
    "    Fingerprint features, labels, and subject identities.\n",
    "    \"\"\"\n",
    "    hasher = hashlib.sha256()\n",
    "\n",
    "    X_contiguous = np.ascontiguousarray(X)\n",
    "    y_contiguous = np.ascontiguousarray(y)\n",
    "\n",
    "    hasher.update(\n",
    "        str(X_contiguous.shape).encode(\"utf-8\")\n",
    "    )\n",
    "    hasher.update(\n",
    "        str(X_contiguous.dtype).encode(\"utf-8\")\n",
    "    )\n",
    "    hasher.update(\n",
    "        X_contiguous.tobytes()\n",
    "    )\n",
    "\n",
    "    hasher.update(\n",
    "        str(y_contiguous.shape).encode(\"utf-8\")\n",
    "    )\n",
    "    hasher.update(\n",
    "        str(y_contiguous.dtype).encode(\"utf-8\")\n",
    "    )\n",
    "    hasher.update(\n",
    "        y_contiguous.tobytes()\n",
    "    )\n",
    "\n",
    "    for group in np.asarray(\n",
    "        groups,\n",
    "        dtype=str,\n",
    "    ):\n",
    "        hasher.update(\n",
    "            group.encode(\"utf-8\")\n",
    "        )\n",
    "        hasher.update(b\"\\0\")\n",
    "\n",
    "    return hasher.hexdigest()\n",
    "\n",
    "\n",
    "def build_xgb_evaluation_metadata():\n",
    "    \"\"\"\n",
    "    Describe the data, selected model, and evaluation protocols.\n",
    "    \"\"\"\n",
    "    metadata = {\n",
    "        \"protocol\": (\n",
    "            \"stressid_tuned_xgb_handcrafted_evaluation\"\n",
    "        ),\n",
    "        \"n_samples\": int(\n",
    "            X_audio_np.shape[0]\n",
    "        ),\n",
    "        \"feature_dimension\": int(\n",
    "            X_audio_np.shape[1]\n",
    "        ),\n",
    "        \"n_subjects\": int(\n",
    "            len(np.unique(groups_audio_np))\n",
    "        ),\n",
    "        \"data_fingerprint\": (\n",
    "            xgb_eval_fingerprint(\n",
    "                X_audio_np,\n",
    "                y_audio_np,\n",
    "                groups_audio_np,\n",
    "            )\n",
    "        ),\n",
    "        \"best_xgb_params\": (\n",
    "            best_xgb_params_hc\n",
    "        ),\n",
    "        \"recording_level\": {\n",
    "            \"protocol\": \"random_80_20_splits\",\n",
    "            \"n_repetitions\": (\n",
    "                XGB_RECORDING_N_REPETITIONS\n",
    "            ),\n",
    "            \"test_size\": (\n",
    "                XGB_RECORDING_TEST_SIZE\n",
    "            ),\n",
    "        },\n",
    "        \"subject_independent\": {\n",
    "            \"protocol\": \"groupkfold\",\n",
    "            \"n_splits\": (\n",
    "                XGB_GROUPED_N_SPLITS\n",
    "            ),\n",
    "        },\n",
    "        \"random_seed\": (\n",
    "            XGB_EVAL_RANDOM_SEED\n",
    "        ),\n",
    "        \"metrics\": [\n",
    "            \"weighted_f1\",\n",
    "            \"balanced_accuracy\",\n",
    "        ],\n",
    "    }\n",
    "\n",
    "    return normalize_xgb_eval_json(\n",
    "        metadata\n",
    "    )\n",
    "\n",
    "\n",
    "def xgb_eval_cache_matches(\n",
    "    metadata_path,\n",
    "    expected_metadata,\n",
    "):\n",
    "    \"\"\"Validate the tuned-XGBoost evaluation cache.\"\"\"\n",
    "    if not os.path.exists(metadata_path):\n",
    "        return False, \"Metadata file is missing.\"\n",
    "\n",
    "    try:\n",
    "        with open(\n",
    "            metadata_path,\n",
    "            \"r\",\n",
    "            encoding=\"utf-8\",\n",
    "        ) as file:\n",
    "            cached_metadata = json.load(file)\n",
    "\n",
    "    except Exception as exc:\n",
    "        return (\n",
    "            False,\n",
    "            f\"Metadata could not be read: {exc}\",\n",
    "        )\n",
    "\n",
    "    fields_to_compare = [\n",
    "        \"protocol\",\n",
    "        \"n_samples\",\n",
    "        \"feature_dimension\",\n",
    "        \"n_subjects\",\n",
    "        \"data_fingerprint\",\n",
    "        \"best_xgb_params\",\n",
    "        \"recording_level\",\n",
    "        \"subject_independent\",\n",
    "        \"random_seed\",\n",
    "        \"metrics\",\n",
    "    ]\n",
    "\n",
    "    mismatched_fields = [\n",
    "        field\n",
    "        for field in fields_to_compare\n",
    "        if cached_metadata.get(field)\n",
    "        != expected_metadata.get(field)\n",
    "    ]\n",
    "\n",
    "    if mismatched_fields:\n",
    "        return (\n",
    "            False,\n",
    "            \"Cached configuration differs in: \"\n",
    "            + \", \".join(mismatched_fields),\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        True,\n",
    "        \"Cache matches the current tuned XGBoost evaluation.\",\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Training-fold class weighting\n",
    "# ------------------------------------------------------------\n",
    "def calculate_scale_pos_weight(y_train):\n",
    "    \"\"\"\n",
    "    Calculate XGBoost's positive-class weight using training data only.\n",
    "    \"\"\"\n",
    "    n_positive = int(\n",
    "        np.sum(y_train == 1)\n",
    "    )\n",
    "\n",
    "    n_negative = int(\n",
    "        np.sum(y_train == 0)\n",
    "    )\n",
    "\n",
    "    if n_positive == 0:\n",
    "        raise ValueError(\n",
    "            \"A training partition contains no positive samples.\"\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        n_negative\n",
    "        / n_positive\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Recording-level evaluation\n",
    "# ------------------------------------------------------------\n",
    "def evaluate_xgb_recording_level(\n",
    "    X,\n",
    "    y,\n",
    "    best_params,\n",
    "    n_repetitions,\n",
    "    test_size,\n",
    "    seed,\n",
    "    verbose=True,\n",
    "):\n",
    "    \"\"\"\n",
    "    Evaluate tuned XGBoost using repeated random recording-level\n",
    "    80/20 splits, matching the baseline partitioning strategy.\n",
    "    \"\"\"\n",
    "    sample_indices = np.arange(\n",
    "        X.shape[0]\n",
    "    )\n",
    "\n",
    "    rng = np.random.default_rng(\n",
    "        seed\n",
    "    )\n",
    "\n",
    "    result_rows = []\n",
    "    prediction_rows = []\n",
    "    confusion_rows = []\n",
    "\n",
    "    for repetition in range(\n",
    "        n_repetitions\n",
    "    ):\n",
    "        split_seed = int(\n",
    "            rng.integers(\n",
    "                0,\n",
    "                np.iinfo(np.int32).max,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        train_indices, test_indices = (\n",
    "            train_test_split(\n",
    "                sample_indices,\n",
    "                test_size=test_size,\n",
    "                random_state=split_seed,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        X_train = X[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        X_test = X[\n",
    "            test_indices\n",
    "        ]\n",
    "\n",
    "        y_train = y[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        y_test = y[\n",
    "            test_indices\n",
    "        ]\n",
    "\n",
    "        scale_pos_weight = (\n",
    "            calculate_scale_pos_weight(\n",
    "                y_train\n",
    "            )\n",
    "        )\n",
    "\n",
    "        model = make_xgb_classifier(\n",
    "            params=best_params,\n",
    "            scale_pos_weight=scale_pos_weight,\n",
    "            seed=seed,\n",
    "        )\n",
    "\n",
    "        start_time = time.perf_counter()\n",
    "\n",
    "        model.fit(\n",
    "            X_train,\n",
    "            y_train,\n",
    "        )\n",
    "\n",
    "        fit_time = (\n",
    "            time.perf_counter()\n",
    "            - start_time\n",
    "        )\n",
    "\n",
    "        y_pred = model.predict(\n",
    "            X_test\n",
    "        )\n",
    "\n",
    "        weighted_f1 = f1_score(\n",
    "            y_test,\n",
    "            y_pred,\n",
    "            average=\"weighted\",\n",
    "        )\n",
    "\n",
    "        balanced_accuracy = (\n",
    "            balanced_accuracy_score(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        matrix = confusion_matrix(\n",
    "            y_test,\n",
    "            y_pred,\n",
    "            labels=[0, 1],\n",
    "        )\n",
    "\n",
    "        tn, fp, fn, tp = (\n",
    "            matrix.ravel()\n",
    "        )\n",
    "\n",
    "        result_rows.append(\n",
    "            {\n",
    "                \"protocol\": (\n",
    "                    \"recording-level\"\n",
    "                ),\n",
    "                \"fold\": int(\n",
    "                    repetition\n",
    "                ),\n",
    "                \"weighted_f1\": float(\n",
    "                    weighted_f1\n",
    "                ),\n",
    "                \"balanced_accuracy\": float(\n",
    "                    balanced_accuracy\n",
    "                ),\n",
    "                \"fit_time_seconds\": float(\n",
    "                    fit_time\n",
    "                ),\n",
    "                \"train_samples\": int(\n",
    "                    len(y_train)\n",
    "                ),\n",
    "                \"test_samples\": int(\n",
    "                    len(y_test)\n",
    "                ),\n",
    "                \"scale_pos_weight\": float(\n",
    "                    scale_pos_weight\n",
    "                ),\n",
    "                \"split_seed\": int(\n",
    "                    split_seed\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "        confusion_rows.append(\n",
    "            {\n",
    "                \"protocol\": (\n",
    "                    \"recording-level\"\n",
    "                ),\n",
    "                \"fold\": int(\n",
    "                    repetition\n",
    "                ),\n",
    "                \"true_negative\": int(tn),\n",
    "                \"false_positive\": int(fp),\n",
    "                \"false_negative\": int(fn),\n",
    "                \"true_positive\": int(tp),\n",
    "            }\n",
    "        )\n",
    "\n",
    "        for (\n",
    "            sample_index,\n",
    "            true_label,\n",
    "            predicted_label,\n",
    "        ) in zip(\n",
    "            test_indices,\n",
    "            y_test,\n",
    "            y_pred,\n",
    "        ):\n",
    "            prediction_rows.append(\n",
    "                {\n",
    "                    \"protocol\": (\n",
    "                        \"recording-level\"\n",
    "                    ),\n",
    "                    \"fold\": int(\n",
    "                        repetition\n",
    "                    ),\n",
    "                    \"sample_index\": int(\n",
    "                        sample_index\n",
    "                    ),\n",
    "                    \"subject\": str(\n",
    "                        groups_audio_np[\n",
    "                            sample_index\n",
    "                        ]\n",
    "                    ),\n",
    "                    \"y_true\": int(\n",
    "                        true_label\n",
    "                    ),\n",
    "                    \"y_pred\": int(\n",
    "                        predicted_label\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "        if verbose:\n",
    "            print(\n",
    "                f\"Recording split \"\n",
    "                f\"{repetition + 1:2d}/\"\n",
    "                f\"{n_repetitions:2d} | \"\n",
    "                f\"train={len(y_train):3d} | \"\n",
    "                f\"test={len(y_test):3d} | \"\n",
    "                f\"F1={weighted_f1:.3f} | \"\n",
    "                f\"BAcc={balanced_accuracy:.3f}\"\n",
    "            )\n",
    "\n",
    "    return (\n",
    "        pd.DataFrame(result_rows),\n",
    "        pd.DataFrame(confusion_rows),\n",
    "        pd.DataFrame(prediction_rows),\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Subject-independent evaluation\n",
    "# ------------------------------------------------------------\n",
    "def evaluate_xgb_subject_independent(\n",
    "    X,\n",
    "    y,\n",
    "    groups,\n",
    "    best_params,\n",
    "    n_splits,\n",
    "    seed,\n",
    "    verbose=True,\n",
    "):\n",
    "    \"\"\"\n",
    "    Evaluate tuned XGBoost using subject-independent GroupKFold.\n",
    "    \"\"\"\n",
    "    cv = GroupKFold(\n",
    "        n_splits=n_splits\n",
    "    )\n",
    "\n",
    "    result_rows = []\n",
    "    prediction_rows = []\n",
    "    confusion_rows = []\n",
    "\n",
    "    split_iterator = cv.split(\n",
    "        X,\n",
    "        y,\n",
    "        groups=groups,\n",
    "    )\n",
    "\n",
    "    for fold, (\n",
    "        train_indices,\n",
    "        test_indices,\n",
    "    ) in enumerate(split_iterator):\n",
    "\n",
    "        X_train = X[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        X_test = X[\n",
    "            test_indices\n",
    "        ]\n",
    "\n",
    "        y_train = y[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        y_test = y[\n",
    "            test_indices\n",
    "        ]\n",
    "\n",
    "        groups_train = groups[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        groups_test = groups[\n",
    "            test_indices\n",
    "        ]\n",
    "\n",
    "        shared_subjects = np.intersect1d(\n",
    "            np.unique(groups_train),\n",
    "            np.unique(groups_test),\n",
    "        )\n",
    "\n",
    "        if shared_subjects.size != 0:\n",
    "            raise RuntimeError(\n",
    "                \"Subject leakage detected in fold \"\n",
    "                f\"{fold + 1}: \"\n",
    "                f\"{shared_subjects.tolist()}\"\n",
    "            )\n",
    "\n",
    "        scale_pos_weight = (\n",
    "            calculate_scale_pos_weight(\n",
    "                y_train\n",
    "            )\n",
    "        )\n",
    "\n",
    "        model = make_xgb_classifier(\n",
    "            params=best_params,\n",
    "            scale_pos_weight=scale_pos_weight,\n",
    "            seed=seed,\n",
    "        )\n",
    "\n",
    "        start_time = time.perf_counter()\n",
    "\n",
    "        model.fit(\n",
    "            X_train,\n",
    "            y_train,\n",
    "        )\n",
    "\n",
    "        fit_time = (\n",
    "            time.perf_counter()\n",
    "            - start_time\n",
    "        )\n",
    "\n",
    "        y_pred = model.predict(\n",
    "            X_test\n",
    "        )\n",
    "\n",
    "        weighted_f1 = f1_score(\n",
    "            y_test,\n",
    "            y_pred,\n",
    "            average=\"weighted\",\n",
    "        )\n",
    "\n",
    "        balanced_accuracy = (\n",
    "            balanced_accuracy_score(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        matrix = confusion_matrix(\n",
    "            y_test,\n",
    "            y_pred,\n",
    "            labels=[0, 1],\n",
    "        )\n",
    "\n",
    "        tn, fp, fn, tp = (\n",
    "            matrix.ravel()\n",
    "        )\n",
    "\n",
    "        train_subjects = (\n",
    "            np.unique(groups_train)\n",
    "        )\n",
    "\n",
    "        test_subjects = (\n",
    "            np.unique(groups_test)\n",
    "        )\n",
    "\n",
    "        result_rows.append(\n",
    "            {\n",
    "                \"protocol\": (\n",
    "                    \"subject-independent\"\n",
    "                ),\n",
    "                \"fold\": int(\n",
    "                    fold\n",
    "                ),\n",
    "                \"weighted_f1\": float(\n",
    "                    weighted_f1\n",
    "                ),\n",
    "                \"balanced_accuracy\": float(\n",
    "                    balanced_accuracy\n",
    "                ),\n",
    "                \"fit_time_seconds\": float(\n",
    "                    fit_time\n",
    "                ),\n",
    "                \"train_samples\": int(\n",
    "                    len(y_train)\n",
    "                ),\n",
    "                \"test_samples\": int(\n",
    "                    len(y_test)\n",
    "                ),\n",
    "                \"train_subjects\": int(\n",
    "                    len(train_subjects)\n",
    "                ),\n",
    "                \"test_subjects\": int(\n",
    "                    len(test_subjects)\n",
    "                ),\n",
    "                \"scale_pos_weight\": float(\n",
    "                    scale_pos_weight\n",
    "                ),\n",
    "                \"split_seed\": np.nan,\n",
    "            }\n",
    "        )\n",
    "\n",
    "        confusion_rows.append(\n",
    "            {\n",
    "                \"protocol\": (\n",
    "                    \"subject-independent\"\n",
    "                ),\n",
    "                \"fold\": int(\n",
    "                    fold\n",
    "                ),\n",
    "                \"true_negative\": int(tn),\n",
    "                \"false_positive\": int(fp),\n",
    "                \"false_negative\": int(fn),\n",
    "                \"true_positive\": int(tp),\n",
    "            }\n",
    "        )\n",
    "\n",
    "        for (\n",
    "            sample_index,\n",
    "            subject,\n",
    "            true_label,\n",
    "            predicted_label,\n",
    "        ) in zip(\n",
    "            test_indices,\n",
    "            groups_test,\n",
    "            y_test,\n",
    "            y_pred,\n",
    "        ):\n",
    "            prediction_rows.append(\n",
    "                {\n",
    "                    \"protocol\": (\n",
    "                        \"subject-independent\"\n",
    "                    ),\n",
    "                    \"fold\": int(\n",
    "                        fold\n",
    "                    ),\n",
    "                    \"sample_index\": int(\n",
    "                        sample_index\n",
    "                    ),\n",
    "                    \"subject\": str(\n",
    "                        subject\n",
    "                    ),\n",
    "                    \"y_true\": int(\n",
    "                        true_label\n",
    "                    ),\n",
    "                    \"y_pred\": int(\n",
    "                        predicted_label\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "        if verbose:\n",
    "            print(\n",
    "                f\"Grouped fold \"\n",
    "                f\"{fold + 1:2d}/\"\n",
    "                f\"{n_splits:2d} | \"\n",
    "                f\"train subjects=\"\n",
    "                f\"{len(train_subjects):2d} | \"\n",
    "                f\"test subjects=\"\n",
    "                f\"{len(test_subjects):2d} | \"\n",
    "                f\"F1={weighted_f1:.3f} | \"\n",
    "                f\"BAcc={balanced_accuracy:.3f}\"\n",
    "            )\n",
    "\n",
    "    return (\n",
    "        pd.DataFrame(result_rows),\n",
    "        pd.DataFrame(confusion_rows),\n",
    "        pd.DataFrame(prediction_rows),\n",
    "    )\n",
    "\n",
