    "# ------------------------------------------------------------\n",
    "# Fingerprint helpers\n",
    "# ------------------------------------------------------------\n",
    "def file_fingerprint(path):\n",
    "    \"\"\"\n",
    "    Compute a SHA-256 fingerprint of a file when available.\n",
    "    \"\"\"\n",
    "    if not os.path.isfile(path):\n",
    "        return None\n",
    "\n",
    "    hasher = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\",\n",
    "    ) as file:\n",
    "        while True:\n",
    "            chunk = file.read(\n",
    "                1024 * 1024\n",
    "            )\n",
    "\n",
    "            if not chunk:\n",
    "                break\n",
    "\n",
    "            hasher.update(\n",
    "                chunk\n",
    "            )\n",
    "\n",
    "    return hasher.hexdigest()\n",
    "\n",
    "\n",
    "def stressid_w2v_dataset_fingerprint(\n",
    "    dataframe,\n",
    "):\n",
    "    \"\"\"\n",
    "    Fingerprint the recording selection, labels, and subjects.\n",
    "\n",
    "    Audio file contents are not hashed here; the fingerprint tracks\n",
    "    the dataset rows used to construct the embedding matrix.\n",
    "    \"\"\"\n",
    "    columns = [\n",
    "        \"filepath\",\n",
    "        \"subject\",\n",
    "        \"binary-stress\",\n",
    "    ]\n",
    "\n",
    "    normalized = (\n",
    "        dataframe[\n",
    "            columns\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "\n",
    "    hasher = hashlib.sha256()\n",
    "\n",
    "    for row in normalized.itertuples(\n",
    "        index=False,\n",
    "        name=None,\n",
    "    ):\n",
    "        for value in row:\n",
    "            hasher.update(\n",
    "                value.encode(\"utf-8\")\n",
    "            )\n",
    "            hasher.update(b\"\\0\")\n",
    "\n",
    "    return hasher.hexdigest()\n",
    "\n",
    "\n",
    "def normalize_w2v_metadata(value):\n",
    "    \"\"\"Convert values into JSON-compatible Python objects.\"\"\"\n",
    "    if isinstance(value, dict):\n",
    "        return {\n",
    "            str(key): normalize_w2v_metadata(item)\n",
    "            for key, item in value.items()\n",
    "        }\n",
    "\n",
    "    if isinstance(value, (list, tuple)):\n",
    "        return [\n",
    "            normalize_w2v_metadata(item)\n",
    "            for item in value\n",
    "        ]\n",
    "\n",
    "    if isinstance(value, np.generic):\n",
    "        return value.item()\n",
    "\n",
    "    return value\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
