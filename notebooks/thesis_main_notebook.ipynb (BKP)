    "# ============================================================\n",
    "# 4.2. Subject-Independent Results\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from IPython.display import display\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Resolve upstream result objects\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# 2.3.2 handcrafted subject-independent baseline\n",
    "if \"grouped_summary\" not in globals():\n",
    "\n",
    "    if (\n",
    "        \"GROUPED_RESULTS_CACHE\" in globals()\n",
    "        and os.path.isfile(GROUPED_RESULTS_CACHE)\n",
    "    ):\n",
    "        grouped_results = pd.read_parquet(\n",
    "            GROUPED_RESULTS_CACHE\n",
    "        )\n",
    "\n",
    "        grouped_summary = (\n",
    "            summarize_subject_independent_results(\n",
    "                grouped_results\n",
    "            )\n",
    "        )\n",
    "\n",
    "        grouped_summary_source = \"cache\"\n",
    "\n",
    "    else:\n",
    "        raise FileNotFoundError(\n",
    "            \"grouped_summary is not available in memory and the \"\n",
    "            \"Section 2.3.2 result cache could not be found. \"\n",
    "            \"Run Section 2.3.2 locally first or provide its cache.\"\n",
    "        )\n",
    "\n",
    "else:\n",
    "    grouped_summary_source = \"memory\"\n",
    "\n",
    "\n",
    "# 2.6 tuned XGBoost subject-independent result\n",
    "if \"xgb_eval_summary\" not in globals():\n",
    "\n",
    "    if (\n",
    "        \"XGB_EVAL_RESULTS_CACHE\" in globals()\n",
    "        and os.path.isfile(XGB_EVAL_RESULTS_CACHE)\n",
    "    ):\n",
    "        xgb_eval_results = pd.read_parquet(\n",
    "            XGB_EVAL_RESULTS_CACHE\n",
    "        )\n",
    "\n",
    "        xgb_eval_summary = (\n",
    "            summarize_xgb_evaluation(\n",
    "                xgb_eval_results\n",
    "            )\n",
    "        )\n",
    "\n",
    "        xgb_eval_summary_source = \"cache\"\n",
    "\n",
    "    else:\n",
    "        raise FileNotFoundError(\n",
    "            \"xgb_eval_summary is not available in memory and the \"\n",
    "            \"Section 2.6 tuned-XGBoost evaluation cache could not \"\n",
    "            \"be found. Run Section 2.6 locally first or provide \"\n",
    "            \"its cache.\"\n",
    "        )\n",
    "\n",
    "else:\n",
    "    xgb_eval_summary_source = \"memory\"\n",
    "\n",
    "\n",
    "# 3.3 wav2vec subject-independent baseline\n",
    "if \"w2v_grouped_summary\" not in globals():\n",
    "\n",
    "    if (\n",
    "        \"W2V_BASELINE_RESULTS_CACHE\" in globals()\n",
    "        and os.path.isfile(W2V_BASELINE_RESULTS_CACHE)\n",
    "    ):\n",
    "        w2v_baseline_results = pd.read_parquet(\n",
    "            W2V_BASELINE_RESULTS_CACHE\n",
    "        )\n",
    "\n",
    "        w2v_grouped_summary = (\n",
    "            summarize_w2v_baseline(\n",
    "                w2v_baseline_results,\n",
    "                protocol=\"subject-independent\",\n",
    "            )\n",
    "        )\n",
    "\n",
    "        w2v_grouped_summary_source = \"cache\"\n",
    "\n",
    "    else:\n",
    "        raise FileNotFoundError(\n",
    "            \"w2v_grouped_summary is not available in memory and \"\n",
    "            \"the Section 3.3 wav2vec baseline cache could not be \"\n",
    "            \"found. Run Section 3.3 locally first or provide its \"\n",
    "            \"cache.\"\n",
    "        )\n",
    "\n",
    "else:\n",
    "    w2v_grouped_summary_source = \"memory\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reader-facing model names\n",
    "# ------------------------------------------------------------\n",
    "classifier_display_names = {\n",
    "    \"RandomForestClassifier\": \"RF\",\n",
