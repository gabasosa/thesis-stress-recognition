    "display(\n",
    "    styled_recording_results\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Export complete numerical table\n",
    "# ------------------------------------------------------------\n",
    "recording_results_path = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_recording_level_comparative_results.csv\",\n",
    ")\n",
    "\n",
    "df_results_recording.to_csv(\n",
    "    recording_results_path,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"\\nSaved:\")\n",
    "print(\n",
    "    f\"- {recording_results_path}\"\n",
    ")"
