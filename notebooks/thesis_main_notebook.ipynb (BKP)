    "# ============================================================\n",
    "# 2.4. Comparison of Recording-Level and\n",
    "#      Subject-Independent Results\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Validate required summaries\n",
    "# ------------------------------------------------------------\n",
    "required_summaries = [\n",
    "    \"official_summary\",\n",
    "    \"grouped_summary\",\n",
    "]\n",
    "\n",
    "missing_summaries = [\n",
    "    name\n",
    "    for name in required_summaries\n",
    "    if name not in globals()\n",
    "]\n",
    "\n",
    "if missing_summaries:\n",
    "    raise RuntimeError(\n",
    "        \"The following result summaries are missing: \"\n",
    "        f\"{missing_summaries}. Run Sections 2.3.1 and 2.3.2 first.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Select and rename comparable metrics\n",
    "# ------------------------------------------------------------\n",
    "recording_level_summary = (\n",
    "    official_summary[\n",
    "        [\n",
    "            \"weighted_f1_mean\",\n",
    "            \"weighted_f1_std\",\n",
    "            \"balanced_accuracy_mean\",\n",
    "            \"balanced_accuracy_std\",\n",
    "        ]\n",
    "    ]\n",
    "    .rename(\n",
    "        columns={\n",
    "            \"weighted_f1_mean\": \"recording_weighted_f1_mean\",\n",
    "            \"weighted_f1_std\": \"recording_weighted_f1_std\",\n",
    "            \"balanced_accuracy_mean\": (\n",
    "                \"recording_balanced_accuracy_mean\"\n",
    "            ),\n",
    "            \"balanced_accuracy_std\": (\n",
    "                \"recording_balanced_accuracy_std\"\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    ")\n",
    "\n",
    "subject_independent_summary = (\n",
    "    grouped_summary[\n",
    "        [\n",
    "            \"weighted_f1_mean\",\n",
    "            \"weighted_f1_std\",\n",
    "            \"balanced_accuracy_mean\",\n",
    "            \"balanced_accuracy_std\",\n",
    "        ]\n",
    "    ]\n",
    "    .rename(\n",
    "        columns={\n",
    "            \"weighted_f1_mean\": \"grouped_weighted_f1_mean\",\n",
    "            \"weighted_f1_std\": \"grouped_weighted_f1_std\",\n",
    "            \"balanced_accuracy_mean\": (\n",
    "                \"grouped_balanced_accuracy_mean\"\n",
    "            ),\n",
    "            \"balanced_accuracy_std\": (\n",
    "                \"grouped_balanced_accuracy_std\"\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Merge both protocols\n",
    "# ------------------------------------------------------------\n",
    "protocol_comparison = recording_level_summary.join(\n",
    "    subject_independent_summary,\n",
    "    how=\"outer\",\n",
    ")\n",
    "\n",
    "protocol_comparison[\"weighted_f1_difference\"] = (\n",
    "    protocol_comparison[\"grouped_weighted_f1_mean\"]\n",
    "    - protocol_comparison[\"recording_weighted_f1_mean\"]\n",
    ")\n",
    "\n",
    "protocol_comparison[\"balanced_accuracy_difference\"] = (\n",
    "    protocol_comparison[\"grouped_balanced_accuracy_mean\"]\n",
    "    - protocol_comparison[\"recording_balanced_accuracy_mean\"]\n",
    ")\n",
    "\n",
    "protocol_comparison.index.name = \"classifier\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reader-facing names and order\n",
    "# ------------------------------------------------------------\n",
    "classifier_display_names = {\n",
    "    \"RandomForestClassifier\": \"Audio HC features + RF\",\n",
    "    \"KNeighborsClassifier (k=3)\": \"Audio HC features + kNN (k=3)\",\n",
    "    \"SVC\": \"Audio HC features + SVM\",\n",
    "    \"MLPClassifier\": \"Audio HC features + MLP\",\n",
    "}\n",
    "\n",
    "preferred_classifier_order = [\n",
    "    \"RandomForestClassifier\",\n",
    "    \"KNeighborsClassifier (k=3)\",\n",
    "    \"SVC\",\n",
    "    \"MLPClassifier\",\n",
    "]\n",
    "\n",
    "available_classifier_order = [\n",
    "    classifier\n",
    "    for classifier in preferred_classifier_order\n",
    "    if classifier in protocol_comparison.index\n",
    "]\n",
    "\n",
    "remaining_classifiers = [\n",
    "    classifier\n",
    "    for classifier in protocol_comparison.index\n",
    "    if classifier not in available_classifier_order\n",
    "]\n",
    "\n",
    "classifier_order = (\n",
    "    available_classifier_order\n",
    "    + remaining_classifiers\n",
    ")\n",
    "\n",
    "comparison_for_display = protocol_comparison.loc[\n",
    "    classifier_order\n",
    "].copy()\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Formatting helpers\n",
    "# ------------------------------------------------------------\n",
    "def format_mean_std(mean_value, std_value):\n",
    "    \"\"\"Format a metric as mean ± sample standard deviation.\"\"\"\n",
    "    if pd.isna(mean_value) or pd.isna(std_value):\n",
    "        return \"N/A\"\n",
    "\n",
    "    return f\"{mean_value:.3f} ± {std_value:.3f}\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Construct the authors-style table\n",
    "# ------------------------------------------------------------\n",
    "display_columns = pd.MultiIndex.from_tuples(\n",
    "    [\n",
    "        (\"Recording-level\", \"Weighted F1\"),\n",
    "        (\"Recording-level\", \"Balanced accuracy\"),\n",
    "        (\"Subject-independent\", \"Weighted F1\"),\n",
    "        (\"Subject-independent\", \"Balanced accuracy\"),\n",
    "    ]\n",
    ")\n",
    "\n",
    "display_index = [\n",
    "    classifier_display_names.get(\n",
    "        classifier,\n",
    "        classifier,\n",
    "    )\n",
    "    for classifier in comparison_for_display.index\n",
    "]\n",
    "\n",
    "comparison_table = pd.DataFrame(\n",
    "    index=display_index,\n",
    "    columns=display_columns,\n",
    "    dtype=object,\n",
    ")\n",
    "\n",
    "comparison_table.index.name = \"Baseline\"\n",
    "\n",
    "for classifier, row in comparison_for_display.iterrows():\n",
    "    display_name = classifier_display_names.get(\n",
    "        classifier,\n",
    "        classifier,\n",
    "    )\n",
    "\n",
    "    comparison_table.loc[\n",
    "        display_name,\n",
    "        (\"Recording-level\", \"Weighted F1\"),\n",
    "    ] = format_mean_std(\n",
    "        row[\"recording_weighted_f1_mean\"],\n",
    "        row[\"recording_weighted_f1_std\"],\n",
    "    )\n",
    "\n",
    "    comparison_table.loc[\n",
    "        display_name,\n",
    "        (\"Recording-level\", \"Balanced accuracy\"),\n",
    "    ] = format_mean_std(\n",
    "        row[\"recording_balanced_accuracy_mean\"],\n",
    "        row[\"recording_balanced_accuracy_std\"],\n",
    "    )\n",
    "\n",
    "    comparison_table.loc[\n",
    "        display_name,\n",
    "        (\"Subject-independent\", \"Weighted F1\"),\n",
    "    ] = format_mean_std(\n",
    "        row[\"grouped_weighted_f1_mean\"],\n",
    "        row[\"grouped_weighted_f1_std\"],\n",
    "    )\n",
    "\n",
    "    comparison_table.loc[\n",
    "        display_name,\n",
    "        (\"Subject-independent\", \"Balanced accuracy\"),\n",
    "    ] = format_mean_std(\n",
    "        row[\"grouped_balanced_accuracy_mean\"],\n",
    "        row[\"grouped_balanced_accuracy_std\"],\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Identify the best mean under each protocol and metric\n",
    "# ------------------------------------------------------------\n",
    "best_internal_rows = {\n",
    "    (\"Recording-level\", \"Weighted F1\"): (\n",
    "        comparison_for_display[\n",
    "            \"recording_weighted_f1_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "    (\"Recording-level\", \"Balanced accuracy\"): (\n",
    "        comparison_for_display[\n",
    "            \"recording_balanced_accuracy_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "    (\"Subject-independent\", \"Weighted F1\"): (\n",
    "        comparison_for_display[\n",
    "            \"grouped_weighted_f1_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "    (\"Subject-independent\", \"Balanced accuracy\"): (\n",
    "        comparison_for_display[\n",
    "            \"grouped_balanced_accuracy_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "}\n",
    "\n",
    "best_display_rows = {\n",
    "    column: classifier_display_names.get(\n",
    "        classifier,\n",
    "        classifier,\n",
    "    )\n",
    "    for column, classifier in best_internal_rows.items()\n",
    "}\n",
    "\n",
    "\n",
    "def highlight_best_results(data):\n",
    "    \"\"\"Bold the best mean value in each metric column.\"\"\"\n",
    "    styles = pd.DataFrame(\n",
    "        \"\",\n",
    "        index=data.index,\n",
    "        columns=data.columns,\n",
    "    )\n",
    "\n",
    "    for column, row_name in best_display_rows.items():\n",
    "        if (\n",
    "            row_name in styles.index\n",
    "            and column in styles.columns\n",
    "        ):\n",
    "            styles.loc[\n",
    "                row_name,\n",
    "                column,\n",
    "            ] = \"font-weight: bold;\"\n",
    "\n",
    "    return styles\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Style and display\n",
    "# ------------------------------------------------------------\n",
    "styled_comparison_table = (\n",
    "    comparison_table.style\n",
    "    .apply(\n",
    "        highlight_best_results,\n",
    "        axis=None,\n",
    "    )\n",
    "    .set_properties(\n",
    "        **{\n",
    "            \"text-align\": \"center\",\n",
    "            \"white-space\": \"nowrap\",\n",
    "            \"padding\": \"6px 12px\",\n",
    "        }\n",
    "    )\n",
    "    .set_table_styles(\n",
    "        [\n",
    "            {\n",
    "                \"selector\": \"table\",\n",
    "                \"props\": [\n",
    "                    (\"border-collapse\", \"collapse\"),\n",
    "                    (\"width\", \"auto\"),\n",
    "                    (\"margin\", \"0\"),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"th\",\n",
    "                \"props\": [\n",
    "                    (\"text-align\", \"center\"),\n",
    "                    (\"vertical-align\", \"middle\"),\n",
    "                    (\"white-space\", \"nowrap\"),\n",
    "                    (\"padding\", \"6px 12px\"),\n",
    "                    (\"border-bottom\", \"1px solid\"),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"th.row_heading\",\n",
    "                \"props\": [\n",
    "                    (\"text-align\", \"left\"),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"th.index_name\",\n",
    "                \"props\": [\n",
    "                    (\"text-align\", \"left\"),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"td\",\n",
    "                \"props\": [\n",
    "                    (\"text-align\", \"center\"),\n",
    "                    (\"white-space\", \"nowrap\"),\n",
    "                    (\"padding\", \"6px 12px\"),\n",
    "                ],\n",
    "            },\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "display(styled_comparison_table)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Export complete numerical comparison\n",
    "# ------------------------------------------------------------\n",
    "protocol_comparison_path = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_recording_vs_subject_independent.csv\",\n",
    ")\n",
    "\n",
    "protocol_comparison.to_csv(\n",
    "    protocol_comparison_path,\n",
    "    index=True,\n",
    ")\n",
    "\n",
    "print(\"\\nSaved:\")\n",
    "print(f\"- {protocol_comparison_path}\")"
