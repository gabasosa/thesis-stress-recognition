    "    )\n",
    "\n",
    "    if missing_cache_columns:\n",
    "        raise ValueError(\n",
    "            \"Cached wav2vec dataframe is missing columns: \"\n",
    "            f\"{sorted(missing_cache_columns)}\"\n",
    "        )\n",
    "\n",
    "    feature_columns = [\n",
    "        column\n",
    "        for column in dataframe.columns\n",
    "        if column.startswith(\n",
    "            \"f_\"\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    if not feature_columns:\n",
