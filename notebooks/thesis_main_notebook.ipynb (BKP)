    "# ============================================================\n",
    "# 4.3. Final Table Export\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "from IPython.display import display\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Validate evaluation directory\n",
    "# ------------------------------------------------------------\n",
    "if \"EVAL_DIR\" not in globals():\n",
    "    raise RuntimeError(\n",
    "        \"EVAL_DIR is not defined. \"\n",
    "        \"Run the notebook configuration section first.\"\n",
    "    )\n",
    "\n",
    "os.makedirs(\n",
    "    EVAL_DIR,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Source paths produced by Sections 4.1 and 4.2\n",
    "# ------------------------------------------------------------\n",
    "recording_source_path = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_recording_level_comparative_results.csv\",\n",
    ")\n",
    "\n",
    "subject_independent_source_path = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_subject_independent_comparative_results.csv\",\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Resolve recording-level results\n",
    "# ------------------------------------------------------------\n",
    "if \"df_results_recording\" in globals():\n",
    "    recording_results_for_export = (\n",
    "        df_results_recording.copy()\n",
    "    )\n",
    "\n",
    "    recording_results_source = \"memory\"\n",
    "\n",
    "elif os.path.isfile(\n",
    "    recording_source_path\n",
    "):\n",
    "    recording_results_for_export = pd.read_csv(\n",
    "        recording_source_path\n",
    "    )\n",
    "\n",
    "    recording_results_source = \"cache\"\n",
    "\n",
    "else:\n",
    "    raise FileNotFoundError(\n",
    "        \"The recording-level comparative results are not \"\n",
    "        \"available in memory and their exported CSV file \"\n",
    "        \"could not be found.\\n\"\n",
    "        f\"Expected file: {recording_source_path}\\n\"\n",
    "        \"Run Section 4.1 first.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Resolve subject-independent results\n",
    "# ------------------------------------------------------------\n",
    "if \"df_results_subject_independent\" in globals():\n",
    "    subject_independent_results_for_export = (\n",
    "        df_results_subject_independent.copy()\n",
    "    )\n",
    "\n",
    "    subject_independent_results_source = \"memory\"\n",
    "\n",
    "elif os.path.isfile(\n",
    "    subject_independent_source_path\n",
    "):\n",
    "    subject_independent_results_for_export = (\n",
    "        pd.read_csv(\n",
    "            subject_independent_source_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "    subject_independent_results_source = \"cache\"\n",
    "\n",
    "else:\n",
    "    raise FileNotFoundError(\n",
    "        \"The subject-independent comparative results are not \"\n",
    "        \"available in memory and their exported CSV file \"\n",
    "        \"could not be found.\\n\"\n",
    "        f\"Expected file: {subject_independent_source_path}\\n\"\n",
    "        \"Run Section 4.2 first.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Add explicit evaluation-protocol labels\n",
    "# ------------------------------------------------------------\n",
    "recording_results_export = (\n",
    "    recording_results_for_export.copy()\n",
    ")\n",
    "\n",
    "recording_results_export.insert(\n",
    "    0,\n",
    "    \"evaluation_protocol\",\n",
    "    \"recording-level\",\n",
    ")\n",
    "\n",
    "subject_independent_results_export = (\n",
    "    subject_independent_results_for_export.copy()\n",
    ")\n",
    "\n",
    "subject_independent_results_export.insert(\n",
    "    0,\n",
    "    \"evaluation_protocol\",\n",
    "    \"subject-independent\",\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Build combined numerical table\n",
    "# ------------------------------------------------------------\n",
    "df_results_combined = pd.concat(\n",
    "    [\n",
    "        recording_results_export,\n",
    "        subject_independent_results_export,\n",
    "    ],\n",
    "    ignore_index=True,\n",
    "    sort=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Final output paths\n",
    "# ------------------------------------------------------------\n",
    "recording_results_path = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_final_results_recording_level.csv\",\n",
    ")\n",
    "\n",
    "subject_independent_results_path = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_final_results_subject_independent.csv\",\n",
    ")\n",
    "\n",
    "combined_results_path = os.path.join(\n",
    "    EVAL_DIR,\n",
    "    \"stressid_final_results_combined.csv\",\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Export CSV files\n",
    "# ------------------------------------------------------------\n",
    "recording_results_export.to_csv(\n",
    "    recording_results_path,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "subject_independent_results_export.to_csv(\n",
    "    subject_independent_results_path,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "df_results_combined.to_csv(\n",
    "    combined_results_path,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reader-facing compact preview\n",
    "# ------------------------------------------------------------\n",
    "preview_columns = [\n",
    "    \"evaluation_protocol\",\n",
    "    \"feature_representation\",\n",
    "    \"model\",\n",
    "    \"weighted_f1_mean\",\n",
    "    \"weighted_f1_std\",\n",
    "    \"balanced_accuracy_mean\",\n",
    "    \"balanced_accuracy_std\",\n",
    "]\n",
    "\n",
    "available_preview_columns = [\n",
    "    column\n",
    "    for column in preview_columns\n",
    "    if column in df_results_combined.columns\n",
    "]\n",
    "\n",
    "df_results_combined_preview = (\n",
    "    df_results_combined[\n",
    "        available_preview_columns\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "rename_for_display = {\n",
    "    \"evaluation_protocol\": \"Evaluation protocol\",\n",
    "    \"feature_representation\": \"Feature representation\",\n",
    "    \"model\": \"Model\",\n",
    "    \"weighted_f1_mean\": \"Weighted F1 mean\",\n",
    "    \"weighted_f1_std\": \"Weighted F1 SD\",\n",
    "    \"balanced_accuracy_mean\": \"Balanced accuracy mean\",\n",
    "    \"balanced_accuracy_std\": \"Balanced accuracy SD\",\n",
    "}\n",
    "\n",
    "df_results_combined_preview = (\n",
    "    df_results_combined_preview.rename(\n",
    "        columns=rename_for_display\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Display export summary\n",
    "# ------------------------------------------------------------\n",
    "print(\"====================================================\")\n",
    "print(\" FINAL RESULT TABLES EXPORTED\")\n",
    "print(\"====================================================\")\n",
    "print(\n",
    "    \"Recording-level source: \"\n",
    "    f\"{recording_results_source}\"\n",
    ")\n",
    "print(\n",
    "    \"Subject-independent source: \"\n",
    "    f\"{subject_independent_results_source}\"\n",
    ")\n",
    "print(\n",
    "    f\"Combined rows: {len(df_results_combined)}\"\n",
    ")\n",
    "print(\"====================================================\")\n",
    "\n",
    "display(\n",
    "    df_results_combined_preview\n",
    ")\n",
    "\n",
    "print(\"\\nSaved:\")\n",
    "print(\n",
    "    f\"- {recording_results_path}\"\n",
    ")\n",
    "print(\n",
    "    f\"- {subject_independent_results_path}\"\n",
    ")\n",
    "print(\n",
    "    f\"- {combined_results_path}\"\n",
    ")"
   ]
