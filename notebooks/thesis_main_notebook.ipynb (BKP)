   "source": [
    "# ============================================================\n",
    "# 2.5. XGBoost Hyperparameter Optimization with Optuna\n",
    "# ============================================================\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "import logging\n",
    "import os\n",
    "from datetime import datetime\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import xgboost as xgb\n",
    "\n",
    "from IPython.display import display\n",
    "from sklearn.metrics import f1_score\n",
    "from sklearn.model_selection import GroupKFold, StratifiedKFold\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Validate required notebook variables\n",
    "# ------------------------------------------------------------\n",
    "required_variables = [\n",
    "    \"X_audio\",\n",
    "    \"y_audio\",\n",
    "    \"OPTUNA_DIR\",\n",
    "    \"IN_COLAB\",\n",
    "]\n",
    "\n",
    "missing_variables = [\n",
    "    name\n",
    "    for name in required_variables\n",
    "    if name not in globals()\n",
    "]\n",
    "\n",
    "if missing_variables:\n",
    "    raise RuntimeError(\n",
    "        \"The following required variables are missing: \"\n",
    "        f\"{missing_variables}. Run the previous notebook sections first.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Optimization configuration\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Number of NEW Optuna trials added each time the optimization is run.\n",
    "XGB_OPTUNA_TRIALS_PER_RUN = 50\n",
    "\n",
    "# Available options:\n",
    "#   - \"groupkfold\": subject-independent hyperparameter selection\n",
    "#   - \"stratifiedkfold\": recording-level hyperparameter selection\n",
    "XGB_OPTUNA_CV_SCHEME = \"groupkfold\"\n",
    "\n",
    "XGB_OPTUNA_N_SPLITS = int(\n",
    "    globals().get(\n",
    "        \"GROUPED_N_SPLITS\",\n",
    "        5,\n",
    "    )\n",
    ")\n",
    "\n",
    "# Fixed seed for XGBoost itself and, when applicable,\n",
    "# the shuffled StratifiedKFold partitioning.\n",
    "XGB_MODEL_RANDOM_SEED = int(\n",
    "    globals().get(\n",
    "        \"SEED\",\n",
    "        42,\n",
    "    )\n",
    ")\n",
    "\n",
    "# Base seed used to generate different but reproducible Optuna\n",
    "# searches across successive runs.\n",
    "XGB_OPTUNA_BASE_SEED = int(\n",
    "    globals().get(\n",
    "        \"SEED\",\n",
    "        42,\n",
    "    )\n",
    ")\n",
    "\n",
    "if XGB_OPTUNA_CV_SCHEME not in {\n",
    "    \"groupkfold\",\n",
    "    \"stratifiedkfold\",\n",
    "}:\n",
    "    raise ValueError(\n",
    "        \"XGB_OPTUNA_CV_SCHEME must be either \"\n",
    "        \"'groupkfold' or 'stratifiedkfold'.\"\n",
    "    )\n",
    "\n",
    "USE_GROUPKFOLD = (\n",
    "    XGB_OPTUNA_CV_SCHEME == \"groupkfold\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Search-space definition\n",
    "# ------------------------------------------------------------\n",
    "XGB_OPTUNA_SEARCH_SPACE = {\n",
    "    \"n_estimators\": {\n",
    "        \"type\": \"int\",\n",
    "        \"low\": 100,\n",
    "        \"high\": 600,\n",
    "    },\n",
    "    \"max_depth\": {\n",
    "        \"type\": \"int\",\n",
    "        \"low\": 2,\n",
    "        \"high\": 10,\n",
    "    },\n",
    "    \"learning_rate\": {\n",
    "        \"type\": \"float\",\n",
    "        \"low\": 1e-3,\n",
    "        \"high\": 0.2,\n",
    "        \"log\": True,\n",
    "    },\n",
    "    \"subsample\": {\n",
    "        \"type\": \"float\",\n",
    "        \"low\": 0.5,\n",
    "        \"high\": 1.0,\n",
    "    },\n",
    "    \"colsample_bytree\": {\n",
    "        \"type\": \"float\",\n",
    "        \"low\": 0.5,\n",
    "        \"high\": 1.0,\n",
    "    },\n",
    "    \"min_child_weight\": {\n",
    "        \"type\": \"int\",\n",
    "        \"low\": 1,\n",
    "        \"high\": 10,\n",
    "    },\n",
    "    \"gamma\": {\n",
    "        \"type\": \"float\",\n",
    "        \"low\": 0.0,\n",
    "        \"high\": 5.0,\n",
    "    },\n",
    "    \"reg_alpha\": {\n",
    "        \"type\": \"float\",\n",
    "        \"low\": 1e-8,\n",
    "        \"high\": 10.0,\n",
    "        \"log\": True,\n",
    "    },\n",
    "    \"reg_lambda\": {\n",
    "        \"type\": \"float\",\n",
    "        \"low\": 1e-8,\n",
    "        \"high\": 10.0,\n",
    "        \"log\": True,\n",
    "    },\n",
    "}\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Prepare and validate data\n",
    "# ------------------------------------------------------------\n",
    "X_audio_np = np.asarray(\n",
    "    X_audio,\n",
    "    dtype=np.float32,\n",
    ")\n",
    "\n",
    "y_audio_np = np.asarray(\n",
    "    y_audio,\n",
    "    dtype=np.int64,\n",
    ")\n",
    "\n",
    "if X_audio_np.ndim != 2:\n",
    "    raise ValueError(\n",
    "        \"X_audio must be two-dimensional; \"\n",
    "        f\"received shape {X_audio_np.shape}.\"\n",
    "    )\n",
    "\n",
    "if y_audio_np.ndim != 1:\n",
    "    raise ValueError(\n",
    "        \"y_audio must be one-dimensional; \"\n",
    "        f\"received shape {y_audio_np.shape}.\"\n",
    "    )\n",
    "\n",
    "if X_audio_np.shape[0] != y_audio_np.shape[0]:\n",
    "    raise ValueError(\n",
    "        \"X_audio and y_audio must contain the same number \"\n",
    "        f\"of samples; received {X_audio_np.shape[0]} and \"\n",
    "        f\"{y_audio_np.shape[0]}.\"\n",
    "    )\n",
    "\n",
    "if len(np.unique(y_audio_np)) != 2:\n",
    "    raise ValueError(\n",
    "        \"The XGBoost optimization expects exactly two classes.\"\n",
    "    )\n",
    "\n",
    "if XGB_OPTUNA_N_SPLITS < 2:\n",
    "    raise ValueError(\n",
    "        \"XGB_OPTUNA_N_SPLITS must be at least 2.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Validate subject groups for GroupKFold\n",
    "# ------------------------------------------------------------\n",
    "groups_audio_np = None\n",
    "\n",
    "if USE_GROUPKFOLD:\n",
    "    if \"groups_audio\" not in globals():\n",
    "        raise RuntimeError(\n",
    "            \"groups_audio was not found, but \"\n",
    "            \"XGB_OPTUNA_CV_SCHEME='groupkfold'.\"\n",
    "        )\n",
    "\n",
    "    groups_audio_np = np.asarray(\n",
    "        groups_audio,\n",
    "        dtype=object,\n",
    "    )\n",
    "\n",
    "    if groups_audio_np.ndim != 1:\n",
    "        raise ValueError(\n",
    "            \"groups_audio must be one-dimensional; \"\n",
    "            f\"received shape {groups_audio_np.shape}.\"\n",
    "        )\n",
    "\n",
    "    if groups_audio_np.shape[0] != X_audio_np.shape[0]:\n",
    "        raise ValueError(\n",
    "            \"groups_audio and X_audio must contain the \"\n",
    "            \"same number of samples.\"\n",
    "        )\n",
    "\n",
    "    n_subjects = len(\n",
    "        np.unique(groups_audio_np)\n",
    "    )\n",
    "\n",
    "    if XGB_OPTUNA_N_SPLITS > n_subjects:\n",
    "        raise ValueError(\n",
    "            f\"XGB_OPTUNA_N_SPLITS={XGB_OPTUNA_N_SPLITS} \"\n",
    "            f\"exceeds the number of subjects ({n_subjects}).\"\n",
    "        )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Cache paths\n",
    "# ------------------------------------------------------------\n",
    "os.makedirs(\n",
    "    OPTUNA_DIR,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "cv_suffix = XGB_OPTUNA_CV_SCHEME\n",
    "\n",
    "optuna_trials_path = os.path.join(\n",
    "    OPTUNA_DIR,\n",
    "    (\n",
    "        \"stressid_xgb_handcrafted_optuna_trials_\"\n",
    "        f\"{cv_suffix}.csv\"\n",
    "    ),\n",
    ")\n",
    "\n",
    "best_params_path = os.path.join(\n",
    "    OPTUNA_DIR,\n",
    "    (\n",
    "        \"stressid_xgb_handcrafted_best_params_\"\n",
    "        f\"{cv_suffix}.csv\"\n",
    "    ),\n",
    ")\n",
    "\n",
    "optuna_metadata_path = os.path.join(\n",
    "    OPTUNA_DIR,\n",
    "    (\n",
    "        \"stressid_xgb_handcrafted_optuna_meta_\"\n",
    "        f\"{cv_suffix}.json\"\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# JSON helpers\n",
    "# ------------------------------------------------------------\n",
    "def normalize_for_optuna_json(value):\n",
    "    \"\"\"Convert NumPy and tuple values into JSON-compatible objects.\"\"\"\n",
    "    if isinstance(value, dict):\n",
    "        return {\n",
    "            str(key): normalize_for_optuna_json(item)\n",
    "            for key, item in value.items()\n",
    "        }\n",
    "\n",
    "    if isinstance(value, (list, tuple)):\n",
    "        return [\n",
    "            normalize_for_optuna_json(item)\n",
    "            for item in value\n",
    "        ]\n",
    "\n",
    "    if isinstance(value, np.generic):\n",
    "        return value.item()\n",
    "\n",
    "    return value\n",
    "\n",
    "\n",
    "def load_json_file(path):\n",
    "    \"\"\"Load a JSON file.\"\"\"\n",
    "    with open(\n",
    "        path,\n",
    "        \"r\",\n",
    "        encoding=\"utf-8\",\n",
    "    ) as file:\n",
    "        return json.load(file)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Dataset fingerprint\n",
    "# ------------------------------------------------------------\n",
    "def xgb_optuna_data_fingerprint(\n",
    "    X,\n",
    "    y,\n",
    "    groups=None,\n",
    "):\n",
    "    \"\"\"\n",
    "    Create a fingerprint of features, labels, and optional subject IDs.\n",
    "    \"\"\"\n",
    "    hasher = hashlib.sha256()\n",
    "\n",
    "    X_contiguous = np.ascontiguousarray(X)\n",
    "    y_contiguous = np.ascontiguousarray(y)\n",
    "\n",
    "    hasher.update(\n",
    "        str(X_contiguous.shape).encode(\"utf-8\")\n",
    "    )\n",
    "    hasher.update(\n",
    "        str(X_contiguous.dtype).encode(\"utf-8\")\n",
    "    )\n",
    "    hasher.update(\n",
    "        X_contiguous.tobytes()\n",
    "    )\n",
    "\n",
    "    hasher.update(\n",
    "        str(y_contiguous.shape).encode(\"utf-8\")\n",
    "    )\n",
    "    hasher.update(\n",
    "        str(y_contiguous.dtype).encode(\"utf-8\")\n",
    "    )\n",
    "    hasher.update(\n",
    "        y_contiguous.tobytes()\n",
    "    )\n",
    "\n",
    "    if groups is not None:\n",
    "        group_strings = np.asarray(\n",
    "            groups,\n",
    "            dtype=str,\n",
    "        )\n",
    "\n",
    "        for group in group_strings:\n",
    "            hasher.update(\n",
    "                group.encode(\"utf-8\")\n",
    "            )\n",
    "            hasher.update(b\"\\0\")\n",
    "\n",
    "    return hasher.hexdigest()\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Experimental configuration metadata\n",
    "# ------------------------------------------------------------\n",
    "def build_xgb_optuna_metadata():\n",
    "    \"\"\"\n",
    "    Describe the configuration that determines whether previous\n",
    "    Optuna results are directly comparable with the current search.\n",
    "    \"\"\"\n",
    "    metadata = {\n",
    "        \"protocol\": (\n",
    "            \"stressid_xgb_handcrafted_optuna\"\n",
    "        ),\n",
    "        \"cv_scheme\": XGB_OPTUNA_CV_SCHEME,\n",
    "        \"n_splits\": int(\n",
    "            XGB_OPTUNA_N_SPLITS\n",
    "        ),\n",
    "        \"model_random_seed\": int(\n",
    "            XGB_MODEL_RANDOM_SEED\n",
    "        ),\n",
    "        \"optuna_base_seed\": int(\n",
    "            XGB_OPTUNA_BASE_SEED\n",
    "        ),\n",
    "        \"objective_metric\": (\n",
    "            \"mean_weighted_f1\"\n",
    "        ),\n",
    "        \"class_imbalance_method\": (\n",
    "            \"fold_specific_scale_pos_weight\"\n",
    "        ),\n",
    "        \"n_samples\": int(\n",
    "            X_audio_np.shape[0]\n",
    "        ),\n",
    "        \"feature_dimension\": int(\n",
    "            X_audio_np.shape[1]\n",
    "        ),\n",
    "        \"positive_class_ratio\": float(\n",
    "            np.mean(y_audio_np)\n",
    "        ),\n",
    "        \"data_fingerprint\": (\n",
    "            xgb_optuna_data_fingerprint(\n",
    "                X_audio_np,\n",
    "                y_audio_np,\n",
    "                groups_audio_np,\n",
    "            )\n",
    "        ),\n",
    "        \"search_space\": (\n",
    "            XGB_OPTUNA_SEARCH_SPACE\n",
    "        ),\n",
    "        \"xgboost_version\": xgb.__version__,\n",
    "    }\n",
    "\n",
    "    if groups_audio_np is not None:\n",
    "        metadata[\"n_subjects\"] = int(\n",
    "            len(np.unique(groups_audio_np))\n",
    "        )\n",
    "\n",
    "    return normalize_for_optuna_json(\n",
    "        metadata\n",
    "    )\n",
    "\n",
    "\n",
    "def optuna_cache_matches_configuration(\n",
    "    metadata_path,\n",
    "    expected_metadata,\n",
    "):\n",
    "    \"\"\"\n",
    "    Check whether cached Optuna results belong to the same\n",
    "    experimental configuration.\n",
    "    \"\"\"\n",
    "    if not os.path.exists(metadata_path):\n",
    "        return False, \"Metadata file is missing.\"\n",
    "\n",
    "    try:\n",
    "        cached_metadata = load_json_file(\n",
    "            metadata_path\n",
    "        )\n",
    "    except Exception as exc:\n",
    "        return (\n",
    "            False,\n",
    "            f\"Metadata could not be read: {exc}\",\n",
    "        )\n",
    "\n",
    "    fields_to_compare = [\n",
    "        \"protocol\",\n",
    "        \"cv_scheme\",\n",
    "        \"n_splits\",\n",
    "        \"model_random_seed\",\n",
    "        \"optuna_base_seed\",\n",
    "        \"objective_metric\",\n",
    "        \"class_imbalance_method\",\n",
    "        \"n_samples\",\n",
    "        \"feature_dimension\",\n",
    "        \"data_fingerprint\",\n",
    "        \"search_space\",\n",
    "        \"xgboost_version\",\n",
    "    ]\n",
    "\n",
    "    if USE_GROUPKFOLD:\n",
    "        fields_to_compare.append(\n",
    "            \"n_subjects\"\n",
    "        )\n",
    "\n",
    "    mismatched_fields = [\n",
    "        field\n",
    "        for field in fields_to_compare\n",
    "        if cached_metadata.get(field)\n",
    "        != expected_metadata.get(field)\n",
    "    ]\n",
    "\n",
    "    if mismatched_fields:\n",
    "        return (\n",
    "            False,\n",
    "            \"Cached configuration differs in: \"\n",
    "            + \", \".join(mismatched_fields),\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        True,\n",
    "        \"Cache matches the current data and Optuna configuration.\",\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# XGBoost parameter helpers\n",
    "# ------------------------------------------------------------\n",
    "def normalize_xgb_params(params):\n",
    "    \"\"\"\n",
    "    Convert cached Optuna parameters to XGBoost-compatible scalars.\n",
    "    \"\"\"\n",
    "    params = {\n",
    "        key: value\n",
    "        for key, value in dict(params).items()\n",
    "        if (\n",
    "            key in XGB_OPTUNA_SEARCH_SPACE\n",
    "            and not pd.isna(value)\n",
    "        )\n",
    "    }\n",
    "\n",
    "    integer_parameters = {\n",
    "        \"n_estimators\",\n",
    "        \"max_depth\",\n",
    "        \"min_child_weight\",\n",
    "    }\n",
    "\n",
    "    float_parameters = {\n",
    "        \"learning_rate\",\n",
    "        \"subsample\",\n",
    "        \"colsample_bytree\",\n",
    "        \"gamma\",\n",
    "        \"reg_alpha\",\n",
    "        \"reg_lambda\",\n",
    "    }\n",
    "\n",
    "    for key in integer_parameters.intersection(\n",
    "        params\n",
    "    ):\n",
    "        params[key] = int(\n",
    "            params[key]\n",
    "        )\n",
    "\n",
    "    for key in float_parameters.intersection(\n",
    "        params\n",
    "    ):\n",
    "        params[key] = float(\n",
    "            params[key]\n",
    "        )\n",
    "\n",
    "    return params\n",
    "\n",
    "\n",
    "def make_xgb_classifier(\n",
    "    params,\n",
    "    scale_pos_weight=1.0,\n",
    "    seed=XGB_MODEL_RANDOM_SEED,\n",
    "):\n",
    "    \"\"\"\n",
    "    Construct the XGBoost classifier used inside each fold.\n",
    "    \"\"\"\n",
    "    return xgb.XGBClassifier(\n",
    "        objective=\"binary:logistic\",\n",
    "        eval_metric=\"logloss\",\n",
    "        booster=\"gbtree\",\n",
    "        random_state=seed,\n",
    "        n_jobs=-1,\n",
    "        scale_pos_weight=float(\n",
    "            scale_pos_weight\n",
    "        ),\n",
    "        verbosity=0,\n",
    "        **params,\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Optuna search-space sampler\n",
    "# ------------------------------------------------------------\n",
    "def sample_xgb_parameters(trial):\n",
    "    \"\"\"Sample one XGBoost configuration.\"\"\"\n",
    "    return {\n",
    "        \"n_estimators\": trial.suggest_int(\n",
    "            \"n_estimators\",\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"n_estimators\"\n",
    "            ][\"low\"],\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"n_estimators\"\n",
    "            ][\"high\"],\n",
    "        ),\n",
    "\n",
    "        \"max_depth\": trial.suggest_int(\n",
    "            \"max_depth\",\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"max_depth\"\n",
    "            ][\"low\"],\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"max_depth\"\n",
    "            ][\"high\"],\n",
    "        ),\n",
    "\n",
    "        \"learning_rate\": trial.suggest_float(\n",
    "            \"learning_rate\",\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"learning_rate\"\n",
    "            ][\"low\"],\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"learning_rate\"\n",
    "            ][\"high\"],\n",
    "            log=True,\n",
    "        ),\n",
    "\n",
    "        \"subsample\": trial.suggest_float(\n",
    "            \"subsample\",\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"subsample\"\n",
    "            ][\"low\"],\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"subsample\"\n",
    "            ][\"high\"],\n",
    "        ),\n",
    "\n",
    "        \"colsample_bytree\": trial.suggest_float(\n",
    "            \"colsample_bytree\",\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"colsample_bytree\"\n",
    "            ][\"low\"],\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"colsample_bytree\"\n",
    "            ][\"high\"],\n",
    "        ),\n",
    "\n",
    "        \"min_child_weight\": trial.suggest_int(\n",
    "            \"min_child_weight\",\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"min_child_weight\"\n",
    "            ][\"low\"],\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"min_child_weight\"\n",
    "            ][\"high\"],\n",
    "        ),\n",
    "\n",
    "        \"gamma\": trial.suggest_float(\n",
    "            \"gamma\",\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"gamma\"\n",
    "            ][\"low\"],\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"gamma\"\n",
    "            ][\"high\"],\n",
    "        ),\n",
    "\n",
    "        \"reg_alpha\": trial.suggest_float(\n",
    "            \"reg_alpha\",\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"reg_alpha\"\n",
    "            ][\"low\"],\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"reg_alpha\"\n",
    "            ][\"high\"],\n",
    "            log=True,\n",
    "        ),\n",
    "\n",
    "        \"reg_lambda\": trial.suggest_float(\n",
    "            \"reg_lambda\",\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"reg_lambda\"\n",
    "            ][\"low\"],\n",
    "            XGB_OPTUNA_SEARCH_SPACE[\n",
    "                \"reg_lambda\"\n",
    "            ][\"high\"],\n",
    "            log=True,\n",
    "        ),\n",
    "    }\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Load cached best parameters\n",
    "# ------------------------------------------------------------\n",
    "def load_cached_best_xgb_params():\n",
    "    \"\"\"Load the best compatible parameter set found so far.\"\"\"\n",
    "    best_df = pd.read_csv(\n",
    "        best_params_path\n",
    "    )\n",
    "\n",
    "    if best_df.empty:\n",
    "        raise ValueError(\n",
    "            \"The cached best-parameters file is empty.\"\n",
    "        )\n",
    "\n",
    "    if \"best_mean_weighted_f1\" not in best_df.columns:\n",
    "        raise ValueError(\n",
    "            \"Column 'best_mean_weighted_f1' was not found \"\n",
    "            \"in the cached best-parameters file.\"\n",
    "        )\n",
    "\n",
    "    best_score = float(\n",
    "        best_df.loc[\n",
    "            0,\n",
    "            \"best_mean_weighted_f1\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    best_source_run = None\n",
    "\n",
    "    if \"source_run\" in best_df.columns:\n",
    "        best_source_run = int(\n",
    "            best_df.loc[\n",
    "                0,\n",
    "                \"source_run\",\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    parameter_values = {\n",
    "        parameter: best_df.loc[\n",
    "            0,\n",
    "            parameter,\n",
    "        ]\n",
    "        for parameter in XGB_OPTUNA_SEARCH_SPACE\n",
    "        if parameter in best_df.columns\n",
    "    }\n",
    "\n",
    "    best_params = normalize_xgb_params(\n",
    "        parameter_values\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        best_params,\n",
    "        best_score,\n",
    "        best_source_run,\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Optuna objective\n",
    "# ------------------------------------------------------------\n",
    "def objective_xgb_handcrafted(trial):\n",
    "    \"\"\"\n",
    "    Evaluate one candidate configuration through cross-validation.\n",
    "\n",
    "    The resulting score is used only for hyperparameter selection.\n",
    "    \"\"\"\n",
    "    candidate_params = sample_xgb_parameters(\n",
    "        trial\n",
    "    )\n",
    "\n",
    "    fold_weighted_f1 = []\n",
    "\n",
    "    if USE_GROUPKFOLD:\n",
    "        cv = GroupKFold(\n",
    "            n_splits=XGB_OPTUNA_N_SPLITS\n",
    "        )\n",
    "\n",
    "        split_iterator = cv.split(\n",
    "            X_audio_np,\n",
    "            y_audio_np,\n",
    "            groups=groups_audio_np,\n",
    "        )\n",
    "\n",
    "    else:\n",
    "        cv = StratifiedKFold(\n",
    "            n_splits=XGB_OPTUNA_N_SPLITS,\n",
    "            shuffle=True,\n",
    "            random_state=XGB_MODEL_RANDOM_SEED,\n",
    "        )\n",
    "\n",
    "        split_iterator = cv.split(\n",
    "            X_audio_np,\n",
    "            y_audio_np,\n",
    "        )\n",
    "\n",
    "    for fold_index, (\n",
    "        train_indices,\n",
    "        validation_indices,\n",
    "    ) in enumerate(split_iterator):\n",
    "\n",
    "        X_train = X_audio_np[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        X_validation = X_audio_np[\n",
    "            validation_indices\n",
    "        ]\n",
    "\n",
    "        y_train = y_audio_np[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        y_validation = y_audio_np[\n",
    "            validation_indices\n",
    "        ]\n",
    "\n",
    "        # Explicit leakage check for subject-independent CV.\n",
    "        if USE_GROUPKFOLD:\n",
    "            train_groups = groups_audio_np[\n",
    "                train_indices\n",
    "            ]\n",
    "\n",
    "            validation_groups = groups_audio_np[\n",
    "                validation_indices\n",
    "            ]\n",
    "\n",
    "            shared_subjects = np.intersect1d(\n",
    "                np.unique(train_groups),\n",
    "                np.unique(validation_groups),\n",
    "            )\n",
    "\n",
    "            if shared_subjects.size != 0:\n",
    "                raise RuntimeError(\n",
    "                    \"Subject leakage detected in Optuna fold \"\n",
    "                    f\"{fold_index + 1}: \"\n",
    "                    f\"{shared_subjects.tolist()}\"\n",
    "                )\n",
    "\n",
    "        positive_samples = int(\n",
    "            np.sum(y_train == 1)\n",
    "        )\n",
    "\n",
    "        negative_samples = int(\n",
    "            np.sum(y_train == 0)\n",
    "        )\n",
    "\n",
    "        if positive_samples == 0:\n",
    "            raise ValueError(\n",
    "                \"A training fold contains no positive samples, \"\n",
    "                \"so scale_pos_weight cannot be calculated.\"\n",
    "            )\n",
    "\n",
    "        scale_pos_weight = (\n",
    "            negative_samples\n",
    "            / positive_samples\n",
    "        )\n",
    "\n",
    "        model = make_xgb_classifier(\n",
    "            params=candidate_params,\n",
    "            scale_pos_weight=scale_pos_weight,\n",
    "            seed=XGB_MODEL_RANDOM_SEED,\n",
    "        )\n",
    "\n",
    "        model.fit(\n",
    "            X_train,\n",
    "            y_train,\n",
    "        )\n",
    "\n",
    "        y_pred = model.predict(\n",
    "            X_validation\n",
    "        )\n",
    "\n",
    "        weighted_f1 = f1_score(\n",
    "            y_validation,\n",
    "            y_pred,\n",
    "            average=\"weighted\",\n",
    "        )\n",
    "\n",
    "        fold_weighted_f1.append(\n",
    "            float(weighted_f1)\n",
    "        )\n",
    "\n",
    "    return float(\n",
    "        np.mean(fold_weighted_f1)\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Validate existing optimization cache\n",
    "# ------------------------------------------------------------\n",
    "expected_optuna_metadata = (\n",
    "    build_xgb_optuna_metadata()\n",
    ")\n",
    "\n",
    "required_optuna_cache_files = [\n",
    "    optuna_trials_path,\n",
    "    best_params_path,\n",
    "    optuna_metadata_path,\n",
    "]\n",
    "\n",
    "all_optuna_cache_files_exist = all(\n",
    "    os.path.exists(path)\n",
    "    for path in required_optuna_cache_files\n",
    ")\n",
    "\n",
    "optuna_cache_is_valid = False\n",
    "\n",
    "optuna_cache_validation_message = (\n",
    "    \"Required Optuna cache files are missing.\"\n",
    ")\n",
    "\n",
    "if all_optuna_cache_files_exist:\n",
    "    (\n",
    "        optuna_cache_is_valid,\n",
    "        optuna_cache_validation_message,\n",
    "    ) = optuna_cache_matches_configuration(\n",
    "        optuna_metadata_path,\n",
    "        expected_optuna_metadata,\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Resource check\n",
    "# ------------------------------------------------------------\n",
    "print(\"====================================================\")\n",
    "print(\" XGBOOST HYPERPARAMETER RESOURCE CHECK\")\n",
    "print(\"====================================================\")\n",
    "print(\n",
    "    f\"CV scheme: {XGB_OPTUNA_CV_SCHEME}\"\n",
    ")\n",
    "print(\n",
    "    f\"Cross-validation folds: {XGB_OPTUNA_N_SPLITS}\"\n",
    ")\n",
    "print(\n",
    "    f\"New trials per run: {XGB_OPTUNA_TRIALS_PER_RUN}\"\n",
    ")\n",
    "print(\n",
    "    f\"Model random seed: {XGB_MODEL_RANDOM_SEED}\"\n",
    ")\n",
    "print(\n",
    "    \"Complete cache exists: \"\n",
    "    f\"{all_optuna_cache_files_exist}\"\n",
    ")\n",
    "print(\n",
    "    f\"Compatible cache: {optuna_cache_is_valid}\"\n",
    ")\n",
    "print(\n",
    "    f\"Running in Colab: {IN_COLAB}\"\n",
    ")\n",
    "print(\"====================================================\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Decide whether to load or extend the optimization\n",
    "# ------------------------------------------------------------\n",
    "use_cached_optuna_results = False\n",
    "run_optuna_study = False\n",
    "\n",
    "if (\n",
    "    all_optuna_cache_files_exist\n",
    "    and optuna_cache_is_valid\n",
    "):\n",
    "\n",
    "    print(\n",
    "        optuna_cache_validation_message\n",
    "    )\n",
    "\n",
    "    cached_optuna_metadata = load_json_file(\n",
    "        optuna_metadata_path\n",
    "    )\n",
    "\n",
    "    if \"execution_timestamp\" in cached_optuna_metadata:\n",
    "        print(\n",
    "            \"Last optimization:\",\n",
    "            cached_optuna_metadata[\n",
    "                \"execution_timestamp\"\n",
    "            ],\n",
    "        )\n",
    "\n",
    "    if \"total_trials\" in cached_optuna_metadata:\n",
    "        print(\n",
    "            \"Accumulated trials:\",\n",
    "            cached_optuna_metadata[\n",
    "                \"total_trials\"\n",
    "            ],\n",
    "        )\n",
    "\n",
    "    if IN_COLAB:\n",
    "        print(\n",
    "            \"Colab environment detected. \"\n",
    "            \"Using cached Optuna results automatically.\"\n",
    "        )\n",
    "\n",
    "        use_cached_optuna_results = True\n",
    "\n",
    "    else:\n",
    "        user_input = input(\n",
    "            \"Compatible Optuna results detected. \"\n",
    "            f\"Run {XGB_OPTUNA_TRIALS_PER_RUN} additional \"\n",
    "            \"trials? (y/n): \"\n",
    "        ).strip().lower()\n",
    "\n",
    "        if user_input == \"y\":\n",
    "            run_optuna_study = True\n",
    "\n",
    "            print(\n",
    "                \"A new Optuna trial batch will be added \"\n",
    "                \"to the compatible optimization history.\"\n",
    "            )\n",
    "\n",
    "        else:\n",
    "            use_cached_optuna_results = True\n",
    "\n",
    "            print(\n",
    "                \"Using the best cached Optuna result.\"\n",
    "            )\n",
    "\n",
    "else:\n",
    "    if all_optuna_cache_files_exist:\n",
    "        print(\"====================================================\")\n",
    "        print(\" INCOMPATIBLE OPTUNA CACHE\")\n",
    "        print(\"====================================================\")\n",
    "        print(\n",
    "            optuna_cache_validation_message\n",
    "        )\n",
    "\n",
    "    if IN_COLAB:\n",
    "        raise FileNotFoundError(\n",
    "            \"A complete Optuna cache matching the current \"\n",
    "            \"data and configuration was not found in Colab.\\n\"\n",
    "            f\"Expected trials file: {optuna_trials_path}\\n\"\n",
    "            f\"Expected parameters file: {best_params_path}\\n\"\n",
    "            f\"Expected metadata file: {optuna_metadata_path}\\n\"\n",
    "            \"Run the optimization locally and make the generated \"\n",
    "            \"cache files available to the Colab environment.\"\n",
    "        )\n",
    "\n",
    "    print(\n",
    "        \"No compatible Optuna cache was found. \"\n",
    "        \"A new optimization history will be created.\"\n",
    "    )\n",
    "\n",
    "    run_optuna_study = True\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Load cached optimization\n",
    "# ------------------------------------------------------------\n",
    "if use_cached_optuna_results:\n",
    "\n",
    "    df_optuna_trials_xgb_hc = pd.read_csv(\n",
    "        optuna_trials_path\n",
    "    )\n",
    "\n",
    "    (\n",
    "        best_xgb_params_hc,\n",
    "        best_xgb_score_hc,\n",
    "        best_xgb_source_run,\n",
    "    ) = load_cached_best_xgb_params()\n",
    "\n",
    "    cached_optuna_metadata = load_json_file(\n",
    "        optuna_metadata_path\n",
    "    )\n",
    "\n",
    "    xgb_optuna_study_runs = int(\n",
    "        cached_optuna_metadata.get(\n",
    "            \"study_runs\",\n",
    "            1,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    xgb_optuna_results_source = \"cache\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Run a new batch of Optuna trials\n",
    "# ------------------------------------------------------------\n",
    "elif run_optuna_study:\n",
    "\n",
    "    try:\n",
    "        import optuna\n",
    "    except ImportError as exc:\n",
    "        raise ImportError(\n",
    "            \"Optuna is required to run the XGBoost \"\n",
    "            \"hyperparameter search.\"\n",
    "        ) from exc\n",
    "\n",
    "    optuna.logging.set_verbosity(\n",
    "        optuna.logging.WARNING\n",
    "    )\n",
    "\n",
    "    logging.getLogger(\n",
    "        \"xgboost\"\n",
    "    ).setLevel(\n",
    "        logging.WARNING\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Load previous compatible history, when available\n",
    "    # --------------------------------------------------------\n",
    "    if (\n",
    "        all_optuna_cache_files_exist\n",
    "        and optuna_cache_is_valid\n",
    "    ):\n",
    "        historical_trials = pd.read_csv(\n",
    "            optuna_trials_path\n",
    "        )\n",
    "\n",
    "        (\n",
    "            historical_best_params,\n",
    "            historical_best_score,\n",
    "            historical_best_source_run,\n",
    "        ) = load_cached_best_xgb_params()\n",
    "\n",
    "        historical_metadata = load_json_file(\n",
    "            optuna_metadata_path\n",
    "        )\n",
    "\n",
    "        previous_study_runs = int(\n",
    "            historical_metadata.get(\n",
    "                \"study_runs\",\n",
    "                1,\n",
    "            )\n",
    "        )\n",
    "\n",
    "    else:\n",
    "        historical_trials = pd.DataFrame()\n",
    "\n",
    "        historical_best_params = None\n",
    "        historical_best_score = None\n",
    "        historical_best_source_run = None\n",
    "\n",
    "        previous_study_runs = 0\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Configure this new search batch\n",
    "    # --------------------------------------------------------\n",
    "    current_run_id = (\n",
    "        previous_study_runs + 1\n",
    "    )\n",
    "\n",
    "    current_sampler_seed = (\n",
    "        XGB_OPTUNA_BASE_SEED\n",
    "        + current_run_id\n",
    "        - 1\n",
    "    )\n",
    "\n",
    "    sampler = optuna.samplers.TPESampler(\n",
    "        seed=current_sampler_seed\n",
    "    )\n",
    "\n",
    "    study_xgb_hc = optuna.create_study(\n",
    "        direction=\"maximize\",\n",
    "        study_name=(\n",
    "            \"stressid_xgb_handcrafted_optuna_\"\n",
    "            f\"{cv_suffix}_run_{current_run_id}\"\n",
    "        ),\n",
    "        sampler=sampler,\n",
    "    )\n",
    "\n",
    "    study_xgb_hc.optimize(\n",
    "        objective_xgb_handcrafted,\n",
    "        n_trials=XGB_OPTUNA_TRIALS_PER_RUN,\n",
    "        show_progress_bar=True,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Current run results\n",
    "    # --------------------------------------------------------\n",
    "    current_run_best_params = (\n",
    "        normalize_xgb_params(\n",
    "            study_xgb_hc.best_params\n",
    "        )\n",
    "    )\n",
    "\n",
    "    current_run_best_score = float(\n",
    "        study_xgb_hc.best_value\n",
    "    )\n",
    "\n",
    "    current_trials = (\n",
    "        study_xgb_hc\n",
    "        .trials_dataframe()\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    current_trials.insert(\n",
    "        0,\n",
    "        \"run_id\",\n",
    "        current_run_id,\n",
    "    )\n",
    "\n",
    "    current_trials.insert(\n",
    "        1,\n",
    "        \"sampler_seed\",\n",
    "        current_sampler_seed,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Preserve cumulative compatible trial history\n",
    "    # --------------------------------------------------------\n",
    "    if historical_trials.empty:\n",
    "        df_optuna_trials_xgb_hc = (\n",
    "            current_trials\n",
    "            .copy()\n",
    "        )\n",
    "\n",
    "    else:\n",
    "        df_optuna_trials_xgb_hc = (\n",
    "            pd.concat(\n",
    "                [\n",
    "                    historical_trials,\n",
    "                    current_trials,\n",
    "                ],\n",
    "                ignore_index=True,\n",
    "                sort=False,\n",
    "            )\n",
    "        )\n",
    "\n",
    "    df_optuna_trials_xgb_hc = (\n",
