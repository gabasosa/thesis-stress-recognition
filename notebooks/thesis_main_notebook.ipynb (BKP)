    "\n",
    "        W2Vmodel = loaded_models\n",
    "        active_model = W2Vmodel[0]\n",
    "\n",
    "        required_model_attributes = [\n",
    "            \"feature_extractor\",\n",
    "            \"feature_aggregator\",\n",
