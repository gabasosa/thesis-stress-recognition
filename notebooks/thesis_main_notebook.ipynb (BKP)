    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Build numerical result table\n",
    "# ------------------------------------------------------------\n",
    "result_rows = []\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Handcrafted baselines\n",
    "# ------------------------------------------------------------\n",
    "for classifier in classifier_order:\n",
    "    if classifier not in grouped_summary.index:\n",
    "        continue\n",
    "\n",
    "    row = grouped_summary.loc[\n",
    "        classifier\n",
    "    ]\n",
    "\n",
    "    result_rows.append(\n",
    "        {\n",
    "            \"result_source\": \"Local\",\n",
    "            \"feature_representation\": \"Handcrafted\",\n",
    "            \"model\": classifier_display_names[\n",
    "                classifier\n",
    "            ],\n",
    "            \"weighted_f1_mean\": float(\n",
    "                row[\"weighted_f1_mean\"]\n",
    "            ),\n",
    "            \"weighted_f1_std\": float(\n",
    "                row[\"weighted_f1_std\"]\n",
    "            ),\n",
    "            \"balanced_accuracy_mean\": float(\n",
    "                row[\"balanced_accuracy_mean\"]\n",
    "            ),\n",
    "            \"balanced_accuracy_std\": float(\n",
    "                row[\"balanced_accuracy_std\"]\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Tuned XGBoost on handcrafted features\n",
    "# ------------------------------------------------------------\n",
    "if (\n",
    "    \"subject-independent\"\n",
    "    not in xgb_eval_summary.index\n",
    "):\n",
    "    raise RuntimeError(\n",
    "        \"The subject-independent tuned-XGBoost result \"\n",
    "        \"was not found in xgb_eval_summary.\"\n",
    "    )\n",
    "\n",
    "xgb_grouped_row = xgb_eval_summary.loc[\n",
    "    \"subject-independent\"\n",
    "]\n",
    "\n",
    "result_rows.append(\n",
    "    {\n",
    "        \"result_source\": \"Local\",\n",
    "        \"feature_representation\": \"Handcrafted\",\n",
    "        \"model\": \"XGBoost (Optuna-tuned)\",\n",
    "        \"weighted_f1_mean\": float(\n",
    "            xgb_grouped_row[\n",
    "                \"weighted_f1_mean\"\n",
    "            ]\n",
    "        ),\n",
    "        \"weighted_f1_std\": float(\n",
    "            xgb_grouped_row[\n",
    "                \"weighted_f1_std\"\n",
    "            ]\n",
    "        ),\n",
    "        \"balanced_accuracy_mean\": float(\n",
    "            xgb_grouped_row[\n",
    "                \"balanced_accuracy_mean\"\n",
    "            ]\n",
    "        ),\n",
    "        \"balanced_accuracy_std\": float(\n",
    "            xgb_grouped_row[\n",
    "                \"balanced_accuracy_std\"\n",
    "            ]\n",
    "        ),\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Wav2Vec baselines\n",
    "# ------------------------------------------------------------\n",
    "for classifier in classifier_order:\n",
    "    if classifier not in w2v_grouped_summary.index:\n",
    "        continue\n",
    "\n",
    "    row = w2v_grouped_summary.loc[\n",
    "        classifier\n",
    "    ]\n",
    "\n",
    "    result_rows.append(\n",
    "        {\n",
    "            \"result_source\": \"Local\",\n",
    "            \"feature_representation\": \"Wav2Vec mean/std\",\n",
    "            \"model\": classifier_display_names[\n",
    "                classifier\n",
    "            ],\n",
    "            \"weighted_f1_mean\": float(\n",
    "                row[\"weighted_f1_mean\"]\n",
    "            ),\n",
    "            \"weighted_f1_std\": float(\n",
    "                row[\"weighted_f1_std\"]\n",
    "            ),\n",
    "            \"balanced_accuracy_mean\": float(\n",
    "                row[\"balanced_accuracy_mean\"]\n",
    "            ),\n",
    "            \"balanced_accuracy_std\": float(\n",
    "                row[\"balanced_accuracy_std\"]\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "df_results_subject_independent = pd.DataFrame(\n",
    "    result_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Formatting helper\n",
    "# ------------------------------------------------------------\n",
    "def format_mean_std(\n",
    "    mean_value,\n",
    "    std_value,\n",
    "):\n",
    "    \"\"\"Format a metric as mean ± sample standard deviation.\"\"\"\n",
    "    if pd.isna(mean_value):\n",
    "        return \"N/A\"\n",
    "\n",
    "    if pd.isna(std_value):\n",
    "        return f\"{mean_value:.3f}\"\n",
    "\n",
    "    return (\n",
    "        f\"{mean_value:.3f} \"\n",
    "        f\"± {std_value:.3f}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Construct reader-facing table\n",
    "# ------------------------------------------------------------\n",
    "subject_independent_table = pd.DataFrame(\n",
    "    {\n",
    "        \"Feature representation\": (\n",
    "            df_results_subject_independent[\n",
    "                \"feature_representation\"\n",
    "            ]\n",
    "        ),\n",
    "        \"Model\": (\n",
    "            df_results_subject_independent[\n",
    "                \"model\"\n",
    "            ]\n",
    "        ),\n",
    "        \"Weighted F1\": [\n",
    "            format_mean_std(\n",
    "                mean_value,\n",
    "                std_value,\n",
    "            )\n",
    "            for mean_value, std_value\n",
    "            in zip(\n",
    "                df_results_subject_independent[\n",
    "                    \"weighted_f1_mean\"\n",
    "                ],\n",
    "                df_results_subject_independent[\n",
    "                    \"weighted_f1_std\"\n",
    "                ],\n",
    "            )\n",
    "        ],\n",
    "        \"Balanced accuracy\": [\n",
    "            format_mean_std(\n",
    "                mean_value,\n",
    "                std_value,\n",
    "            )\n",
    "            for mean_value, std_value\n",
    "            in zip(\n",
    "                df_results_subject_independent[\n",
    "                    \"balanced_accuracy_mean\"\n",
    "                ],\n",
    "                df_results_subject_independent[\n",
    "                    \"balanced_accuracy_std\"\n",
    "                ],\n",
    "            )\n",
    "        ],\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Identify best local results\n",
    "# ------------------------------------------------------------\n",
    "best_f1_index = (\n",
    "    df_results_subject_independent[\n",
    "        \"weighted_f1_mean\"\n",
    "    ]\n",
    "    .idxmax()\n",
    ")\n",
    "\n",
    "best_bacc_index = (\n",
    "    df_results_subject_independent[\n",
    "        \"balanced_accuracy_mean\"\n",
    "    ]\n",
    "    .idxmax()\n",
    ")\n",
    "\n",
    "\n",
    "def highlight_best_results(\n",
    "    data,\n",
    "):\n",
    "    \"\"\"Bold the best subject-independent result for each metric.\"\"\"\n",
    "    styles = pd.DataFrame(\n",
    "        \"\",\n",
    "        index=data.index,\n",
    "        columns=data.columns,\n",
    "    )\n",
    "\n",
    "    styles.loc[\n",
    "        best_f1_index,\n",
    "        \"Weighted F1\",\n",
    "    ] = \"font-weight: bold;\"\n",
    "\n",
    "    styles.loc[\n",
    "        best_bacc_index,\n",
    "        \"Balanced accuracy\",\n",
    "    ] = \"font-weight: bold;\"\n",
    "\n",
    "    return styles\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Style table\n",
    "# ------------------------------------------------------------\n",
    "styled_subject_independent_results = (\n",
    "    subject_independent_table.style\n",
    "    .apply(\n",
    "        highlight_best_results,\n",
    "        axis=None,\n",
    "    )\n",
