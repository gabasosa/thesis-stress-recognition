    "\n",
    "    grouped_metadata_to_save = dict(\n",
    "        expected_grouped_metadata\n",
    "    )\n",
    "\n",
    "    grouped_metadata_to_save[\n",
    "        \"execution_timestamp\"\n",
    "    ] = datetime.now().strftime(\n",
    "        \"%Y-%m-%d %H:%M:%S\"\n",
    "    )\n",
    "\n",
    "    grouped_metadata_to_save[\n",
    "        \"result_rows\"\n",
    "    ] = int(len(grouped_results))\n",
    "\n",
    "    grouped_metadata_to_save[\n",
    "        \"prediction_rows\"\n",
    "    ] = int(len(grouped_predictions))\n",
    "\n",
    "    grouped_metadata_to_save[\n",
    "        \"confusion_rows\"\n",
    "    ] = int(len(grouped_confusions))\n",
    "\n",
    "    with open(\n",
    "        GROUPED_META_FILE,\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\"\n",
    "    ) as file:\n",
    "        json.dump(\n",
    "            grouped_metadata_to_save,\n",
    "            file,\n",
    "            indent=2,\n",
    "            ensure_ascii=False\n",
    "        )\n",
    "\n",
    "    grouped_results_source = \"fresh execution\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reader-facing subject-independent results table\n",
    "# ------------------------------------------------------------\n",
    "from IPython.display import display\n",
    "\n",
    "\n",
    "# Reader-facing model names following the authors' table style.\n",
    "classifier_display_names = {\n",
    "    \"RandomForestClassifier\": \"Audio HC features + RF\",\n",
    "    \"KNeighborsClassifier (k=3)\": \"Audio HC features + kNN (k=3)\",\n",
    "    \"SVC\": \"Audio HC features + SVM\",\n",
    "    \"MLPClassifier\": \"Audio HC features + MLP\",\n",
    "}\n",
    "\n",
    "preferred_classifier_order = [\n",
    "    \"RandomForestClassifier\",\n",
    "    \"KNeighborsClassifier (k=3)\",\n",
    "    \"SVC\",\n",
    "    \"MLPClassifier\",\n",
    "]\n",
    "\n",
    "available_classifier_order = [\n",
    "    classifier\n",
    "    for classifier in preferred_classifier_order\n",
    "    if classifier in grouped_summary.index\n",
    "]\n",
    "\n",
    "remaining_classifiers = [\n",
    "    classifier\n",
    "    for classifier in grouped_summary.index\n",
    "    if classifier not in available_classifier_order\n",
    "]\n",
    "\n",
    "classifier_order = (\n",
    "    available_classifier_order\n",
    "    + remaining_classifiers\n",
    ")\n",
    "\n",
    "grouped_summary_for_display = grouped_summary.loc[\n",
    "    classifier_order\n",
    "].copy()\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Formatting helper\n",
    "# ------------------------------------------------------------\n",
    "def format_mean_std(mean_value, std_value):\n",
    "    \"\"\"Format a metric as mean ± sample standard deviation.\"\"\"\n",
    "    if pd.isna(mean_value) or pd.isna(std_value):\n",
    "        return \"N/A\"\n",
    "\n",
    "    return f\"{mean_value:.3f} ± {std_value:.3f}\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Construct authors-style table\n",
    "# ------------------------------------------------------------\n",
    "display_columns = pd.MultiIndex.from_tuples(\n",
    "    [\n",
    "        (\"Subject-independent\", \"Weighted F1\"),\n",
    "        (\"Subject-independent\", \"Balanced accuracy\"),\n",
    "    ]\n",
    ")\n",
    "\n",
    "display_index = [\n",
    "    classifier_display_names.get(\n",
    "        classifier,\n",
    "        classifier,\n",
    "    )\n",
    "    for classifier in grouped_summary_for_display.index\n",
    "]\n",
    "\n",
    "grouped_results_table = pd.DataFrame(\n",
    "    index=display_index,\n",
    "    columns=display_columns,\n",
    "    dtype=object,\n",
    ")\n",
    "\n",
    "grouped_results_table.index.name = \"Baseline\"\n",
    "\n",
    "for classifier, row in grouped_summary_for_display.iterrows():\n",
