    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Save embedding cache\n",
    "    # --------------------------------------------------------\n",
    "    df_w2v.to_parquet(\n",
    "        W2V_FEATURE_CACHE,\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Save extraction metadata\n",
    "    # --------------------------------------------------------\n",
    "    metadata_to_save = dict(\n",
    "        expected_w2v_metadata\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\n",
    "        \"extraction_timestamp\"\n",
    "    ] = datetime.now().strftime(\n",
    "        \"%Y-%m-%d %H:%M:%S\"\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\n",
    "        \"successful_extractions\"\n",
    "    ] = int(\n",
    "        n_successful\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\n",
    "        \"failed_extractions\"\n",
    "    ] = int(\n",
    "        n_failed\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\n",
    "        \"embedding_dimension\"\n",
    "    ] = int(\n",
    "        X_w2v.shape[1]\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\n",
    "        \"positive_class_ratio\"\n",
    "    ] = float(\n",
    "        np.mean(\n",
    "            y_w2v\n",
    "        )\n",
    "    )\n",
    "\n",
    "    metadata_to_save[\n",
    "        \"failed_files\"\n",
    "    ] = failed_files\n",
    "\n",
    "    with open(\n",
    "        W2V_META_FILE,\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\",\n",
    "    ) as file:\n",
    "        json.dump(\n",
    "            normalize_w2v_metadata(\n",
    "                metadata_to_save\n",
    "            ),\n",
    "            file,\n",
    "            indent=2,\n",
    "            ensure_ascii=False,\n",
    "        )\n",
    "\n",
    "    w2v_embedding_source = (\n",
    "        \"fresh extraction\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Final validation\n",
    "# ------------------------------------------------------------\n",
    "if not (\n",
