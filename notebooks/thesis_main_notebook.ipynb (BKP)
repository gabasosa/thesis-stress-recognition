    "# ============================================================\n",
    "# 2.3.2. Subject-Independent Evaluation\n",
    "# ============================================================\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "import os\n",
    "import time\n",
    "from datetime import datetime\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from sklearn.base import clone\n",
    "from sklearn.model_selection import GroupKFold\n",
    "from sklearn.metrics import (\n",
    "    balanced_accuracy_score,\n",
    "    confusion_matrix,\n",
    "    f1_score\n",
    ")\n",
    "\n",
    "from imblearn.over_sampling import SMOTE\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Subject-independent protocol configuration\n",
    "# ------------------------------------------------------------\n",
    "GROUPED_N_SPLITS = 5\n",
    "\n",
    "# None retains the stochastic SMOTE behavior used in the released\n",
    "# StressID implementation. Set this to SEED for repeatable runs.\n",
    "GROUPED_RANDOM_SEED = STRESSID_RANDOM_SEED\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Cache paths\n",
    "# ------------------------------------------------------------\n",
    "GROUPED_RESULTS_CACHE = os.path.join(\n",
    "    CACHE_DIR,\n",
    "    \"stressid_subject_independent_results.parquet\"\n",
    ")\n",
    "\n",
    "GROUPED_PREDICTIONS_CACHE = os.path.join(\n",
    "    CACHE_DIR,\n",
    "    \"stressid_subject_independent_predictions.parquet\"\n",
    ")\n",
    "\n",
    "GROUPED_CONFUSIONS_CACHE = os.path.join(\n",
    "    CACHE_DIR,\n",
    "    \"stressid_subject_independent_confusions.parquet\"\n",
    ")\n",
    "\n",
    "GROUPED_META_FILE = os.path.join(\n",
    "    CACHE_DIR,\n",
    "    \"stressid_subject_independent_meta.json\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Validate required variables and definitions\n",
    "# ------------------------------------------------------------\n",
    "required_variables = [\n",
    "    \"X_audio\",\n",
    "    \"y_audio\",\n",
    "    \"groups_audio\",\n",
    "    \"STRESSID_CLASSIFIERS\"\n",
    "]\n",
    "\n",
    "missing_variables = [\n",
    "    name\n",
    "    for name in required_variables\n",
    "    if name not in globals()\n",
    "]\n",
    "\n",
    "if missing_variables:\n",
    "    raise RuntimeError(\n",
    "        \"The following required variables are missing: \"\n",
    "        f\"{missing_variables}. Run Sections 2.2 and 2.3.1 first.\"\n",
    "    )\n",
    "\n",
    "if \"build_stressid_pipeline\" not in globals():\n",
    "    raise RuntimeError(\n",
    "        \"build_stressid_pipeline was not found. \"\n",
    "        \"Run Section 2.3.1 first.\"\n",
    "    )\n",
    "\n",
    "if \"classifier_configuration\" not in globals():\n",
    "    raise RuntimeError(\n",
    "        \"classifier_configuration was not found. \"\n",
    "        \"Run Section 2.3.1 first.\"\n",
    "    )\n",
    "\n",
    "if \"normalize_for_json\" not in globals():\n",
    "    raise RuntimeError(\n",
    "        \"normalize_for_json was not found. \"\n",
    "        \"Run Section 2.3.1 first.\"\n",
    "    )\n",
    "\n",
    "X_audio = np.asarray(X_audio, dtype=np.float32)\n",
    "y_audio = np.asarray(y_audio, dtype=np.int64)\n",
    "groups_audio = np.asarray(groups_audio, dtype=object)\n",
    "\n",
    "if X_audio.ndim != 2:\n",
    "    raise ValueError(\n",
    "        f\"X_audio must be two-dimensional; received {X_audio.shape}.\"\n",
    "    )\n",
    "\n",
    "if y_audio.ndim != 1:\n",
    "    raise ValueError(\n",
    "        f\"y_audio must be one-dimensional; received {y_audio.shape}.\"\n",
    "    )\n",
    "\n",
    "if groups_audio.ndim != 1:\n",
    "    raise ValueError(\n",
    "        \"groups_audio must be one-dimensional; \"\n",
    "        f\"received {groups_audio.shape}.\"\n",
    "    )\n",
    "\n",
    "if not (\n",
    "    X_audio.shape[0]\n",
    "    == y_audio.shape[0]\n",
    "    == groups_audio.shape[0]\n",
    "):\n",
    "    raise ValueError(\n",
    "        \"X_audio, y_audio, and groups_audio must contain the \"\n",
    "        \"same number of samples.\"\n",
    "    )\n",
    "\n",
    "if len(np.unique(y_audio)) != 2:\n",
    "    raise ValueError(\n",
    "        \"The subject-independent experiment expects exactly two classes.\"\n",
    "    )\n",
    "\n",
    "n_subjects = len(np.unique(groups_audio))\n",
    "\n",
    "if GROUPED_N_SPLITS > n_subjects:\n",
    "    raise ValueError(\n",
    "        f\"GROUPED_N_SPLITS={GROUPED_N_SPLITS} exceeds the \"\n",
    "        f\"number of subjects ({n_subjects}).\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Cache metadata helpers\n",
    "# ------------------------------------------------------------\n",
    "def grouped_data_fingerprint(X, y, groups):\n",
    "    \"\"\"\n",
    "    Create a fingerprint that includes features, labels, and subject IDs.\n",
    "    \"\"\"\n",
    "    hasher = hashlib.sha256()\n",
    "\n",
    "    X_contiguous = np.ascontiguousarray(X)\n",
    "    y_contiguous = np.ascontiguousarray(y)\n",
    "\n",
    "    hasher.update(str(X_contiguous.shape).encode(\"utf-8\"))\n",
    "    hasher.update(str(X_contiguous.dtype).encode(\"utf-8\"))\n",
    "    hasher.update(X_contiguous.tobytes())\n",
    "\n",
    "    hasher.update(str(y_contiguous.shape).encode(\"utf-8\"))\n",
    "    hasher.update(str(y_contiguous.dtype).encode(\"utf-8\"))\n",
    "    hasher.update(y_contiguous.tobytes())\n",
    "\n",
    "    group_strings = np.asarray(groups, dtype=str)\n",
    "\n",
    "    for group in group_strings:\n",
    "        hasher.update(group.encode(\"utf-8\"))\n",
    "        hasher.update(b\"\\0\")\n",
    "\n",
    "    return hasher.hexdigest()\n",
    "\n",
    "\n",
    "def build_grouped_protocol_metadata(X, y, groups):\n",
    "    \"\"\"\n",
    "    Describe the data and configuration used by the grouped experiment.\n",
    "    \"\"\"\n",
    "    metadata = {\n",
    "        \"protocol\": \"stressid_subject_independent_groupkfold\",\n",
    "        \"n_splits\": int(GROUPED_N_SPLITS),\n",
    "        \"random_seed\": GROUPED_RANDOM_SEED,\n",
    "        \"n_samples\": int(X.shape[0]),\n",
    "        \"feature_dimension\": int(X.shape[1]),\n",
    "        \"n_subjects\": int(len(np.unique(groups))),\n",
    "        \"positive_class_ratio\": float(np.mean(y)),\n",
    "        \"data_fingerprint\": grouped_data_fingerprint(\n",
    "            X,\n",
    "            y,\n",
    "            groups\n",
    "        ),\n",
    "        \"classifiers\": classifier_configuration(\n",
    "            STRESSID_CLASSIFIERS\n",
    "        )\n",
    "    }\n",
    "\n",
    "    return normalize_for_json(metadata)\n",
    "\n",
    "\n",
    "def grouped_cache_matches_protocol(meta_path, expected_metadata):\n",
    "    \"\"\"\n",
    "    Check whether the grouped cache matches the current experiment.\n",
    "    \"\"\"\n",
    "    if not os.path.exists(meta_path):\n",
    "        return False, \"Metadata file is missing.\"\n",
    "\n",
    "    try:\n",
    "        with open(meta_path, \"r\", encoding=\"utf-8\") as file:\n",
    "            cached_metadata = json.load(file)\n",
    "    except Exception as exc:\n",
    "        return False, f\"Metadata could not be read: {exc}\"\n",
    "\n",
    "    fields_to_compare = [\n",
    "        \"protocol\",\n",
    "        \"n_splits\",\n",
    "        \"random_seed\",\n",
    "        \"n_samples\",\n",
    "        \"feature_dimension\",\n",
    "        \"n_subjects\",\n",
    "        \"data_fingerprint\",\n",
    "        \"classifiers\"\n",
    "    ]\n",
    "\n",
    "    mismatched_fields = [\n",
    "        field\n",
    "        for field in fields_to_compare\n",
    "        if cached_metadata.get(field) != expected_metadata.get(field)\n",
    "    ]\n",
    "\n",
    "    if mismatched_fields:\n",
    "        return (\n",
    "            False,\n",
    "            \"Cached configuration differs in: \"\n",
    "            + \", \".join(mismatched_fields)\n",
    "        )\n",
    "\n",
    "    return True, \"Cache matches the current data and protocol.\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Subject-independent evaluation\n",
    "# ------------------------------------------------------------\n",
    "def run_subject_independent_stressid_baseline(\n",
    "    X,\n",
    "    y,\n",
    "    groups,\n",
    "    classifiers=None,\n",
    "    n_splits=GROUPED_N_SPLITS,\n",
    "    random_seed=GROUPED_RANDOM_SEED,\n",
    "    verbose=True\n",
    "):\n",
    "    \"\"\"\n",
    "    Evaluate the official StressID classifiers with subject-independent\n",
    "    GroupKFold cross-validation.\n",
    "\n",
    "    The classifiers, imputation, standardization, SMOTE treatment, and\n",
    "    metrics are retained from Section 2.3.1. The partitioning strategy\n",
    "    is replaced with GroupKFold based on subject identity.\n",
    "    \"\"\"\n",
    "    X = np.asarray(X, dtype=np.float32)\n",
    "    y = np.asarray(y, dtype=np.int64)\n",
    "    groups = np.asarray(groups, dtype=object)\n",
    "\n",
    "    if classifiers is None:\n",
    "        classifiers = STRESSID_CLASSIFIERS\n",
    "\n",
    "    cv = GroupKFold(n_splits=n_splits)\n",
    "\n",
    "    rng = (\n",
    "        None\n",
    "        if random_seed is None\n",
    "        else np.random.default_rng(random_seed)\n",
    "    )\n",
    "\n",
    "    result_rows = []\n",
    "    confusion_rows = []\n",
    "    prediction_rows = []\n",
    "\n",
    "    split_iterator = cv.split(\n",
    "        X,\n",
    "        y,\n",
    "        groups=groups\n",
    "    )\n",
    "\n",
    "    for fold, (train_indices, test_indices) in enumerate(\n",
    "        split_iterator\n",
    "    ):\n",
    "        X_train = X[train_indices]\n",
    "        X_test = X[test_indices]\n",
    "\n",
    "        y_train = y[train_indices]\n",
    "        y_test = y[test_indices]\n",
    "\n",
    "        groups_train = groups[train_indices]\n",
    "        groups_test = groups[test_indices]\n",
    "\n",
    "        shared_subjects = np.intersect1d(\n",
    "            np.unique(groups_train),\n",
    "            np.unique(groups_test)\n",
    "        )\n",
    "\n",
    "        if shared_subjects.size != 0:\n",
    "            raise RuntimeError(\n",
    "                \"Subject leakage detected in fold \"\n",
    "                f\"{fold + 1}: {shared_subjects.tolist()}\"\n",
    "            )\n",
    "\n",
    "        if len(np.unique(y_train)) != 2:\n",
    "            raise ValueError(\n",
    "                f\"Training fold {fold + 1} does not contain both classes.\"\n",
    "            )\n",
    "\n",
    "        if rng is None:\n",
    "            smote_seed = None\n",
    "        else:\n",
    "            smote_seed = int(\n",
    "                rng.integers(\n",
    "                    0,\n",
    "                    np.iinfo(np.int32).max\n",
    "                )\n",
    "            )\n",
    "\n",
    "        # SMOTE is applied only after the grouped split and only\n",
    "        # to the training partition.\n",
    "        smote = SMOTE(\n",
    "            random_state=smote_seed\n",
    "        )\n",
    "\n",
    "        X_train_resampled, y_train_resampled = (\n",
    "            smote.fit_resample(\n",
    "                X_train,\n",
    "                y_train\n",
    "            )\n",
    "        )\n",
    "\n",
    "        train_subjects = np.unique(groups_train)\n",
    "        test_subjects = np.unique(groups_test)\n",
    "\n",
    "        if verbose:\n",
    "            print(\n",
    "                f\"Fold {fold + 1:2d}/{n_splits:2d} | \"\n",
    "                f\"train subjects={len(train_subjects):2d} | \"\n",
    "                f\"test subjects={len(test_subjects):2d} | \"\n",
    "                f\"train samples={len(y_train):3d} | \"\n",
    "                f\"after SMOTE={len(y_train_resampled):3d} | \"\n",
    "                f\"test samples={len(y_test):3d}\"\n",
    "            )\n",
    "\n",
    "        for classifier_name, classifier in classifiers.items():\n",
    "            # This helper comes from Section 2.3.1 and retains\n",
    "            # IterativeImputer -> StandardScaler -> classifier.\n",
    "            pipeline = build_stressid_pipeline(\n",
    "                clone(classifier)\n",
    "            )\n",
    "\n",
    "            start_time = time.perf_counter()\n",
    "\n",
    "            pipeline.fit(\n",
    "                X_train_resampled,\n",
    "                y_train_resampled\n",
    "            )\n",
    "\n",
    "            fit_time = time.perf_counter() - start_time\n",
    "\n",
    "            y_pred = pipeline.predict(\n",
    "                X_test\n",
    "            )\n",
    "\n",
    "            weighted_f1 = f1_score(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                average=\"weighted\"\n",
    "            )\n",
    "\n",
    "            balanced_accuracy = balanced_accuracy_score(\n",
    "                y_test,\n",
    "                y_pred\n",
    "            )\n",
    "\n",
    "            matrix = confusion_matrix(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                labels=[0, 1]\n",
    "            )\n",
    "\n",
    "            tn, fp, fn, tp = matrix.ravel()\n",
    "\n",
    "            result_rows.append({\n",
    "                \"fold\": int(fold),\n",
    "                \"classifier\": classifier_name,\n",
    "                \"weighted_f1\": float(weighted_f1),\n",
    "                \"balanced_accuracy\": float(\n",
    "                    balanced_accuracy\n",
    "                ),\n",
    "                \"fit_time_seconds\": float(fit_time),\n",
    "                \"train_samples\": int(len(y_train)),\n",
    "                \"train_samples_after_smote\": int(\n",
    "                    len(y_train_resampled)\n",
    "                ),\n",
    "                \"test_samples\": int(len(y_test)),\n",
    "                \"train_subjects\": int(\n",
    "                    len(train_subjects)\n",
    "                ),\n",
    "                \"test_subjects\": int(\n",
    "                    len(test_subjects)\n",
    "                ),\n",
    "                \"smote_seed\": smote_seed\n",
    "            })\n",
    "\n",
    "            confusion_rows.append({\n",
    "                \"fold\": int(fold),\n",
    "                \"classifier\": classifier_name,\n",
    "                \"true_negative\": int(tn),\n",
    "                \"false_positive\": int(fp),\n",
    "                \"false_negative\": int(fn),\n",
    "                \"true_positive\": int(tp)\n",
    "            })\n",
    "\n",
    "            for (\n",
    "                sample_index,\n",
    "                subject,\n",
    "                true_label,\n",
    "                predicted_label\n",
    "            ) in zip(\n",
    "                test_indices,\n",
    "                groups_test,\n",
    "                y_test,\n",
    "                y_pred\n",
    "            ):\n",
    "                prediction_rows.append({\n",
    "                    \"fold\": int(fold),\n",
    "                    \"classifier\": classifier_name,\n",
    "                    \"sample_index\": int(sample_index),\n",
    "                    \"subject\": str(subject),\n",
    "                    \"y_true\": int(true_label),\n",
    "                    \"y_pred\": int(predicted_label)\n",
    "                })\n",
    "\n",
    "    grouped_results = pd.DataFrame(\n",
    "        result_rows\n",
    "    )\n",
    "\n",
    "    grouped_confusions = pd.DataFrame(\n",
    "        confusion_rows\n",
    "    )\n",
    "\n",
    "    grouped_predictions = pd.DataFrame(\n",
    "        prediction_rows\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        grouped_results,\n",
    "        grouped_confusions,\n",
    "        grouped_predictions\n",
    "    )\n",
    "\n",
    "\n",
    "def summarize_subject_independent_results(results_df):\n",
    "    \"\"\"\n",
    "    Calculate means and sample standard deviations across grouped folds.\n",
    "    \"\"\"\n",
    "    required_columns = {\n",
    "        \"classifier\",\n",
    "        \"weighted_f1\",\n",
    "        \"balanced_accuracy\",\n",
    "        \"fit_time_seconds\"\n",
    "    }\n",
    "\n",
    "    missing_columns = required_columns.difference(\n",
    "        results_df.columns\n",
    "    )\n",
    "\n",
    "    if missing_columns:\n",
    "        raise ValueError(\n",
    "            f\"Missing result columns: {sorted(missing_columns)}\"\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        results_df\n",
    "        .groupby(\"classifier\", sort=True)\n",
    "        .agg(\n",
    "            weighted_f1_mean=(\n",
    "                \"weighted_f1\",\n",
    "                \"mean\"\n",
    "            ),\n",
    "            weighted_f1_std=(\n",
    "                \"weighted_f1\",\n",
    "                \"std\"\n",
    "            ),\n",
    "            balanced_accuracy_mean=(\n",
    "                \"balanced_accuracy\",\n",
    "                \"mean\"\n",
    "            ),\n",
    "            balanced_accuracy_std=(\n",
    "                \"balanced_accuracy\",\n",
    "                \"std\"\n",
    "            ),\n",
    "            fit_time_mean_seconds=(\n",
    "                \"fit_time_seconds\",\n",
    "                \"mean\"\n",
    "            ),\n",
    "            fit_time_std_seconds=(\n",
    "                \"fit_time_seconds\",\n",
    "                \"std\"\n",
    "            )\n",
    "        )\n",
    "        .sort_values(\n",
    "            \"weighted_f1_mean\",\n",
    "            ascending=False\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Decide whether to use the cache\n",
    "# ------------------------------------------------------------\n",
    "expected_grouped_metadata = (\n",
    "    build_grouped_protocol_metadata(\n",
    "        X_audio,\n",
    "        y_audio,\n",
    "        groups_audio\n",
    "    )\n",
    ")\n",
    "\n",
    "required_grouped_cache_files = [\n",
    "    GROUPED_RESULTS_CACHE,\n",
    "    GROUPED_PREDICTIONS_CACHE,\n",
    "    GROUPED_CONFUSIONS_CACHE,\n",
    "    GROUPED_META_FILE\n",
    "]\n",
    "\n",
    "all_grouped_cache_files_exist = all(\n",
    "    os.path.exists(path)\n",
    "    for path in required_grouped_cache_files\n",
    ")\n",
    "\n",
    "grouped_cache_is_valid = False\n",
    "grouped_cache_validation_message = (\n",
    "    \"Required cache files are missing.\"\n",
    ")\n",
    "\n",
    "if all_grouped_cache_files_exist:\n",
