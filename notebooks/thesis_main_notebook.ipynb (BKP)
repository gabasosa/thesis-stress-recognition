    "\n",
    "comparison_for_display = (\n",
    "    w2v_baseline_comparison.loc[\n",
    "        classifier_order\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Formatting helper\n",
    "# ------------------------------------------------------------\n",
    "def format_mean_std(\n",
    "    mean_value,\n",
    "    std_value,\n",
    "):\n",
    "    if (\n",
    "        pd.isna(\n",
    "            mean_value\n",
    "        )\n",
    "        or pd.isna(\n",
    "            std_value\n",
    "        )\n",
    "    ):\n",
    "        return \"N/A\"\n",
    "\n",
    "    return (\n",
    "        f\"{mean_value:.3f} \"\n",
    "        f\"± {std_value:.3f}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reader-facing table\n",
    "# ------------------------------------------------------------\n",
    "display_columns = pd.MultiIndex.from_tuples(\n",
    "    [\n",
    "        (\n",
    "            \"Recording-level\",\n",
    "            \"Weighted F1\",\n",
    "        ),\n",
    "        (\n",
    "            \"Recording-level\",\n",
    "            \"Balanced accuracy\",\n",
    "        ),\n",
    "        (\n",
    "            \"Subject-independent\",\n",
    "            \"Weighted F1\",\n",
    "        ),\n",
    "        (\n",
    "            \"Subject-independent\",\n",
    "            \"Balanced accuracy\",\n",
    "        ),\n",
    "    ]\n",
    ")\n",
    "\n",
    "display_index = [\n",
    "    classifier_display_names.get(\n",
    "        classifier,\n",
    "        classifier,\n",
    "    )\n",
    "    for classifier\n",
    "    in comparison_for_display.index\n",
    "]\n",
    "\n",
    "w2v_baseline_table = pd.DataFrame(\n",
    "    index=display_index,\n",
    "    columns=display_columns,\n",
    "    dtype=object,\n",
    ")\n",
    "\n",
    "w2v_baseline_table.index.name = (\n",
    "    \"Baseline\"\n",
    ")\n",
    "\n",
    "for classifier, row in (\n",
    "    comparison_for_display.iterrows()\n",
    "):\n",
    "    display_name = (\n",
    "        classifier_display_names.get(\n",
    "            classifier,\n",
    "            classifier,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    w2v_baseline_table.loc[\n",
    "        display_name,\n",
    "        (\n",
    "            \"Recording-level\",\n",
    "            \"Weighted F1\",\n",
    "        ),\n",
    "    ] = format_mean_std(\n",
    "        row[\n",
    "            \"recording_weighted_f1_mean\"\n",
    "        ],\n",
    "        row[\n",
    "            \"recording_weighted_f1_std\"\n",
    "        ],\n",
    "    )\n",
    "\n",
    "    w2v_baseline_table.loc[\n",
    "        display_name,\n",
    "        (\n",
    "            \"Recording-level\",\n",
    "            \"Balanced accuracy\",\n",
    "        ),\n",
    "    ] = format_mean_std(\n",
    "        row[\n",
    "            \"recording_balanced_accuracy_mean\"\n",
    "        ],\n",
    "        row[\n",
    "            \"recording_balanced_accuracy_std\"\n",
    "        ],\n",
    "    )\n",
    "\n",
    "    w2v_baseline_table.loc[\n",
    "        display_name,\n",
    "        (\n",
    "            \"Subject-independent\",\n",
    "            \"Weighted F1\",\n",
    "        ),\n",
    "    ] = format_mean_std(\n",
    "        row[\n",
    "            \"grouped_weighted_f1_mean\"\n",
    "        ],\n",
    "        row[\n",
    "            \"grouped_weighted_f1_std\"\n",
    "        ],\n",
    "    )\n",
    "\n",
    "    w2v_baseline_table.loc[\n",
    "        display_name,\n",
    "        (\n",
    "            \"Subject-independent\",\n",
    "            \"Balanced accuracy\",\n",
    "        ),\n",
    "    ] = format_mean_std(\n",
    "        row[\n",
    "            \"grouped_balanced_accuracy_mean\"\n",
    "        ],\n",
    "        row[\n",
    "            \"grouped_balanced_accuracy_std\"\n",
    "        ],\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Highlight best values\n",
    "# ------------------------------------------------------------\n",
    "best_internal_rows = {\n",
    "    (\n",
    "        \"Recording-level\",\n",
    "        \"Weighted F1\",\n",
    "    ): (\n",
    "        comparison_for_display[\n",
    "            \"recording_weighted_f1_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        \"Recording-level\",\n",
    "        \"Balanced accuracy\",\n",
    "    ): (\n",
    "        comparison_for_display[\n",
    "            \"recording_balanced_accuracy_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        \"Subject-independent\",\n",
    "        \"Weighted F1\",\n",
    "    ): (\n",
    "        comparison_for_display[\n",
    "            \"grouped_weighted_f1_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        \"Subject-independent\",\n",
    "        \"Balanced accuracy\",\n",
    "    ): (\n",
    "        comparison_for_display[\n",
    "            \"grouped_balanced_accuracy_mean\"\n",
    "        ].idxmax()\n",
    "    ),\n",
    "}\n",
    "\n",
    "best_display_rows = {\n",
    "    column: classifier_display_names.get(\n",
    "        classifier,\n",
    "        classifier,\n",
    "    )\n",
    "    for column, classifier\n",
    "    in best_internal_rows.items()\n",
    "}\n",
    "\n",
    "\n",
    "def highlight_best_results(\n",
    "    data,\n",
    "):\n",
    "    styles = pd.DataFrame(\n",
    "        \"\",\n",
    "        index=data.index,\n",
    "        columns=data.columns,\n",
    "    )\n",
    "\n",
    "    for (\n",
    "        column,\n",
    "        row_name,\n",
    "    ) in best_display_rows.items():\n",
    "\n",
    "        styles.loc[\n",
    "            row_name,\n",
    "            column,\n",
    "        ] = \"font-weight: bold;\"\n",
    "\n",
    "    return styles\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Style and display\n",
    "# ------------------------------------------------------------\n",
    "styled_w2v_baseline_table = (\n",
    "    w2v_baseline_table.style\n",
    "    .apply(\n",
    "        highlight_best_results,\n",
    "        axis=None,\n",
    "    )\n",
    "    .set_properties(\n",
    "        **{\n",
    "            \"text-align\": \"center\",\n",
    "            \"white-space\": \"nowrap\",\n",
    "            \"padding\": \"6px 12px\",\n",
    "        }\n",
    "    )\n",
    "    .set_table_styles(\n",
    "        [\n",
    "            {\n",
    "                \"selector\": \"table\",\n",
    "                \"props\": [\n",
    "                    (\n",
    "                        \"border-collapse\",\n",
    "                        \"collapse\",\n",
    "                    ),\n",
    "                    (\n",
    "                        \"width\",\n",
    "                        \"auto\",\n",
    "                    ),\n",
    "                    (\n",
    "                        \"margin\",\n",
    "                        \"0\",\n",
    "                    ),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"th\",\n",
    "                \"props\": [\n",
    "                    (\n",
    "                        \"text-align\",\n",
    "                        \"center\",\n",
    "                    ),\n",
    "                    (\n",
    "                        \"vertical-align\",\n",
    "                        \"middle\",\n",
    "                    ),\n",
    "                    (\n",
    "                        \"white-space\",\n",
    "                        \"nowrap\",\n",
    "                    ),\n",
    "                    (\n",
    "                        \"padding\",\n",
    "                        \"6px 12px\",\n",
    "                    ),\n",
    "                    (\n",
    "                        \"border-bottom\",\n",
    "                        \"1px solid\",\n",
    "                    ),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"th.row_heading\",\n",
    "                \"props\": [\n",
    "                    (\n",
    "                        \"text-align\",\n",
    "                        \"left\",\n",
    "                    ),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"th.index_name\",\n",
    "                \"props\": [\n",
    "                    (\n",
    "                        \"text-align\",\n",
    "                        \"left\",\n",
    "                    ),\n",
    "                ],\n",
    "            },\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Final summary\n",
    "# ------------------------------------------------------------\n",
    "print(\"\\n====================================================\")\n",
    "print(\" WAV2VEC BASELINE EVALUATION READY\")\n",
    "print(\"====================================================\")\n",
    "print(\n",
    "    f\"Source: {w2v_baseline_source}\"\n",
    ")\n",
    "print(\n",
    "    f\"Samples: {X_w2v.shape[0]}\"\n",
    ")\n",
    "print(\n",
    "    f\"Embedding dimension: {X_w2v.shape[1]}\"\n",
    ")\n",
