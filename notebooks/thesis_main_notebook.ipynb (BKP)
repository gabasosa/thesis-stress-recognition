    "        ),\n",
    "        \"vad_method\": (\n",
    "            \"stressid_vad\"\n",
    "        ),\n",
    "    }\n",
    "\n",
    "    return normalize_w2v_metadata(\n",
    "        metadata\n",
    "    )\n",
    "\n",
    "\n",
    "def w2v_cache_matches(\n",
    "    metadata_path,\n",
    "    expected_metadata,\n",
    "):\n",
    "    \"\"\"\n",
    "    Check whether the existing embedding cache matches the current\n",
    "    dataset and extraction configuration.\n",
    "    \"\"\"\n",
    "    if not os.path.isfile(\n",
    "        metadata_path\n",
    "    ):\n",
    "        return (\n",
    "            False,\n",
    "            \"Metadata file is missing.\",\n",
    "        )\n",
    "\n",
    "    try:\n",
    "        with open(\n",
    "            metadata_path,\n",
    "            \"r\",\n",
    "            encoding=\"utf-8\",\n",
    "        ) as file:\n",
    "            cached_metadata = json.load(\n",
    "                file\n",
    "            )\n",
    "\n",
    "    except Exception as exc:\n",
    "        return (\n",
    "            False,\n",
    "            f\"Metadata could not be read: {exc}\",\n",
    "        )\n",
    "\n",
    "    fields_to_compare = [\n",
    "        \"protocol\",\n",
    "        \"n_samples\",\n",
    "        \"dataset_fingerprint\",\n",
    "        \"checkpoint_fingerprint\",\n",
    "        \"embedding_method\",\n",
    "        \"vad_method\",\n",
    "    ]\n",
    "\n",
    "    mismatched_fields = [\n",
    "        field\n",
    "        for field in fields_to_compare\n",
    "        if cached_metadata.get(field)\n",
    "        != expected_metadata.get(field)\n",
    "    ]\n",
    "\n",
    "    if mismatched_fields:\n",
    "        return (\n",
    "            False,\n",
    "            \"Cached configuration differs in: \"\n",
    "            + \", \".join(\n",
    "                mismatched_fields\n",
    "            ),\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        True,\n",
    "        \"Cache matches the current wav2vec extraction configuration.\",\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Cache loading helper\n",
    "# ------------------------------------------------------------\n",
    "def load_w2v_feature_cache(\n",
    "    cache_path,\n",
    "):\n",
    "    \"\"\"\n",
    "    Load cached wav2vec embeddings and reconstruct the dataset arrays.\n",
    "    \"\"\"\n",
    "    dataframe = pd.read_parquet(\n",
    "        cache_path\n",
