    "# ============================================================\n",
    "# 3.3. Baseline Evaluation on Wav2Vec Embeddings\n",
    "# ============================================================\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "import os\n",
    "import time\n",
    "from datetime import datetime\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from IPython.display import display\n",
    "from sklearn.base import clone\n",
    "from sklearn.metrics import (\n",
    "    balanced_accuracy_score,\n",
    "    confusion_matrix,\n",
    "    f1_score,\n",
    ")\n",
    "from sklearn.model_selection import (\n",
    "    GroupKFold,\n",
    "    train_test_split,\n",
    ")\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "from imblearn.over_sampling import SMOTE\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Validate required variables\n",
    "# ------------------------------------------------------------\n",
    "required_variables = [\n",
    "    \"X_w2v\",\n",
    "    \"y_w2v\",\n",
    "    \"groups_w2v\",\n",
    "    \"STRESSID_CLASSIFIERS\",\n",
    "    \"STRESSID_N_REPETITIONS\",\n",
    "    \"STRESSID_TEST_SIZE\",\n",
    "    \"STRESSID_RANDOM_SEED\",\n",
    "    \"GROUPED_N_SPLITS\",\n",
    "    \"GROUPED_RANDOM_SEED\",\n",
    "    \"CACHE_DIR\",\n",
    "    \"IN_COLAB\",\n",
    "]\n",
    "\n",
    "missing_variables = [\n",
    "    name\n",
    "    for name in required_variables\n",
    "    if name not in globals()\n",
    "]\n",
    "\n",
    "if missing_variables:\n",
    "    raise RuntimeError(\n",
    "        \"The following required variables are missing: \"\n",
    "        f\"{missing_variables}. Run Sections 2.3 and 3.2 first.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Prepare and validate wav2vec data\n",
    "# ------------------------------------------------------------\n",
    "X_w2v = np.asarray(\n",
    "    X_w2v,\n",
    "    dtype=np.float32,\n",
    ")\n",
    "\n",
    "y_w2v = np.asarray(\n",
    "    y_w2v,\n",
    "    dtype=np.int64,\n",
    ")\n",
    "\n",
    "groups_w2v = np.asarray(\n",
    "    groups_w2v,\n",
    "    dtype=object,\n",
    ")\n",
    "\n",
    "if X_w2v.ndim != 2:\n",
    "    raise ValueError(\n",
    "        \"X_w2v must be two-dimensional; \"\n",
    "        f\"received shape {X_w2v.shape}.\"\n",
    "    )\n",
    "\n",
    "if y_w2v.ndim != 1:\n",
    "    raise ValueError(\n",
    "        \"y_w2v must be one-dimensional; \"\n",
    "        f\"received shape {y_w2v.shape}.\"\n",
    "    )\n",
    "\n",
    "if groups_w2v.ndim != 1:\n",
    "    raise ValueError(\n",
    "        \"groups_w2v must be one-dimensional; \"\n",
    "        f\"received shape {groups_w2v.shape}.\"\n",
    "    )\n",
    "\n",
    "if not (\n",
    "    X_w2v.shape[0]\n",
    "    == y_w2v.shape[0]\n",
    "    == groups_w2v.shape[0]\n",
    "):\n",
    "    raise ValueError(\n",
    "        \"X_w2v, y_w2v, and groups_w2v must contain \"\n",
    "        \"the same number of samples.\"\n",
    "    )\n",
    "\n",
    "if len(np.unique(y_w2v)) != 2:\n",
    "    raise ValueError(\n",
    "        \"The wav2vec baseline expects exactly two classes.\"\n",
    "    )\n",
    "\n",
    "if not np.isfinite(X_w2v).all():\n",
    "    raise ValueError(\n",
    "        \"X_w2v contains NaN or infinite values. \"\n",
    "        \"The wav2vec baseline intentionally omits imputation.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Wav2Vec-specific preprocessing pipeline\n",
    "# ------------------------------------------------------------\n",
    "def build_w2v_pipeline(classifier):\n",
    "    \"\"\"\n",
    "    Build the classifier pipeline for dense wav2vec embeddings.\n",
    "\n",
    "    Unlike the handcrafted pipeline, no imputation is required because\n",
    "    X_w2v is explicitly validated to contain only finite values.\n",
    "    \"\"\"\n",
    "    return Pipeline(\n",
    "        [\n",
    "            (\n",
    "                \"scaler\",\n",
    "                StandardScaler(),\n",
    "            ),\n",
    "            (\n",
    "                \"classifier\",\n",
    "                clone(classifier),\n",
    "            ),\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Cache paths\n",
    "# ------------------------------------------------------------\n",
    "W2V_BASELINE_RESULTS_CACHE = os.path.join(\n",
    "    CACHE_DIR,\n",
    "    \"stressid_w2v_baseline_results.parquet\",\n",
    ")\n",
    "\n",
    "W2V_BASELINE_PREDICTIONS_CACHE = os.path.join(\n",
    "    CACHE_DIR,\n",
    "    \"stressid_w2v_baseline_predictions.parquet\",\n",
    ")\n",
    "\n",
    "W2V_BASELINE_CONFUSIONS_CACHE = os.path.join(\n",
    "    CACHE_DIR,\n",
    "    \"stressid_w2v_baseline_confusions.parquet\",\n",
    ")\n",
    "\n",
    "W2V_BASELINE_META_FILE = os.path.join(\n",
    "    CACHE_DIR,\n",
    "    \"stressid_w2v_baseline_meta.json\",\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Cache helpers\n",
    "# ------------------------------------------------------------\n",
    "def w2v_baseline_fingerprint(\n",
    "    X,\n",
    "    y,\n",
    "    groups,\n",
    "):\n",
    "    \"\"\"Fingerprint wav2vec features, labels, and subject identities.\"\"\"\n",
    "    hasher = hashlib.sha256()\n",
    "\n",
    "    X_contiguous = np.ascontiguousarray(\n",
    "        X\n",
    "    )\n",
    "\n",
    "    y_contiguous = np.ascontiguousarray(\n",
    "        y\n",
    "    )\n",
    "\n",
    "    hasher.update(\n",
    "        str(X_contiguous.shape).encode(\n",
    "            \"utf-8\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "    hasher.update(\n",
    "        str(X_contiguous.dtype).encode(\n",
    "            \"utf-8\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "    hasher.update(\n",
    "        X_contiguous.tobytes()\n",
    "    )\n",
    "\n",
    "    hasher.update(\n",
    "        str(y_contiguous.shape).encode(\n",
    "            \"utf-8\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "    hasher.update(\n",
    "        str(y_contiguous.dtype).encode(\n",
    "            \"utf-8\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "    hasher.update(\n",
    "        y_contiguous.tobytes()\n",
    "    )\n",
    "\n",
    "    for group in np.asarray(\n",
    "        groups,\n",
    "        dtype=str,\n",
    "    ):\n",
    "        hasher.update(\n",
    "            group.encode(\n",
    "                \"utf-8\"\n",
    "            )\n",
    "        )\n",
    "\n",
    "        hasher.update(\n",
    "            b\"\\0\"\n",
    "        )\n",
    "\n",
    "    return hasher.hexdigest()\n",
    "\n",
    "\n",
    "def normalize_w2v_baseline_json(value):\n",
    "    \"\"\"Convert values into JSON-compatible Python objects.\"\"\"\n",
    "    if isinstance(\n",
    "        value,\n",
    "        dict,\n",
    "    ):\n",
    "        return {\n",
    "            str(key): normalize_w2v_baseline_json(\n",
    "                item\n",
    "            )\n",
    "            for key, item in value.items()\n",
    "        }\n",
    "\n",
    "    if isinstance(\n",
    "        value,\n",
    "        (list, tuple),\n",
    "    ):\n",
    "        return [\n",
    "            normalize_w2v_baseline_json(\n",
    "                item\n",
    "            )\n",
    "            for item in value\n",
    "        ]\n",
    "\n",
    "    if isinstance(\n",
    "        value,\n",
    "        np.generic,\n",
    "    ):\n",
    "        return value.item()\n",
    "\n",
    "    return value\n",
    "\n",
    "\n",
    "def build_w2v_baseline_metadata():\n",
    "    \"\"\"Describe the current wav2vec baseline experiment.\"\"\"\n",
    "    metadata = {\n",
    "        \"protocol\": (\n",
    "            \"stressid_wav2vec_classical_baseline\"\n",
    "        ),\n",
    "        \"n_samples\": int(\n",
    "            X_w2v.shape[0]\n",
    "        ),\n",
    "        \"embedding_dimension\": int(\n",
    "            X_w2v.shape[1]\n",
    "        ),\n",
    "        \"n_subjects\": int(\n",
    "            len(\n",
    "                np.unique(\n",
    "                    groups_w2v\n",
    "                )\n",
    "            )\n",
    "        ),\n",
    "        \"data_fingerprint\": (\n",
    "            w2v_baseline_fingerprint(\n",
    "                X_w2v,\n",
    "                y_w2v,\n",
    "                groups_w2v,\n",
    "            )\n",
    "        ),\n",
    "        \"recording_level\": {\n",
    "            \"n_repetitions\": int(\n",
    "                STRESSID_N_REPETITIONS\n",
    "            ),\n",
    "            \"test_size\": float(\n",
    "                STRESSID_TEST_SIZE\n",
    "            ),\n",
    "            \"random_seed\": (\n",
    "                STRESSID_RANDOM_SEED\n",
    "            ),\n",
    "        },\n",
    "        \"subject_independent\": {\n",
    "            \"n_splits\": int(\n",
    "                GROUPED_N_SPLITS\n",
    "            ),\n",
    "            \"random_seed\": (\n",
    "                GROUPED_RANDOM_SEED\n",
    "            ),\n",
    "        },\n",
    "        \"preprocessing\": [\n",
    "            \"training_only_smote\",\n",
    "            \"standard_scaler\",\n",
    "        ],\n",
    "        \"classifiers\": (\n",
    "            classifier_configuration(\n",
    "                STRESSID_CLASSIFIERS\n",
    "            )\n",
    "        ),\n",
    "        \"metrics\": [\n",
    "            \"weighted_f1\",\n",
    "            \"balanced_accuracy\",\n",
    "        ],\n",
    "    }\n",
    "\n",
    "    return normalize_w2v_baseline_json(\n",
    "        metadata\n",
    "    )\n",
    "\n",
    "\n",
    "def w2v_baseline_cache_matches(\n",
    "    metadata_path,\n",
    "    expected_metadata,\n",
    "):\n",
    "    \"\"\"Validate the wav2vec baseline cache.\"\"\"\n",
    "    if not os.path.isfile(\n",
    "        metadata_path\n",
    "    ):\n",
    "        return (\n",
    "            False,\n",
    "            \"Metadata file is missing.\",\n",
    "        )\n",
    "\n",
    "    try:\n",
    "        with open(\n",
    "            metadata_path,\n",
    "            \"r\",\n",
    "            encoding=\"utf-8\",\n",
    "        ) as file:\n",
    "            cached_metadata = json.load(\n",
    "                file\n",
    "            )\n",
    "\n",
    "    except Exception as exc:\n",
    "        return (\n",
    "            False,\n",
    "            f\"Metadata could not be read: {exc}\",\n",
    "        )\n",
    "\n",
    "    fields_to_compare = [\n",
    "        \"protocol\",\n",
    "        \"n_samples\",\n",
    "        \"embedding_dimension\",\n",
    "        \"n_subjects\",\n",
    "        \"data_fingerprint\",\n",
    "        \"recording_level\",\n",
    "        \"subject_independent\",\n",
    "        \"preprocessing\",\n",
    "        \"classifiers\",\n",
    "        \"metrics\",\n",
    "    ]\n",
    "\n",
    "    mismatched_fields = [\n",
    "        field\n",
    "        for field in fields_to_compare\n",
    "        if cached_metadata.get(\n",
    "            field\n",
    "        )\n",
    "        != expected_metadata.get(\n",
    "            field\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    if mismatched_fields:\n",
    "        return (\n",
    "            False,\n",
    "            \"Cached configuration differs in: \"\n",
    "            + \", \".join(\n",
    "                mismatched_fields\n",
    "            ),\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        True,\n",
    "        \"Cache matches the current wav2vec baseline experiment.\",\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Recording-level wav2vec evaluation\n",
    "# ------------------------------------------------------------\n",
    "def run_w2v_recording_level_baseline(\n",
    "    X,\n",
    "    y,\n",
    "    classifiers,\n",
    "    n_repetitions,\n",
    "    test_size,\n",
    "    random_seed,\n",
    "    verbose=True,\n",
    "):\n",
    "    \"\"\"\n",
    "    Evaluate wav2vec embeddings using repeated random 80/20 splits.\n",
    "    \"\"\"\n",
    "    sample_indices = np.arange(\n",
    "        X.shape[0]\n",
    "    )\n",
    "\n",
    "    rng = (\n",
    "        None\n",
    "        if random_seed is None\n",
    "        else np.random.default_rng(\n",
    "            random_seed\n",
    "        )\n",
    "    )\n",
    "\n",
    "    result_rows = []\n",
    "    confusion_rows = []\n",
    "    prediction_rows = []\n",
    "\n",
    "    for repetition in range(\n",
    "        n_repetitions\n",
    "    ):\n",
    "        if rng is None:\n",
    "            split_seed = None\n",
    "            smote_seed = None\n",
    "        else:\n",
    "            split_seed = int(\n",
    "                rng.integers(\n",
    "                    0,\n",
    "                    np.iinfo(\n",
    "                        np.int32\n",
    "                    ).max,\n",
    "                )\n",
    "            )\n",
    "\n",
    "            smote_seed = int(\n",
    "                rng.integers(\n",
    "                    0,\n",
    "                    np.iinfo(\n",
    "                        np.int32\n",
    "                    ).max,\n",
    "                )\n",
    "            )\n",
    "\n",
    "        train_indices, test_indices = (\n",
    "            train_test_split(\n",
    "                sample_indices,\n",
    "                test_size=test_size,\n",
    "                random_state=split_seed,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        X_train = X[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        X_test = X[\n",
    "            test_indices\n",
    "        ]\n",
    "\n",
    "        y_train = y[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        y_test = y[\n",
    "            test_indices\n",
    "        ]\n",
    "\n",
    "        smote = SMOTE(\n",
    "            random_state=smote_seed\n",
    "        )\n",
    "\n",
    "        (\n",
    "            X_train_resampled,\n",
    "            y_train_resampled,\n",
    "        ) = smote.fit_resample(\n",
    "            X_train,\n",
    "            y_train,\n",
    "        )\n",
    "\n",
    "        if verbose:\n",
    "            print(\n",
    "                f\"Split {repetition + 1:2d}/\"\n",
    "                f\"{n_repetitions:2d} | \"\n",
    "                f\"train={len(y_train):3d} | \"\n",
    "                f\"after SMOTE=\"\n",
    "                f\"{len(y_train_resampled):3d} | \"\n",
    "                f\"test={len(y_test):3d}\"\n",
    "            )\n",
    "\n",
    "        for (\n",
    "            classifier_name,\n",
    "            classifier,\n",
    "        ) in classifiers.items():\n",
    "\n",
    "            pipeline = build_w2v_pipeline(\n",
    "                classifier\n",
    "            )\n",
    "\n",
    "            start_time = (\n",
    "                time.perf_counter()\n",
    "            )\n",
    "\n",
    "            pipeline.fit(\n",
    "                X_train_resampled,\n",
    "                y_train_resampled,\n",
    "            )\n",
    "\n",
    "            fit_time = (\n",
    "                time.perf_counter()\n",
    "                - start_time\n",
    "            )\n",
    "\n",
    "            y_pred = pipeline.predict(\n",
    "                X_test\n",
    "            )\n",
    "\n",
    "            weighted_f1 = f1_score(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                average=\"weighted\",\n",
    "            )\n",
    "\n",
    "            balanced_accuracy = (\n",
    "                balanced_accuracy_score(\n",
    "                    y_test,\n",
    "                    y_pred,\n",
    "                )\n",
    "            )\n",
    "\n",
    "            matrix = confusion_matrix(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                labels=[0, 1],\n",
    "            )\n",
    "\n",
    "            tn, fp, fn, tp = (\n",
    "                matrix.ravel()\n",
    "            )\n",
    "\n",
    "            result_rows.append(\n",
    "                {\n",
    "                    \"protocol\": (\n",
    "                        \"recording-level\"\n",
    "                    ),\n",
    "                    \"fold\": int(\n",
    "                        repetition\n",
    "                    ),\n",
    "                    \"classifier\": (\n",
    "                        classifier_name\n",
    "                    ),\n",
    "                    \"weighted_f1\": float(\n",
    "                        weighted_f1\n",
    "                    ),\n",
    "                    \"balanced_accuracy\": float(\n",
    "                        balanced_accuracy\n",
    "                    ),\n",
    "                    \"fit_time_seconds\": float(\n",
    "                        fit_time\n",
    "                    ),\n",
    "                    \"train_samples\": int(\n",
    "                        len(y_train)\n",
    "                    ),\n",
    "                    \"train_samples_after_smote\": int(\n",
    "                        len(\n",
    "                            y_train_resampled\n",
    "                        )\n",
    "                    ),\n",
    "                    \"test_samples\": int(\n",
    "                        len(y_test)\n",
    "                    ),\n",
    "                    \"split_seed\": (\n",
    "                        split_seed\n",
    "                    ),\n",
    "                    \"smote_seed\": (\n",
    "                        smote_seed\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "            confusion_rows.append(\n",
    "                {\n",
    "                    \"protocol\": (\n",
    "                        \"recording-level\"\n",
    "                    ),\n",
    "                    \"fold\": int(\n",
    "                        repetition\n",
    "                    ),\n",
    "                    \"classifier\": (\n",
    "                        classifier_name\n",
    "                    ),\n",
    "                    \"true_negative\": int(\n",
    "                        tn\n",
    "                    ),\n",
    "                    \"false_positive\": int(\n",
    "                        fp\n",
    "                    ),\n",
    "                    \"false_negative\": int(\n",
    "                        fn\n",
    "                    ),\n",
    "                    \"true_positive\": int(\n",
    "                        tp\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "            for (\n",
    "                sample_index,\n",
    "                true_label,\n",
    "                predicted_label,\n",
    "            ) in zip(\n",
    "                test_indices,\n",
    "                y_test,\n",
    "                y_pred,\n",
    "            ):\n",
    "                prediction_rows.append(\n",
    "                    {\n",
    "                        \"protocol\": (\n",
    "                            \"recording-level\"\n",
    "                        ),\n",
    "                        \"fold\": int(\n",
    "                            repetition\n",
    "                        ),\n",
    "                        \"classifier\": (\n",
    "                            classifier_name\n",
    "                        ),\n",
    "                        \"sample_index\": int(\n",
    "                            sample_index\n",
    "                        ),\n",
    "                        \"subject\": str(\n",
    "                            groups_w2v[\n",
    "                                sample_index\n",
    "                            ]\n",
    "                        ),\n",
    "                        \"y_true\": int(\n",
    "                            true_label\n",
    "                        ),\n",
    "                        \"y_pred\": int(\n",
    "                            predicted_label\n",
    "                        ),\n",
    "                    }\n",
    "                )\n",
    "\n",
    "    return (\n",
    "        pd.DataFrame(\n",
    "            result_rows\n",
    "        ),\n",
    "        pd.DataFrame(\n",
    "            confusion_rows\n",
    "        ),\n",
    "        pd.DataFrame(\n",
    "            prediction_rows\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Subject-independent wav2vec evaluation\n",
    "# ------------------------------------------------------------\n",
    "def run_w2v_subject_independent_baseline(\n",
    "    X,\n",
    "    y,\n",
    "    groups,\n",
    "    classifiers,\n",
    "    n_splits,\n",
    "    random_seed,\n",
    "    verbose=True,\n",
    "):\n",
    "    \"\"\"\n",
    "    Evaluate wav2vec embeddings using subject-independent GroupKFold.\n",
    "    \"\"\"\n",
    "    cv = GroupKFold(\n",
    "        n_splits=n_splits\n",
    "    )\n",
    "\n",
    "    rng = (\n",
    "        None\n",
    "        if random_seed is None\n",
    "        else np.random.default_rng(\n",
    "            random_seed\n",
    "        )\n",
    "    )\n",
    "\n",
    "    result_rows = []\n",
    "    confusion_rows = []\n",
    "    prediction_rows = []\n",
    "\n",
    "    for fold, (\n",
    "        train_indices,\n",
    "        test_indices,\n",
    "    ) in enumerate(\n",
    "        cv.split(\n",
    "            X,\n",
    "            y,\n",
    "            groups=groups,\n",
    "        )\n",
    "    ):\n",
    "        X_train = X[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        X_test = X[\n",
    "            test_indices\n",
    "        ]\n",
    "\n",
    "        y_train = y[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        y_test = y[\n",
    "            test_indices\n",
    "        ]\n",
    "\n",
    "        groups_train = groups[\n",
    "            train_indices\n",
    "        ]\n",
    "\n",
    "        groups_test = groups[\n",
    "            test_indices\n",
    "        ]\n",
    "\n",
    "        shared_subjects = np.intersect1d(\n",
    "            np.unique(\n",
    "                groups_train\n",
    "            ),\n",
    "            np.unique(\n",
    "                groups_test\n",
    "            ),\n",
    "        )\n",
    "\n",
    "        if shared_subjects.size != 0:\n",
    "            raise RuntimeError(\n",
    "                \"Subject leakage detected in fold \"\n",
    "                f\"{fold + 1}: \"\n",
    "                f\"{shared_subjects.tolist()}\"\n",
    "            )\n",
    "\n",
    "        if rng is None:\n",
    "            smote_seed = None\n",
    "        else:\n",
    "            smote_seed = int(\n",
    "                rng.integers(\n",
    "                    0,\n",
    "                    np.iinfo(\n",
    "                        np.int32\n",
    "                    ).max,\n",
    "                )\n",
    "            )\n",
    "\n",
    "        smote = SMOTE(\n",
    "            random_state=smote_seed\n",
    "        )\n",
    "\n",
    "        (\n",
    "            X_train_resampled,\n",
    "            y_train_resampled,\n",
    "        ) = smote.fit_resample(\n",
    "            X_train,\n",
    "            y_train,\n",
    "        )\n",
    "\n",
    "        train_subjects = np.unique(\n",
    "            groups_train\n",
    "        )\n",
    "\n",
    "        test_subjects = np.unique(\n",
    "            groups_test\n",
    "        )\n",
    "\n",
    "        if verbose:\n",
    "            print(\n",
    "                f\"Fold {fold + 1:2d}/\"\n",
    "                f\"{n_splits:2d} | \"\n",
    "                f\"train subjects=\"\n",
    "                f\"{len(train_subjects):2d} | \"\n",
    "                f\"test subjects=\"\n",
    "                f\"{len(test_subjects):2d} | \"\n",
    "                f\"train={len(y_train):3d} | \"\n",
    "                f\"after SMOTE=\"\n",
    "                f\"{len(y_train_resampled):3d} | \"\n",
    "                f\"test={len(y_test):3d}\"\n",
    "            )\n",
    "\n",
    "        for (\n",
    "            classifier_name,\n",
    "            classifier,\n",
    "        ) in classifiers.items():\n",
    "\n",
    "            pipeline = build_w2v_pipeline(\n",
    "                classifier\n",
    "            )\n",
    "\n",
    "            start_time = (\n",
    "                time.perf_counter()\n",
    "            )\n",
    "\n",
    "            pipeline.fit(\n",
    "                X_train_resampled,\n",
    "                y_train_resampled,\n",
    "            )\n",
    "\n",
    "            fit_time = (\n",
    "                time.perf_counter()\n",
    "                - start_time\n",
    "            )\n",
    "\n",
    "            y_pred = pipeline.predict(\n",
    "                X_test\n",
    "            )\n",
    "\n",
    "            weighted_f1 = f1_score(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                average=\"weighted\",\n",
    "            )\n",
    "\n",
    "            balanced_accuracy = (\n",
    "                balanced_accuracy_score(\n",
    "                    y_test,\n",
    "                    y_pred,\n",
    "                )\n",
    "            )\n",
    "\n",
    "            matrix = confusion_matrix(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                labels=[0, 1],\n",
    "            )\n",
    "\n",
    "            tn, fp, fn, tp = (\n",
    "                matrix.ravel()\n",
    "            )\n",
    "\n",
    "            result_rows.append(\n",
    "                {\n",
    "                    \"protocol\": (\n",
    "                        \"subject-independent\"\n",
    "                    ),\n",
    "                    \"fold\": int(\n",
    "                        fold\n",
    "                    ),\n",
    "                    \"classifier\": (\n",
    "                        classifier_name\n",
    "                    ),\n",
    "                    \"weighted_f1\": float(\n",
    "                        weighted_f1\n",
    "                    ),\n",
    "                    \"balanced_accuracy\": float(\n",
    "                        balanced_accuracy\n",
    "                    ),\n",
    "                    \"fit_time_seconds\": float(\n",
    "                        fit_time\n",
    "                    ),\n",
    "                    \"train_samples\": int(\n",
    "                        len(y_train)\n",
    "                    ),\n",
    "                    \"train_samples_after_smote\": int(\n",
    "                        len(\n",
    "                            y_train_resampled\n",
    "                        )\n",
    "                    ),\n",
    "                    \"test_samples\": int(\n",
    "                        len(y_test)\n",
    "                    ),\n",
    "                    \"train_subjects\": int(\n",
    "                        len(\n",
    "                            train_subjects\n",
    "                        )\n",
    "                    ),\n",
    "                    \"test_subjects\": int(\n",
    "                        len(\n",
    "                            test_subjects\n",
    "                        )\n",
    "                    ),\n",
    "                    \"smote_seed\": (\n",
    "                        smote_seed\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "            confusion_rows.append(\n",
    "                {\n",
    "                    \"protocol\": (\n",
    "                        \"subject-independent\"\n",
    "                    ),\n",
    "                    \"fold\": int(\n",
    "                        fold\n",
    "                    ),\n",
    "                    \"classifier\": (\n",
    "                        classifier_name\n",
    "                    ),\n",
    "                    \"true_negative\": int(\n",
    "                        tn\n",
    "                    ),\n",
    "                    \"false_positive\": int(\n",
    "                        fp\n",
    "                    ),\n",
    "                    \"false_negative\": int(\n",
    "                        fn\n",
    "                    ),\n",
    "                    \"true_positive\": int(\n",
    "                        tp\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "            for (\n",
    "                sample_index,\n",
    "                subject,\n",
    "                true_label,\n",
    "                predicted_label,\n",
    "            ) in zip(\n",
    "                test_indices,\n",
    "                groups_test,\n",
    "                y_test,\n",
    "                y_pred,\n",
    "            ):\n",
    "                prediction_rows.append(\n",
    "                    {\n",
    "                        \"protocol\": (\n",
    "                            \"subject-independent\"\n",
    "                        ),\n",
    "                        \"fold\": int(\n",
    "                            fold\n",
    "                        ),\n",
    "                        \"classifier\": (\n",
    "                            classifier_name\n",
    "                        ),\n",
    "                        \"sample_index\": int(\n",
    "                            sample_index\n",
    "                        ),\n",
    "                        \"subject\": str(\n",
    "                            subject\n",
    "                        ),\n",
    "                        \"y_true\": int(\n",
    "                            true_label\n",
    "                        ),\n",
    "                        \"y_pred\": int(\n",
    "                            predicted_label\n",
    "                        ),\n",
    "                    }\n",
    "                )\n",
    "\n",
    "    return (\n",
    "        pd.DataFrame(\n",
    "            result_rows\n",
    "        ),\n",
    "        pd.DataFrame(\n",
    "            confusion_rows\n",
    "        ),\n",
    "        pd.DataFrame(\n",
    "            prediction_rows\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Result summarization\n",
    "# ------------------------------------------------------------\n",
    "def summarize_w2v_baseline(\n",
    "    results_df,\n",
    "    protocol,\n",
    "):\n",
    "    \"\"\"Summarize one wav2vec evaluation protocol.\"\"\"\n",
    "    protocol_results = (\n",
    "        results_df.loc[\n",
    "            results_df[\n",
    "                \"protocol\"\n",
    "            ]\n",
    "            == protocol\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        protocol_results\n",
    "        .groupby(\n",
    "            \"classifier\",\n",
    "            sort=True,\n",
    "        )\n",
    "        .agg(\n",
    "            weighted_f1_mean=(\n",
    "                \"weighted_f1\",\n",
    "                \"mean\",\n",
    "            ),\n",
    "            weighted_f1_std=(\n",
    "                \"weighted_f1\",\n",
    "                \"std\",\n",
    "            ),\n",
    "            balanced_accuracy_mean=(\n",
    "                \"balanced_accuracy\",\n",
    "                \"mean\",\n",
    "            ),\n",
    "            balanced_accuracy_std=(\n",
    "                \"balanced_accuracy\",\n",
    "                \"std\",\n",
    "            ),\n",
    "            fit_time_mean_seconds=(\n",
    "                \"fit_time_seconds\",\n",
    "                \"mean\",\n",
    "            ),\n",
    "            fit_time_std_seconds=(\n",
    "                \"fit_time_seconds\",\n",
    "                \"std\",\n",
    "            ),\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Validate existing cache\n",
    "# ------------------------------------------------------------\n",
    "expected_w2v_baseline_metadata = (\n",
    "    build_w2v_baseline_metadata()\n",
    ")\n",
    "\n",
    "required_cache_files = [\n",
    "    W2V_BASELINE_RESULTS_CACHE,\n",
    "    W2V_BASELINE_PREDICTIONS_CACHE,\n",
    "    W2V_BASELINE_CONFUSIONS_CACHE,\n",
    "    W2V_BASELINE_META_FILE,\n",
    "]\n",
    "\n",
    "all_cache_files_exist = all(\n",
    "    os.path.isfile(\n",
    "        path\n",
    "    )\n",
    "    for path in required_cache_files\n",
    ")\n",
    "\n",
    "cache_is_valid = False\n",
    "\n",
    "cache_validation_message = (\n",
    "    \"Required cache files are missing.\"\n",
    ")\n",
    "\n",
    "if all_cache_files_exist:\n",
    "    (\n",
    "        cache_is_valid,\n",
    "        cache_validation_message,\n",
    "    ) = w2v_baseline_cache_matches(\n",
    "        W2V_BASELINE_META_FILE,\n",
    "        expected_w2v_baseline_metadata,\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Decide whether to load or run\n",
    "# ------------------------------------------------------------\n",
    "use_cached_results = False\n",
    "run_experiment = False\n",
    "\n",
    "if (\n",
    "    all_cache_files_exist\n",
    "    and cache_is_valid\n",
    "):\n",
    "    print(\"====================================================\")\n",
    "    print(\" WAV2VEC BASELINE CACHE DETECTED\")\n",
    "    print(\"====================================================\")\n",
    "    print(\n",
    "        cache_validation_message\n",
    "    )\n",
    "\n",
    "    with open(\n",
    "        W2V_BASELINE_META_FILE,\n",
    "        \"r\",\n",
    "        encoding=\"utf-8\",\n",
    "    ) as file:\n",
    "        cached_metadata = json.load(\n",
    "            file\n",
    "        )\n",
    "\n",
    "    if \"execution_timestamp\" in cached_metadata:\n",
    "        print(\n",
    "            \"Execution timestamp:\",\n",
    "            cached_metadata[\n",
    "                \"execution_timestamp\"\n",
    "            ],\n",
    "        )\n",
    "\n",
    "    if IN_COLAB:\n",
    "        print(\n",
    "            \"Colab environment detected. \"\n",
    "            \"Using cached wav2vec baseline results automatically.\"\n",
    "        )\n",
    "\n",
    "        use_cached_results = True\n",
    "\n",
    "    else:\n",
    "        user_input = input(\n",
    "            \"Reuse cached wav2vec baseline results \"\n",
    "            \"instead of rerunning the experiment? (y/n): \"\n",
    "        ).strip().lower()\n",
    "\n",
    "        if user_input == \"y\":\n",
    "            use_cached_results = True\n",
    "\n",
    "        else:\n",
    "            run_experiment = True\n",
    "\n",
    "else:\n",
    "    if all_cache_files_exist:\n",
    "        print(\"====================================================\")\n",
    "        print(\" INCOMPATIBLE WAV2VEC BASELINE CACHE\")\n",
    "        print(\"====================================================\")\n",
    "        print(\n",
    "            cache_validation_message\n",
    "        )\n",
    "\n",
    "    if IN_COLAB:\n",
    "        raise FileNotFoundError(\n",
    "            \"A compatible cached wav2vec baseline result set \"\n",
    "            \"was not found in Colab. Run Section 3.3 locally \"\n",
    "            \"first and make the generated cache files available.\"\n",
    "        )\n",
    "\n",
    "    print(\n",
    "        \"No compatible wav2vec baseline cache was found. \"\n",
    "        \"The experiment will be executed.\"\n",
    "    )\n",
    "\n",
    "    run_experiment = True\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Load cached results\n",
    "# ------------------------------------------------------------\n",
    "if use_cached_results:\n",
    "    w2v_baseline_results = pd.read_parquet(\n",
    "        W2V_BASELINE_RESULTS_CACHE\n",
    "    )\n",
    "\n",
    "    w2v_baseline_predictions = pd.read_parquet(\n",
    "        W2V_BASELINE_PREDICTIONS_CACHE\n",
    "    )\n",
    "\n",
    "    w2v_baseline_confusions = pd.read_parquet(\n",
    "        W2V_BASELINE_CONFUSIONS_CACHE\n",
    "    )\n",
    "\n",
    "    w2v_baseline_source = \"cache\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Run experiment\n",
    "# ------------------------------------------------------------\n",
    "elif run_experiment:\n",
    "    print(\"\\n====================================================\")\n",
    "    print(\" WAV2VEC - RECORDING-LEVEL EVALUATION\")\n",
    "    print(\"====================================================\")\n",
    "\n",
    "    (\n",
    "        w2v_recording_results,\n",
    "        w2v_recording_confusions,\n",
    "        w2v_recording_predictions,\n",
    "    ) = run_w2v_recording_level_baseline(\n",
    "        X=X_w2v,\n",
    "        y=y_w2v,\n",
