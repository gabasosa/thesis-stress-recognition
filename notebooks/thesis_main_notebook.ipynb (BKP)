    "# Replace with SEED for deterministic local experiments.\n",
    "STRESSID_RANDOM_SEED = None\n",
    "\n",
    "STRESSID_CLASSIFIERS = {\n",
    "    \"RandomForestClassifier\": RandomForestClassifier(\n",
    "        max_depth=5,\n",
