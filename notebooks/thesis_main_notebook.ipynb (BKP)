    "print(\n",
    "    \"Preprocessing: SMOTE + StandardScaler \"\n",
    "    \"(no imputation)\"\n",
    ")\n",
    "print(\"====================================================\")\n",
    "\n",
    "display(\n",
    "    styled_w2v_baseline_table\n",
    ")"
   ]
