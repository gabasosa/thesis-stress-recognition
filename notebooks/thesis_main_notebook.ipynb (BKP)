    "                    ),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"td:nth-child(1)\",\n",
    "                \"props\": [\n",
    "                    (\n",
    "                        \"text-align\",\n",
    "                        \"left\",\n",
    "                    ),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"td:nth-child(2)\",\n",
    "                \"props\": [\n",
    "                    (\n",
    "                        \"text-align\",\n",
    "                        \"left\",\n",
    "                    ),\n",
    "                ],\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"td:nth-child(3)\",\n",
    "                \"props\": [\n",
    "                    (\n",
    "                        \"text-align\",\n",
    "                        \"left\",\n",
    "                    ),\n",
    "                ],\n",
    "            },\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Display\n",
    "# ------------------------------------------------------------\n",
    "print(\"====================================================\")\n",
    "print(\" RECORDING-LEVEL COMPARATIVE RESULTS\")\n",
    "print(\"====================================================\")\n",
