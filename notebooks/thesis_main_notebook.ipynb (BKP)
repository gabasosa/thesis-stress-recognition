    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Deep audio features\n",
    "# ------------------------------------------------------------\n",
    "def DeepAudioFeatures(\n",
    "    audio_path,\n",
    "    W2Vmodel,\n",
    "):\n",
    "    \"\"\"\n",
    "    Extract the temporal wav2vec representation and its summary\n",
    "    statistics.\n",
    "\n",
    "    This function preserves the name and overall processing sequence\n",
    "    used in the official StressID feature-extraction script:\n",
    "\n",
    "      1. Load the audio recording.\n",
    "      2. Apply the StressID VAD routine.\n",
    "      3. Apply the Fairseq feature extractor.\n",
    "      4. Apply the Fairseq feature aggregator.\n",
    "      5. Compute temporal mean and standard deviation.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    w2v_mean : np.ndarray\n",
    "        Temporal mean of the aggregated representation.\n",
    "\n",
    "    w2v_std : np.ndarray\n",
    "        Temporal standard deviation of the aggregated representation.\n",
    "\n",
    "    w2v : np.ndarray\n",
    "        Complete aggregated temporal representation.\n",
    "    \"\"\"\n",
    "    if W2Vmodel is None:\n",
    "        raise RuntimeError(\n",
    "            \"No wav2vec model is currently loaded.\"\n",
    "        )\n",
    "\n",
    "    speech, sample_rate = librosa.load(\n",
    "        audio_path,\n",
    "        sr=None,\n",
    "        mono=True,\n",
    "    )\n",
    "\n",
    "    if speech.size == 0:\n",
    "        raise ValueError(\n",
    "            f\"Empty audio signal: {audio_path}\"\n",
    "        )\n",
    "\n",
    "    speech_vad = apply_stressid_vad(\n",
    "        speech,\n",
    "        sample_rate,\n",
    "    )\n",
    "\n",
    "    speech_vad = np.asarray(\n",
    "        speech_vad,\n",
    "        dtype=np.float32,\n",
    "    )\n",
    "\n",
    "    if speech_vad.size == 0:\n",
    "        raise ValueError(\n",
    "            \"The StressID VAD removed the complete signal for \"\n",
    "            f\"{audio_path}.\"\n",
    "        )\n",
    "\n",
    "    model = (\n",
    "        W2Vmodel[0]\n",
    "        if isinstance(\n",
    "            W2Vmodel,\n",
    "            (list, tuple),\n",
    "        )\n",
    "        else W2Vmodel\n",
    "    )\n",
    "\n",
    "    model = model.to(\n",
    "        W2V_DEVICE\n",
    "    )\n",
    "\n",
    "    model.eval()\n",
    "\n",
    "    waveform = (\n",
    "        torch.from_numpy(\n",
    "            speech_vad\n",
    "        )\n",
    "        .float()\n",
    "        .unsqueeze(0)\n",
    "        .to(W2V_DEVICE)\n",
    "    )\n",
    "\n",
    "    with torch.no_grad():\n",
    "        z = model.feature_extractor(\n",
    "            waveform\n",
    "        )\n",
    "\n",
    "        z = model.feature_aggregator(\n",
    "            z\n",
    "        )\n",
    "\n",
    "    w2v = (\n",
    "        z\n",
    "        .detach()\n",
    "        .cpu()\n",
    "        .numpy()\n",
    "    )\n",
    "\n",
    "    if w2v.ndim != 3:\n",
    "        raise ValueError(\n",
    "            \"Unexpected wav2vec output shape: \"\n",
    "            f\"{w2v.shape}. Expected [batch, features, time].\"\n",
    "        )\n",
    "\n",
    "    w2v_mean = np.mean(\n",
    "        w2v,\n",
    "        axis=2,\n",
    "    )\n",
    "\n",
    "    w2v_std = np.std(\n",
    "        w2v,\n",
    "        axis=2,\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        w2v_mean,\n",
    "        w2v_std,\n",
    "        w2v,\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Fixed-length deep-audio embedding\n",
    "# ------------------------------------------------------------\n",
    "def DeepAudioEmbedding(\n",
    "    audio_path,\n",
    "    W2Vmodel,\n",
    "):\n",
    "    \"\"\"\n",
    "    Build the fixed-length embedding used for classification.\n",
    "\n",
    "    This helper reproduces the concatenation performed in the\n",
    "    original StressID extraction script after DeepAudioFeatures().\n",
    "    \"\"\"\n",
    "    (\n",
    "        w2v_mean,\n",
    "        w2v_std,\n",
    "        _,\n",
    "    ) = DeepAudioFeatures(\n",
    "        audio_path,\n",
    "        W2Vmodel,\n",
    "    )\n",
    "\n",
    "    embedding = np.concatenate(\n",
    "        [\n",
    "            w2v_mean.squeeze(0),\n",
    "            w2v_std.squeeze(0),\n",
    "        ],\n",
    "        axis=0,\n",
    "    )\n",
    "\n",
    "    return embedding.astype(\n",
    "        np.float32,\n",
    "        copy=False,\n",
    "    )\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Optional Fairseq model loading\n",
    "# ------------------------------------------------------------\n",
    "checkpoint_path = WAV2VEC_LARGE_PT\n",
    "\n",
    "if IN_COLAB:\n",
    "    print(\"====================================================\")\n",
    "    print(\" WAV2VEC MODEL LOADING\")\n",
